
(********************** Declaration ****************************)
TYPE eAxes :
	(
	AXIS_TRACK_LEFT := 1,
	AXIS_TRACK_RIGHT,
	AXIS_PITCH,
	AXIS_BOOM_SWING,
	AXIS_YAW,
	AXIS_Z_SLIDE,
	AXIS_ROTATOR,
	AXIS_MAST_SLIDE,
	AXIS_UPPER_CROWD,
	AXIS_UPPER_ROTARY,
	AXIS_LOWER_CROWD,
	AXIS_LOWER_ROTARY,
	AXIS_X_SLIDE,
	AXIS_BOOM_LIFT,
	AXIS_JOINT_LIFT,
	// Put all of the controlled axes together at the top!
	AXIS_PENDULUM,
	AXIS_HAMMER,
	AXIS_OUTRIGGER,
	AXIS_CENTRALIZER,
	AXIS_LEFT_CRIMPER,
	AXIS_RIGHT_CRIMPER,
	AXIS_TARGET_PLATE,
	AXIS_WATER
	);
END_TYPE