
(********************** Declaration ****************************)
(* Returns the length type of the screw we want to drive.
	This in conceptual, returns enum eScrewLength. *)
FUNCTION getScrewLength : eScrewLength
VAR_INPUT
END_VAR
VAR
END_VAR
(********************** Implementation ****************************)

IF REMOTE.T3P2_UP THEN
	getScrewLength := SCREW_1;
ELSIF REMOTE.T3P2_DN THEN
	getScrewLength := SCREW_3;
ELSE
	getScrewLength := SCREW_2;
END_IF;
