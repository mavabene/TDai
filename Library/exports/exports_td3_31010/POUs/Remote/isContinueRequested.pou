
(********************** Declaration ****************************)
(* Call this function from the lower level state logic to determine if a CONTINUE has been
	requested. This tells the lower level code, for one scan, that the user has newly initiated
	a CONTINUE request. *)
FUNCTION isContinueRequested : BOOL
VAR_INPUT
END_VAR
VAR
END_VAR
(********************** Implementation ****************************)

isContinueRequested := (REMOTE.RJ_B_RE AND NOT LAST_PAUSED);