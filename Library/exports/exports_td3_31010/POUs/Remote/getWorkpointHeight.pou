
(********************** Declaration ****************************)
FUNCTION getWorkpointHeight : eWorkpointHeight
VAR_INPUT
END_VAR
VAR
END_VAR
(********************** Implementation ****************************)

IF REMOTE.T3P4_DN THEN
	getWorkpointHeight := WP_LOW;
ELSIF REMOTE.T3P4_UP THEN
	getWorkpointHeight := WP_HIGH;
ELSE
	getWorkpointHeight := WP_NONE;
END_IF;
