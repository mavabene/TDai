
(********************** Declaration ****************************)
FUNCTION isScrewDriveStates : BOOL
VAR_INPUT
	SCREW_STATE_CURRENT: eScrewStates;
END_VAR
VAR
END_VAR

(********************** Implementation ****************************)
isScrewDriveStates := SCREW_STATE_CURRENT = SCREW_STATE_DRIVE_SCREW OR
	SCREW_STATE_CURRENT = SCREW_STATE_DRIVE_ASSIST OR
	SCREW_STATE_CURRENT = SCREW_STATE_RETURN_TO_DRIVE OR
	SCREW_STATE_CURRENT = SCREW_STATE_DRILL_REVERSE OR
	SCREW_STATE_CURRENT = SCREW_STATE_DRILL_AHEAD OR
	SCREW_STATE_CURRENT = SCREW_STATE_DRILL_RETURN OR
	SCREW_STATE_CURRENT = SCREW_STATE_BRIEF_HAMMER OR
	SCREW_STATE_CURRENT = SCREW_STATE_DRILL_EXTEND OR
	SCREW_STATE_CURRENT = SCREW_STATE_DRILL_TO_SCREW_END OR
	SCREW_STATE_CURRENT = SCREW_STATE_RELIEVE_SPOILS_PRESSURE OR
	SCREW_STATE_CURRENT = SCREW_STATE_CLEAR_SPOILS OR
	SCREW_STATE_CURRENT = SCREW_STATE_LC_REWIND
;

// We've added data collection during manual operations.  This let's us record screws finished in manual.
isScrewDriveStates := isScrewDriveStates OR ((MACHINE_MODE = SCREW_MODE) AND MANUAL);