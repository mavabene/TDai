
(********************** Declaration ****************************)
FUNCTION TrapezoidStart : BOOL
VAR_INPUT
	pPROFILE: POINTER TO sTrapezoid;
	pSETPOINT: POINTER TO sSetpoint;
	TIME_NOW_US: DWORD;
	FB: sFeedback;
	POSITION_ENGR: REAL; // Target Position
	VELOCITY_ENGR: REAL; // Desired velocity
	ACCEL_ENGR: REAL; // desired acceleration
END_VAR
VAR
	POSITION_RAW: DINT;
	VELOCITY_RAW: REAL;
	ACCEL_RAW: REAL;
	POSITION_DELTA: DINT;
	VMAX: REAL;
	ACCEL_TIME: DWORD;
	ACCEL_DISTANCE: DINT;
	CRUISE_DISTANCE: DINT;
	CRUISE_TIME: DWORD;
	V: REAL;
END_VAR
(********************** Implementation ****************************)
(* Convert user units to internal units, counts *)
POSITION_RAW := POS_ENGR_TO_RAW(FB, POSITION_ENGR);

// direction is set at bottom, after magnitudes calculated:
VELOCITY_RAW := ABS(VEL_ENGR_TO_RAW(FB, VELOCITY_ENGR));
ACCEL_RAW := ABS(VEL_ENGR_TO_RAW(FB, ACCEL_ENGR));

pPROFILE^.POSITION_END := POSITION_RAW;
pPROFILE^.VELOCITY := VELOCITY_RAW;
pPROFILE^.ACCELERATION := ACCEL_RAW;

(* Is the move trapezoidal or triangular? *)
POSITION_DELTA := ABS(POSITION_RAW - FB.POSITION_RAW);
pPROFILE^.POSITION_START := FB.POSITION_RAW;

IF ACCEL_RAW * VELOCITY_RAW = 0 THEN // prevent /0 error which will crash PLC. if vel is 0 then we are basically the request is to not move. if accel is 0 the request doesn't make sense either.  So don't move. 
	//gotoErrorState(REASON := 'Div by Zero Error - TrapezoidStart.  Try restarting.');
	pPROFILE^.TIME_ACCEL_END := TIME_NOW_US;
	pPROFILE^.TIME_CRUISE_END := TIME_NOW_US;
	pPROFILE^.TIME_DECEL_END := TIME_NOW_US;
	pPROFILE^.TIME_ACCEL := 0;
	pPROFILE^.TIME_CRUISE := 0;
	pPROFILE^.TIME_DECEL := 0;
ELSIF POSITION_DELTA <= TO_DINT(VELOCITY_RAW * VELOCITY_RAW / ACCEL_RAW) THEN
	(* Triangular move *)

	(* End of accel and end of cruise are at the same time *)
	VMAX := SQRT(DINT_TO_REAL(POSITION_DELTA) * ACCEL_RAW);
	ACCEL_TIME := REAL_TO_DWORD(ABS(1000000.0 * VMAX / ACCEL_RAW));

	pPROFILE^.TIME_ACCEL_END := TIME_NOW_US + ACCEL_TIME;
	pPROFILE^.TIME_CRUISE_END := pPROFILE^.TIME_ACCEL_END;
	pPROFILE^.TIME_DECEL_END := TIME_NOW_US + 2 * ACCEL_TIME;
	pPROFILE^.TIME_ACCEL := ACCEL_TIME;
	pPROFILE^.TIME_CRUISE := 0;
	pPROFILE^.TIME_DECEL := ACCEL_TIME;
ELSE
	(* Trapezoidal move *)
	ACCEL_TIME := REAL_TO_DWORD(1000000 * VELOCITY_RAW / ACCEL_RAW);
	ACCEL_DISTANCE := REAL_TO_DINT(VELOCITY_RAW * TO_REAL(ACCEL_TIME) / 2000000.0);
	CRUISE_DISTANCE := POSITION_DELTA - 2 * ACCEL_DISTANCE;
	CRUISE_TIME := REAL_TO_DWORD(ABS(1000000.0 * TO_REAL(CRUISE_DISTANCE) / VELOCITY_RAW));

	pPROFILE^.TIME_ACCEL_END := TIME_NOW_US + ACCEL_TIME;
	pPROFILE^.TIME_CRUISE_END := pPROFILE^.TIME_ACCEL_END + CRUISE_TIME;
	pPROFILE^.TIME_DECEL_END := pPROFILE^.TIME_CRUISE_END + ACCEL_TIME;
	pPROFILE^.TIME_ACCEL := ACCEL_TIME;
	pPROFILE^.TIME_CRUISE := CRUISE_TIME;
	pPROFILE^.TIME_DECEL := ACCEL_TIME;
END_IF;
 
IF (POSITION_RAW > FB.POSITION_RAW AND FB.RAW_PER_ENGR > 0) OR  
	(POSITION_RAW < FB.POSITION_RAW AND FB.RAW_PER_ENGR < 0) THEN
	pPROFILE^.DIRECTION_POSITIVE := TRUE;
ELSE
	pPROFILE^.DIRECTION_POSITIVE := FALSE;
	pPROFILE^.ACCELERATION := -pPROFILE^.ACCELERATION;
	pPROFILE^.VELOCITY := -pPROFILE^.VELOCITY;
END_IF;

(* Initialize the structure that hold the setpoint *)
pSETPOINT^.VELOCITY_RAW := 0;
pSETPOINT^.POSITION_RAW := FB.POSITION_RAW;

pSETPOINT^.POSITION_ENGR := POSITION_ENGR;
pSETPOINT^.VELOCITY_ENGR := VELOCITY_ENGR;
pSETPOINT^.ACCELERATION_ENGR := ACCEL_ENGR;

pPROFILE^.TIME_SEGMENT_BEGIN := TIME_NOW_US;
pPROFILE^.POS_SEGMENT_BEGIN := FB.POSITION_RAW;
pPROFILE^.STATE := ACCEL;