
(********************** Declaration ****************************)
FUNCTION TrapezoidRun : BOOL
VAR_INPUT
	pPROFILE: POINTER TO sTrapezoid;
	pSETPOINT: POINTER TO sSetpoint;
	TIME_NOW_US: DWORD;
END_VAR
VAR
	TIME_DELTA: DWORD;
	TIME_SEGMENT: REAL;
	POS_DELTA: DINT;
	VEL_DELTA: REAL;
END_VAR
(********************** Implementation ****************************)

TIME_DELTA := TIME_NOW_US - pPROFILE^.TIME_LAST_POINT;
pPROFILE^.TIME_LAST_POINT := TIME_NOW_US;

TIME_SEGMENT := TO_REAL(TIME_NOW_US - pPROFILE^.TIME_SEGMENT_BEGIN) / 1000000.0;
POS_DELTA := 0;
VEL_DELTA := 0;

CASE pPROFILE^.STATE OF
	HOLD: (* Holding position, don't change anything *)
		pSETPOINT^.POSITION_RAW := pPROFILE^.POSITION_END;
		pSETPOINT^.VELOCITY_RAW := 0;
		pSETPOINT^.ACCELERATION_RAW := 0;
	ACCEL: (* Run one acceleration step *)
		pSETPOINT^.VELOCITY_RAW := TIME_SEGMENT * pPROFILE^.ACCELERATION;
		POS_DELTA := REAL_TO_DINT((pPROFILE^.ACCELERATION * TIME_SEGMENT * TIME_SEGMENT) / 2);
		pSETPOINT^.POSITION_RAW := pPROFILE^.POS_SEGMENT_BEGIN + POS_DELTA;
		pSETPOINT^.ACCELERATION_RAW := pPROFILE^.ACCELERATION;
	CRUISE: (* Run one cruise step *)
		POS_DELTA := REAL_TO_DINT(pPROFILE^.VELOCITY * TIME_SEGMENT);
		pSETPOINT^.VELOCITY_RAW := pPROFILE^.VELOCITY;
		pSETPOINT^.POSITION_RAW := pPROFILE^.POS_SEGMENT_BEGIN + POS_DELTA;
		pSETPOINT^.ACCELERATION_RAW := 0;
	DECEL: (* Run one deceleration step *)
		VEL_DELTA := TIME_SEGMENT * pPROFILE^.ACCELERATION;
		POS_DELTA := REAL_TO_DINT(TIME_SEGMENT * pPROFILE^.VEL_SEGMENT_BEGIN - (pPROFILE^.ACCELERATION * TIME_SEGMENT * TIME_SEGMENT) / 2);

		pSETPOINT^.VELOCITY_RAW := pPROFILE^.VEL_SEGMENT_BEGIN - VEL_DELTA;
		pSETPOINT^.POSITION_RAW := pPROFILE^.POS_SEGMENT_BEGIN + POS_DELTA;
		pSETPOINT^.ACCELERATION_RAW := -pPROFILE^.ACCELERATION;
END_CASE;

CASE pPROFILE^.STATE OF
	0: (* holding position *)
		;
	1: (* accel *)
		IF TIME_NOW_US >= pPROFILE^.TIME_CRUISE_END THEN
			(* Triangular move *)
			pPROFILE^.STATE := DECEL;
			pPROFILE^.TIME_SEGMENT_BEGIN := TIME_NOW_US;
			pPROFILE^.POS_SEGMENT_BEGIN := pSETPOINT^.POSITION_RAW;
			pPROFILE^.VEL_SEGMENT_BEGIN := pSETPOINT^.VELOCITY_RAW;
		ELSIF TIME_NOW_US >= pPROFILE^.TIME_ACCEL_END THEN
			(* Trapezoidal move *)
			pPROFILE^.STATE := CRUISE;
			pPROFILE^.TIME_SEGMENT_BEGIN := TIME_NOW_US;
			pPROFILE^.POS_SEGMENT_BEGIN := pSETPOINT^.POSITION_RAW;
			pPROFILE^.VEL_SEGMENT_BEGIN := pSETPOINT^.VELOCITY_RAW;
		END_IF;
	2: (* cruise *)
		IF TIME_NOW_US >= pPROFILE^.TIME_CRUISE_END THEN
			pPROFILE^.STATE := DECEL;
			pPROFILE^.TIME_SEGMENT_BEGIN := TIME_NOW_US;
			pPROFILE^.POS_SEGMENT_BEGIN := pSETPOINT^.POSITION_RAW;
			pPROFILE^.VEL_SEGMENT_BEGIN := pSETPOINT^.VELOCITY_RAW;
		END_IF;
	3: (* decel *)
		IF TIME_NOW_US >= pPROFILE^.TIME_DECEL_END THEN
			pPROFILE^.STATE := HOLD;
			pPROFILE^.TIME_SEGMENT_BEGIN := TIME_NOW_US;
			pPROFILE^.POS_SEGMENT_BEGIN := pSETPOINT^.POSITION_RAW;
			pPROFILE^.VEL_SEGMENT_BEGIN := pSETPOINT^.VELOCITY_RAW;
		END_IF;
END_CASE;
