
(********************** Declaration ****************************)
FUNCTION ConfigVffInit : BOOL
VAR_INPUT
	pCONFIG: POINTER TO sConfig;
	FB: sFeedback;
	SPEED_PLUS_MAX: REAL;
	SPEED_MINUS_MAX: REAL;
END_VAR
VAR
END_VAR
(********************** Implementation ****************************)
pCONFIG^.SPEED_PLUS_MAX := SPEED_PLUS_MAX;
pCONFIG^.SPEED_MINUS_MAX := SPEED_MINUS_MAX;

IF pCONFIG^.SPEED_MINUS_MAX <> 0 THEN
	pCONFIG^.VFF_MPCT_PER_CPS_MINUS := (1000.0 / pCONFIG^.SPEED_MINUS_MAX) / (FB.RAW_PER_ENGR / 10000.0);
ELSE
	pCONFIG^.VFF_MPCT_PER_CPS_MINUS := 0;
END_IF;

IF pCONFIG^.SPEED_PLUS_MAX <> 0 THEN
	pCONFIG^.VFF_MPCT_PER_CPS_PLUS := (1000.0 / pCONFIG^.SPEED_PLUS_MAX) / (FB.RAW_PER_ENGR / 10000.0);
ELSE
	pCONFIG^.VFF_MPCT_PER_CPS_PLUS := 0;
END_IF;


