
(********************** Declaration ****************************)
FUNCTION_BLOCK PositionShow
VAR_INPUT
	SP: sSetpoint;
	FB: sFeedback;
END_VAR
VAR_OUTPUT
	POSITION_ENGR_ACTUAL: REAL;
	POSITION_ENGR_SETPOINT: REAL;
	POSITION_ENGR_ERROR: REAL;
	POSITION_ENGR_ABSERROR: REAL;
END_VAR
VAR
END_VAR
(********************** Implementation ****************************)
POSITION_ENGR_ACTUAL := FB.POSITION_ENGR;
POSITION_ENGR_SETPOINT := SP.POSITION_ENGR;
POSITION_ENGR_ERROR := SP.POSITION_ENGR - FB.POSITION_ENGR;
POSITION_ENGR_ABSERROR := ABS(POSITION_ENGR_ERROR);
