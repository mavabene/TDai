
(********************** Declaration ****************************)
//{attribute 'qualified_only'}

// used to set diag array dimensions
VAR_GLOBAL CONSTANT
	NUM_DIAG_TOPICS: USINT := 19; // 25 for TD2
	NUM_DIAG_CATS: USINT := 6;
END_VAR	

VAR_GLOBAL
	
	CAN_VALVES: ARRAY[1..NUM_AXES] OF POINTER TO _3SCOS.CANRemoteDevice :=
		[
			ADR(BOOM_SWING_VALVE),
			ADR(X_SLIDE_VALVE),
			ADR(YAW_VALVE),
			ADR(PITCH_VALVE),
			ADR(Z_SLIDE_VALVE),
			ADR(ROTATOR_VALVE),
			ADR(MAST_SLIDE_VALVE),
			ADR(LOWER_CROWD_VALVE),
			ADR(LOWER_ROTARY_VALVE),
			ADR(UPPER_CROWD_VALVE),
			ADR(UPPER_ROTARY_VALVE),
			ADR(LEFT_TRACK_VALVE),
			ADR(RIGHT_TRACK_VALVE),
			ADR(BOOM_LIFT_VALVE),
			ADR(JOINT_LIFT_VALVE),
			ADR(PENDULUM_VALVE),
			ADR(HAMMER_VALVE),
			ADR(OUTRIGGER_VALVE),
			ADR(CENTRALIZER_VALVE),
			ADR(LEFT_CRIMPER_VALVE),
			ADR(RIGHT_CRIMPER_VALVE),
			ADR(TARGET_PLATE_VALVE)
		];
	
	(* ----------------------- INPUT POINT MAPPING ------------------------------------ *)
	// Hutte machine PLC Inputs here..
	// A, B low
	HYDRAULIC_TEMP_POINT: UINT := 100; // aka wire 63
	PUMP_PRESSURE_POINT: UINT := 101; // aka wire 64
	LOWER_ROTARY_PRESSURE_POINT: UINT := 102; // aka wire 65
	LOWER_CROWD_PRESSURE_POINT: UINT := 103; // aka wire 66
	UPPER_CROWD_PRESSURE_POINT: UINT := 200; // aka wire 67
	UPPER_ROTARY_PRESSURE_POINT: UINT := 201; // aka wire 68
	HAMMER_PRESSURE_POINT: UINT := 203;
	AIR_COMPRESSOR_STATUS_POINT: UINT := 202; // aka wire 69
	LEFT_CRIMPER_CLOSE_BUTTON_POINT: UINT := 600;
	LEFT_CRIMPER_OPEN_BUTTON_POINT: UINT := 601;
	HORN_BUTTON_POINT: UINT := 602;
	LIGHT_1_BUTTON_POINT: UINT := 603;
	LIGHT_2_BUTTON_POINT: UINT := 700;
	LEFT_CRIMPER_CONFIRM_BUTTON_POINT: UINT := 701;
	AIR_COMPRESSOR_WET_PRESSURE_POINT: UINT := 702;
	AIR_COMPRESSOR_TEMP_POINT: UINT := 703;
	// B l/h, FRQ
	ROTARY_SPEED_A_POINT: UINT := 0;
	ROTARY_SPEED_B_POINT: UINT := 1;
	AVAIL_INPUT_002_POINT: UINT := 2;
	AVAIL_INPUT_003_POINT: UINT := 3;
	PROXIMITY_SENSOR_NC_POINT: UINT := 500;
	PROXIMITY_SENSOR_NO_POINT: UINT := 501;
	AVAIL_INPUT_502_POINT: UINT := 502;
	AVAIL_INPUT_503_POINT: UINT := 503;
	// R, B low
	RIGHT_CRIMPER_CLOSE_BUTTON_POINT: UINT := 400;
	RIGHT_CRIMPER_OPEN_BUTTON_POINT: UINT := 401;
	RIGHT_CRIMPER_CONFIRM_BUTTON_POINT: UINT := 900;
	INPUT_901_POINT: UINT := 901; // PROXIMITY_ALARM? resistor input, binary low side (CSI)
	// B low (3.2kohm)
	AVAIL_INPUT_300_POINT: UINT := 300;
	AVAIL_INPUT_301_POINT: UINT := 301;
	AVAIL_INPUT_800_POINT: UINT := 800;
	AVAIL_INPUT_801_POINT: UINT := 801;

	(* ----------------------- OUTPUT POINT MAPPING ------------------------------------ *)
	// Hutte output points.
	AIR_COMPRESSOR_REQUEST_POINT: UINT := 0;
	X_LASER_POINT: UINT := 1;
	E_STOP_OUT_POINT: UINT := 2;
	PENDULUM_POINT: UINT := 3;
	//4
	AIR_COMPRESSOR_UNLOAD_POINT: UINT := 5;
	AIR_COMPRESSOR_FAN_POINT: UINT := 6;
	//7
	//8
	AIR_COMPRESSOR_SUPPLY_POINT: UINT := 100;
	ENGINE_REV_DOWN_POINT: UINT := 101;
	HORN1_POINT: UINT := 102;
	TRAVEL_ALARM_POINT: UINT := 103;
	RED_LIGHT_POINT: UINT := 104;
	YELLOW_LIGHT_POINT: UINT := 105;
	GREEN_LIGHT_POINT: UINT := 106;
	BLUE_LIGHT_POINT: UINT := 107;
	HORN2_POINT: UINT := 108;
	//200
	LIGHT_1_POINT: UINT := 201;
	LIGHT_2_POINT: UINT := 202;
	COOLER_SOLENOID_POINT: UINT := 203;
	//204
	ENGINE_REV_UP_POINT: UINT := 205;
	PROXIMITY_SENSOR_ANTENNA_POINT: UINT := 206; //206
	PROXIMITY_SENSOR_ALARM_MUTE_POINT: UINT := 207; //207
	//208 see below
	
	// TD-2 output points, set to unused output to prevent S/W bug from doing bad things.
// 	TRACK_HIGH_SPEED_POINT: UINT := 6;
// 	HYDRAULIC_FAN_POINT: UINT := 208;
// 	HAMMER_POINT: UINT := 208; //2;
// 	UPPER_ROTARY_FWD_POINT: UINT := 208; //3;
// 	UPPER_ROTARY_REV_POINT: UINT := 208; //4;
// 	BLADE_DOWN_POINT: UINT := 208; //5;
// 	BLADE_UP_POINT: UINT := 208; //6;
// 	CENTRALIZER_OPEN_POINT: UINT := 208; //8;
// 	CENTRALIZER_CLOSE_POINT: UINT := 208; //7;
	SPARE_OUT_2_POINT: UINT := 208; //108;
	SPARE_OUT_3_POINT: UINT := 208; //200;
// 	LEFT_CRIMPER_CLOSE_POINT: UINT := 208; //201;
// 	LEFT_CRIMPER_OPEN_POINT: UINT := 208; //202;
// 	RIGHT_CRIMPER_CLOSE_POINT: UINT := 208;
// 	RIGHT_CRIMPER_OPEN_POINT: UINT := 208;
// 	TARGET_PLATE_DOWN_POINT: UINT := 208;
// 	TARGET_PLATE_UP_POINT: UINT := 208;
	
	// used to update array of diagnostic INTs to send to HMI.
	WIRED_OUTS: ARRAY [2..NUM_DIAG_TOPICS] OF POINTER TO ifmIOCommon.OUTPUT :=
	[
		ADR(PWM_FAN),         //2
		ADR(OUT_AIR_COMPRESSOR_REQUEST),     //3
		ADR(OUT_AIR_COMPRESSOR_SUPPLY),      //4
		ADR(OUT_AIR_COMPRESSOR_UNLOAD),      //5
		//ADR(OUT_COOLER_SOLENOID),            //5 may be used in future
		ADR(OUT_ENGINE_REV_DOWN),            //6
		ADR(OUT_ENGINE_REV_UP),              //7
		ADR(OUT_E_STOP),                     //8
		ADR(OUT_HORN1),                      //9
		ADR(OUT_HORN2),                      //10
		ADR(OUT_LIGHT_1),                    //11
		ADR(OUT_LIGHT_2),                    //12
		ADR(OUT_BLUE_LIGHT),                 //13
		ADR(OUT_GREEN_LIGHT),                //14  
		ADR(OUT_RED_LIGHT),                  //15
		ADR(OUT_YELLOW_LIGHT),               //16
		ADR(OUT_PENDULUM),                   //17
		ADR(OUT_TRAVEL_ALARM),               //18
		ADR(OUT_X_LASER)                     // --19--

	];

END_VAR