
(********************** Declaration ****************************)
VAR_GLOBAL
	pAXIS: POINTER TO sAXIS;

	VIS_TUNE_ENABLED: BOOL := FALSE;
	MODE: BOOL;
	JUNK: BOOL;

	VIS_ISUM_MAX: WORD;
	VIS_VFF_PLUS: REAL;
	VIS_VFF_MINUS: REAL;
	VIS_ISUM_MAX_LAST: WORD := 1001;
	VIS_VFF_PLUS_LAST: REAL := -1;
	VIS_VFF_MINUS_LAST: REAL := -1;

	VIS_SETPOINT: REAL;
	VIS_ACTUAL: REAL;
	VIS_ERROR: REAL;

	VIS_AUTO: BOOL;
	VIS_FUNCTION: BOOL;

	VIS_ENDPOINT1: REAL;
	VIS_ENDPOINT2: REAL;

	VIS_AUTO_DISP: STRING;
	VIS_FUNCTION_DISP: STRING;

	VIS_POS_UNITS: STRING := 'Position';
	VIS_VEL_UNITS: STRING := 'Velocity';
	VIS_NEXT_AXIS: BOOL := FALSE;
	VIS_AXIS: INT := 0; (* Invalid *)
	VIS_SELECTED_AXIS: STRING := 'None';

	STEP_SIZE: REAL := 1.0;
	ACCELERATION: REAL := 1.0;
	VELOCITY: REAL := 1.0;
	CYCLE_PLUS: REAL := 10;
	CYCLE_MINUS: REAL := -10;
	CYCLE_DELAY_US: UDINT := 2000000;
	STEP_DELAY_US: UDINT := 2000000;

END_VAR
