
(********************** Declaration ****************************)
FUNCTION isNxt3lmSideLeg_perLatch : BOOL
VAR_INPUT
END_VAR
VAR
END_VAR

(********************** Implementation ****************************)

isNxt3lmSideLeg_perLatch :=
		(pNVM3^.PRODUCT_INSTALL = eProductType.PRODUCT_NXT_SI) 
	AND
		(TRUSS_TYPE_LATCH = eTrussType.TRUSS_TYPE_CENTER_STRUCTURE) 
	AND
		(SCREW_SIDE_LATCH <> eScrewSide.SCREW_CENTER);
