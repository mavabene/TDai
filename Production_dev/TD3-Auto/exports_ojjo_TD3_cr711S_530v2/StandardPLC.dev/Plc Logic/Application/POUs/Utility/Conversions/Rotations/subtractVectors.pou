
(********************** Declaration ****************************)
FUNCTION subtractVectors : vector3D
VAR_INPUT
	endPoint : Vector3D;
	startPoint : Vector3D; // vector subtracted
END_VAR
VAR
	i : USINT;
END_VAR

(********************** Implementation ****************************)
FOR i := 1 TO 3 DO
	subtractVectors[i] := endPoint[i] - startPoint[i];
END_FOR