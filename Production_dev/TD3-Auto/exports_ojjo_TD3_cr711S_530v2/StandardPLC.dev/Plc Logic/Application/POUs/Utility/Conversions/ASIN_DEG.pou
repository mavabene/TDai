
(********************** Declaration ****************************)
FUNCTION ASIN_DEG: REAL
VAR_INPUT
	VALUE: REAL;
END_VAR
VAR
END_VAR
(********************** Implementation ****************************)
// ASIN_DEG := (180 * ASIN(VALUE)) / 3.14159;

// prevent killing PLC with a NaN if bad value sent
// Clamp to the valid ASIN input range while preserving direction.
IF ABS(VALUE) > 1 THEN
    VALUE := MAX(MIN(VALUE, 1.0), -1.0);
END_IF

ASIN_DEG := (180 * ASIN(VALUE)) / Pi;


