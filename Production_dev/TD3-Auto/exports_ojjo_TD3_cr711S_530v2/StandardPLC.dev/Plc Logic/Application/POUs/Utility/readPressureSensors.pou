
(********************** Declaration ****************************)
FUNCTION readPressureSensors : BOOL
VAR_INPUT
END_VAR
VAR
END_VAR

(********************** Implementation ****************************)
IN_LOWER_ROTARY_PRESSURE(
	uiCHANNEL := LOWER_ROTARY_PRESSURE_POINT,
	uiValueAnalogue => LOWER_ROTARY_PRESSURE_RAW);

IN_LOWER_CROWD_PRESSURE(
	uiCHANNEL := LOWER_CROWD_PRESSURE_POINT,
	uiValueAnalogue => LOWER_CROWD_PRESSURE_RAW);

IN_UPPER_ROTARY_PRESSURE(
	uiCHANNEL := UPPER_ROTARY_PRESSURE_POINT,
	uiValueAnalogue => UPPER_ROTARY_PRESSURE_RAW);

IN_UPPER_CROWD_PRESSURE(
	uiCHANNEL := UPPER_CROWD_PRESSURE_POINT,
	uiValueAnalogue => UPPER_CROWD_PRESSURE_RAW);
IF pNVM3^.MACHINE_VERSION >= 7 THEN
	IN_HAMMER_PRESSURE(
	uiCHANNEL := HAMMER_PRESSURE_POINT,
	uiValueAnalogue => HAMMER_PRESSURE_RAW);
END_IF


LOWER_ROTARY_PRESSURE := ((LOWER_ROTARY_PRESSURE_RAW - PRESSURE_OFFSET) * PRESSURE_SCALE_FACTOR);
LOWER_CROWD_PRESSURE := ((LOWER_CROWD_PRESSURE_RAW - PRESSURE_OFFSET) * PRESSURE_SCALE_FACTOR);
UPPER_ROTARY_PRESSURE := ((UPPER_ROTARY_PRESSURE_RAW - PRESSURE_OFFSET) * PRESSURE_SCALE_FACTOR);
UPPER_CROWD_PRESSURE := ((UPPER_CROWD_PRESSURE_RAW - PRESSURE_OFFSET) * PRESSURE_SCALE_FACTOR);
HAMMER_PRESSURE := ((HAMMER_PRESSURE_RAW - PRESSURE_OFFSET) * PRESSURE_SCALE_FACTOR);

(* Let the filter in the pressure sensor itself handle this. *)
LOWER_ROTARY_PRESSURE_FILTERED := LOWER_ROTARY_PRESSURE;
LOWER_CROWD_PRESSURE_FILTERED := LOWER_CROWD_PRESSURE;
UPPER_ROTARY_PRESSURE_FILTERED := UPPER_ROTARY_PRESSURE;
UPPER_CROWD_PRESSURE_FILTERED := UPPER_CROWD_PRESSURE;
