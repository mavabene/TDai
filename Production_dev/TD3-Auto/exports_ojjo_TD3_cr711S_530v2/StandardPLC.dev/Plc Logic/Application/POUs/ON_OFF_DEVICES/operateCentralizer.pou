
(********************** Declaration ****************************)
FUNCTION_BLOCK operateCentralizer
VAR_INPUT
	DESIRE_CLOSED: BOOL;
END_VAR
VAR
	PWM_OUTPUT: HawePSVPwmOutput;
	MAGNITUDE: WORD;
	POSITIVE: BOOL;
	
	OPEN_DIAG: ifmTypes.DIAG_INFO;
	OPEN_CMD: BOOL := FALSE;
	OPEN_ERROR: BOOL;
	OPEN_ACTIVATED: BOOL;
	OPEN_PREPARED: BOOL;

	CLOSE_PREPARED: BOOL;
	CLOSE_DIAG: ifmTypes.DIAG_INFO;
	CLOSE_CMD: BOOL := FALSE;
	CLOSE_ERROR: BOOL;
	CLOSE_ACTIVATED: BOOL;

	LAST_DESIRE_CLOSED: BOOL;
	NEEDS_INIT: BOOL := TRUE;
	TURNED_OFF: BOOL := FALSE;
	CLOSE_START: DWORD;
	OPEN_START: DWORD;

END_VAR
(********************** Implementation ****************************)
(* Don't operate centralizer or outrigger immediately on powerup to keep from lugging the diesel. *)
IF TIME_SECONDS > 15 AND MACHINE_MODE <> IDLE_MODE THEN
	IF NEEDS_INIT OR (DESIRE_CLOSED <> LAST_DESIRE_CLOSED) THEN
		(* Retract on powerup, as the operator may want to track. *)
		IF NOT DESIRE_CLOSED OR NEEDS_INIT THEN
			(* State has changed to open, or on powerup.  Turn on open output and start the timer. *)
			CLOSE_CMD := FALSE;
			OPEN_CMD := TRUE;
			OPEN_START := TIME_SECONDS;
			CLOSE_START := TIME_SECONDS + 9999;
		ELSE
			(* State has changed to close.  Turn on close output and start the timer. *)
			OPEN_CMD := FALSE;
			CLOSE_CMD := TRUE;
			CLOSE_START := TIME_SECONDS;
			OPEN_START := TIME_SECONDS + 9999;
		END_IF
	END_IF
	
	IF (NOT DESIRE_CLOSED AND TIME_SECONDS - OPEN_START > 10) OR (DESIRE_CLOSED AND TIME_SECONDS - CLOSE_START > 10) THEN
		OPEN_CMD := FALSE;
		CLOSE_CMD := FALSE;
		TURNED_OFF := TRUE;
	END_IF
	
	LAST_DESIRE_CLOSED := DESIRE_CLOSED;
	
	IF NEEDS_INIT THEN
		NEEDS_INIT := FALSE;
	END_IF
ELSE
	OPEN_CMD := FALSE;
	CLOSE_CMD := FALSE;
END_IF

IF CENTRALIZER_OPEN_FORCE.FORCED AND CENTRALIZER_OPEN_FORCE.DOUT_STATE THEN
	OPEN_CMD := TRUE;
	CLOSE_CMD := FALSE;
ELSIF CENTRALIZER_CLOSE_FORCE.FORCED AND CENTRALIZER_CLOSE_FORCE.DOUT_STATE THEN
	OPEN_CMD := FALSE;
	CLOSE_CMD := TRUE;
END_IF

IF OPEN_CMD THEN
	POSITIVE := TRUE;
	MAGNITUDE := pNVM2^.CENTRALIZER_OPEN_SPEED * 10;
ELSIF CLOSE_CMD THEN
	POSITIVE := FALSE;
	MAGNITUDE := pNVM2^.CENTRALIZER_CLOSE_SPEED * 10;
ELSE
	POSITIVE := FALSE;
	MAGNITUDE := 0;
END_IF

setOutput(ADR(AXES[AXIS_CENTRALIZER].OUTPUT), MAGNITUDE, POSITIVE);
HaweOutput(ADR(AXES[AXIS_CENTRALIZER]));	

