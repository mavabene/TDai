
(********************** Declaration ****************************)
FUNCTION ArrayOfUsintsToLWORD : LWORD // not tested, may be a problem with this that crashes PLC
VAR_INPUT
	ARRAY_SIZE: INT :=4; // accept arrays of 2 - 8 BYTES
	LITTLE_ENDIAN: BOOL := TRUE;
END_VAR
VAR_IN_OUT
	BYTE_ARRAY: ARRAY [*] OF USINT;
END_VAR
VAR
	i: INT :=0;
	dataLWORD: LWORD :=0;
	BArray: ARRAY [0..8] OF BYTE := [0,0,0,0,0,0,0,0];
	
END_VAR
(********************** Implementation ****************************)
// concat array of bytes into LWORD
// rearrange for endianness

IF LITTLE_ENDIAN THEN
	dataLWORD :=  SHL(TO_LWORD(BArray[0]),8) OR BArray[1];
	FOR i := 0 TO ARRAY_SIZE - 1 DO
		BArray[ARRAY_SIZE - i - 1] := TO_BYTE(BYTE_ARRAY[i]);
	END_FOR
ELSE
	dataLWORD := BArray[1] OR SHL(TO_LWORD(BArray[0]),8);
	FOR i := 0 TO ARRAY_SIZE - 1 DO
		BArray[i] := TO_BYTE(BYTE_ARRAY[i]);
	END_FOR
END_IF

// pack arranged array into LWORD
dataLWORD :=  SHL(TO_LWORD(BArray[0]),8) OR BArray[1];
IF ARRAY_SIZE > 2 THEN
	FOR i := 2 TO ARRAY_SIZE - 1 DO
		dataLWORD := SHL(dataLWORD,8) OR BArray[i];
	END_FOR
END_IF

ArrayOfUsintsToLWORD := dataLWORD;