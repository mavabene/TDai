
(********************** Declaration ****************************)
FUNCTION_BLOCK feedbackFailed
VAR_INPUT
END_VAR
VAR_OUTPUT
	FAILED: BOOL;
END_VAR
VAR
	FEEDBACK_AVAILABLE: BOOL;
	FEEDBACK_AVAILABLE_LAST: BOOL;
	TIME_FEEDBACK_LOSS_DETECT: DWORD := 0;
END_VAR
(********************** Implementation ****************************)

FEEDBACK_AVAILABLE := FALSE;
FEEDBACK_FAIL_CURRENT := 0;

IF (BASE_INCLINOMETER_STATUS <> 5) THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_BASE_INCLINOMETER);
END_IF
IF (KNUCKLE_INCLINOMETER_STATUS <> 5) THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_KNUCKLE_INCLINOMETER);
END_IF
IF (MAST_INCLINOMETER_STATUS <> 5) THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_MAST_INCLINOMETER);
END_IF
IF (LOWER_CROWD_ENCODER_STATUS <> 5) THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_LOWER_CROWD_ENCODER);
END_IF
IF (UPPER_CROWD_ENCODER_STATUS <> 5) THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_UPPER_CROWD_ENCODER);
END_IF
IF (TRUNION_ENCODER_STATUS <> 5) THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_TRUNION_ENCODER);
END_IF
IF NOT AXES[AXIS_MAST_SLIDE].FEEDBACK.SAMPLE_VALID THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_MAST_SLIDE_ENCODER);
END_IF
IF NOT AXES[AXIS_Z_SLIDE].FEEDBACK.SAMPLE_VALID THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_Z_SLIDE_ENCODER);
END_IF
IF NOT AXES[AXIS_X_SLIDE].FEEDBACK.SAMPLE_VALID THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_X_SLIDE_ENCODER);
END_IF
IF (BOOM_SWING_ENCODER_STATUS <> 5) THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_BOOM_SWING_ENCODER);
END_IF
IF (BOOM_LIFT_ENCODER_STATUS <> 5) THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_BOOM_LIFT_ENCODER);
END_IF
IF (JOINT_LIFT_ENCODER_STATUS <> 5) THEN
	FEEDBACK_FAIL_CURRENT := FEEDBACK_FAIL_CURRENT OR TO_DWORD(eFeedbackCauseMask.FEEDBACK_JOINT_LIFT_ENCODER);
END_IF


IF FEEDBACK_FAIL_CURRENT = 0 THEN
	FEEDBACK_AVAILABLE := TRUE;
END_IF

IF TIME_SECONDS > 20 THEN
	FEEDBACK_FAIL_LATCH := FEEDBACK_FAIL_LATCH OR FEEDBACK_FAIL_CURRENT;
ELSE
	FEEDBACK_FAIL_LATCH := 0;
END_IF

IF NOT FEEDBACK_AVAILABLE AND FEEDBACK_AVAILABLE_LAST THEN
	TIME_FEEDBACK_LOSS_DETECT := MSTIME;
END_IF

IF NOT FEEDBACK_AVAILABLE AND
	(MACHINE_MODE <> IDLE_MODE) AND
	(MSTIME - TIME_FEEDBACK_LOSS_DETECT) > 1000 THEN
	FAILED := TRUE;
ELSE
	FAILED := FALSE;
END_IF

FEEDBACK_AVAILABLE_LAST := FEEDBACK_AVAILABLE;
