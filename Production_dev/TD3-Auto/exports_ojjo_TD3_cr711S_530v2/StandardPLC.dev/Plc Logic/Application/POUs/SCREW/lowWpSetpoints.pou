
(********************** Declaration ****************************)
FUNCTION lowWpSetpoints : BOOL
VAR_INPUT
END_VAR
VAR
END_VAR
(********************** Implementation ****************************)

IF SCREW_SIDE_LATCH = SCREW_RIGHT THEN
	ROTATOR_Y := ROTATOR_WP_Y + ROTATOR_OFFSET_Y;
	BOOM_SWING_SCREW := ATAN_DEG(ROTATOR_Y / ROTATOR_WP_Z);
	Z_SLIDE_SCREW := SQRT(ROTATOR_Y * ROTATOR_Y + ROTATOR_WP_Z * ROTATOR_WP_Z) - BR_ROT_PIVOT_MIN;
ELSIF SCREW_SIDE_LATCH = SCREW_LEFT THEN
	ROTATOR_Y := ROTATOR_WP_Y - ROTATOR_OFFSET_Y;
	BOOM_SWING_SCREW := ATAN_DEG(ROTATOR_Y / ROTATOR_WP_Z);
	Z_SLIDE_SCREW := SQRT(ROTATOR_Y * ROTATOR_Y + ROTATOR_WP_Z * ROTATOR_WP_Z) - BR_ROT_PIVOT_MIN;
ELSE
	(* Straight screws come here. *)
	ROTATOR_Y := ROTATOR_WP_Y;
	LOW_WP_ADJUST := 0;
	BOOM_SWING_SCREW := BOOM_SWING_AT_WP;
	Z_SLIDE_SCREW := Z_SLIDE_AT_WP;
END_IF

