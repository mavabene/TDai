
(********************** Declaration ****************************)
FUNCTION setScrewParameters : BOOL
VAR_INPUT
END_VAR
VAR
	LASER_USED_THIS_TRUSS: BOOL := TRUE;
END_VAR

(********************** Implementation ****************************)
// set up screw specific paramaters for drilling pnezD Description field

(***** PNEZD *****)
// if selected and we see a valid code set screw parameters per Description field from GPS pnezD :
IF pNVM4^.HMI_BOOLS[SCREW_PARAMS_SOURCE_IS_PNEZD] AND DecodePnezD() THEN
	// change sign if facing South instead of North
	IF GPS_ABSOLUTE_HEADING > 90 AND GPS_ABSOLUTE_HEADING < 270 THEN
		SCREW_PARAMETERS_CURRENT.NS_PITCH := SCREW_PARAMETERS_PNEZD.NS_PITCH;
	ELSE
		SCREW_PARAMETERS_CURRENT.NS_PITCH := -SCREW_PARAMETERS_PNEZD.NS_PITCH;
	END_IF
	
	SCREW_PARAMETERS_CURRENT.SCREW_LENGTH := SCREW_PARAMETERS_PNEZD.SCREW_LENGTH;
	SCREW_PARAMETERS_CURRENT.TRUSS_SIDE_LEG_ANGLE := SCREW_PARAMETERS_PNEZD.TRUSS_SIDE_LEG_ANGLE;
	SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := SCREW_PARAMETERS_PNEZD.THIRD_LEG_VERT_ANGLE; 
	// correct for large third leg angles that cause the mast foot to slide out
	IF 	SCREW_PARAMETERS_PNEZD.THIRD_LEG_VERT_ANGLE < 100 AND 
		SCREW_PARAMETERS_PNEZD.THIRD_LEG_VERT_ANGLE > 15 
		THEN 
		SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE + HMI_REALS_VALUES[THIRD_LEG_ANGLE_COMPENSATION];
	END_IF
	SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := SCREW_PARAMETERS_PNEZD.EMBED_LENGTH;
	SCREW_PARAMETERS_CURRENT.IE_MIN_HAMMER := SCREW_PARAMETERS_PNEZD.IE_MIN_HAMMER;
	SCREW_PARAMETERS_CURRENT.IE_MIN_EMBED := SCREW_PARAMETERS_PNEZD.IE_MIN_EMBED;
// 	IF SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE > 30 AND isNXT_INT() THEN // Ojjo 2.0 = 40 deg
// // 		SCREW_PARAMETERS_CURRENT.MOTOR_TYPE := 2;
// 	ELSIF SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE > 30 THEN // Heavy Motor = 35 deg
// // 		SCREW_PARAMETERS_CURRENT.MOTOR_TYPE := eTrackerRow.TRACKER_ROW_HEAVY;
// 	ELSIF SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE > 10 THEN // Standard Motor = 20 deg
// 		SCREW_PARAMETERS_CURRENT.MOTOR_TYPE := eTrackerRow.TRACKER_ROW_STANDARD;
// 	END_IF
	IF SCREW_PARAMETERS_PNEZD.TRUSS_TYPE = 3 THEN
		SCREW_PARAMETERS_CURRENT.TRUSS_TYPE := TO_UINT(getTrussType());
		TRUSS_TYPE_LATCH := getTrussType();
	ELSE
		SCREW_PARAMETERS_CURRENT.TRUSS_TYPE := SCREW_PARAMETERS_PNEZD.TRUSS_TYPE;
		CASE TO_INT(SCREW_PARAMETERS_CURRENT.TRUSS_TYPE) OF
			0: 
				TRUSS_TYPE_LATCH := eTrussType.TRUSS_TYPE_NORMAL;
			1: 
				TRUSS_TYPE_LATCH := eTrussType.TRUSS_TYPE_CENTER_STRUCTURE;
			2: 
				TRUSS_TYPE_LATCH := eTrussType.TRUSS_TYPE_END;
		END_CASE
	END_IF

(***** Remote Control / HMI *****)
// set screw parameters per REMOTE CONTROL switches and HMI settings
ELSE 
	SCREW_PARAMETERS_CURRENT.TRUSS_TYPE := TO_USINT(getTrussType());
	TRUSS_TYPE_LATCH := getTrussType();

	// set Torque Tube Pitch/ Truss NS pitch (convert % slope to deg)
	SCREW_PARAMETERS_CURRENT.NS_PITCH := -ATAN_DEG(pNVM1^.TORQUE_TUBE_PITCH / 100);
	// set Screw Length param (used here and other places)
	SCREW_LENGTH_LATCH := getScrewLength(); 
	// set screw length
	SCREW_PARAMETERS_CURRENT.SCREW_LENGTH := pNVM1^.SCREW_LENGTHS_CM[TO_WORD(SCREW_LENGTH_LATCH)];
	
	// set embedment
	IF SCREW_SIDE_LATCH = SCREW_CENTER AND NOT isNXTmotorTruss_perScrewParams() THEN
// 	IF SCREW_SIDE_LATCH = SCREW_CENTER AND NOT isNXTmotorThirdLeg() THEN
		// Plumb screw in situ comes here.
		SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM4^.PLUMB_SCREW_EMBEDMENT;
	ELSE
		
		//  ***** new *****
		IF isNXTmotorThirdLeg_perLatch() THEN
			IF isNXT_SI_perHMI() THEN
				IF pNVM4^.TRACKER_ROW_TYPE = eTrackerRow.TRACKER_ROW_SI_STANDARD THEN
					SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM4^.NXT_TLM_3L_EMBEDMENT_CM;
				ELSE
					SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM4^.NXT_TLM_3L_HEAVY_EMBEDMENT_CM;
				END_IF
			ELSE
				SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM4^.HMI_REALS[NXT_INT_VAR_MOTOR_3L_EMBED];
			END_IF
		ELSE
			IF pNVM4^.TRACKER_ROW_TYPE = eTrackerRow.TRACKER_ROW_SI_STANDARD THEN
				SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM1^.STANDARD_EMBEDMENT_CM[SCREW_LENGTH_LATCH];
			ELSE
				SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM4^.HEAVY_EMBEDMENT_CM[SCREW_LENGTH_LATCH];
			END_IF
		END_IF
		// ^^^^^ new ^^^^^
		//  ***** old *****
// 		IF isNXT_SI3lm3lScrew() THEN
// 			IF pNVM4^.TRACKER_ROW_TYPE = eTrackerRow.TRACKER_ROW_SI_STANDARD THEN
// 				SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM4^.NXT_TLM_3L_EMBEDMENT_CM;
// 			ELSE
// 				SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM4^.NXT_TLM_3L_HEAVY_EMBEDMENT_CM;
// 			END_IF
// 		ELSIF isNXTmotorThirdLeg() THEN
// 			SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM4^.HMI_REALS[NXT_INT_VAR_MOTOR_3L_EMBED];
// 		ELSE
// 			IF pNVM4^.TRACKER_ROW_TYPE = eTrackerRow.TRACKER_ROW_SI_STANDARD THEN
// 				SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM1^.STANDARD_EMBEDMENT_CM[SCREW_LENGTH_LATCH];
// 			ELSE
// 				SCREW_PARAMETERS_CURRENT.EMBED_LENGTH := pNVM4^.HEAVY_EMBEDMENT_CM[SCREW_LENGTH_LATCH];
// 			END_IF
// 		END_IF
		// ^^^^^ old ^^^^^
	END_IF
	
	// set screw side to side angle from 
	// truss screws:
	IF (pNVM3^.PRODUCT_INSTALL = eProductType.PRODUCT_NXT_SI OR pNVM3^.PRODUCT_INSTALL = eProductType.PRODUCT_NXT_VAR) AND TRUSS_TYPE_LATCH = eTrussType.TRUSS_TYPE_CENTER_STRUCTURE THEN
		// Truss part of the NXT 3LM foundation.
		SCREW_PARAMETERS_CURRENT.TRUSS_SIDE_LEG_ANGLE := pNVM4^.NXT_TLM_T_ANGLE;
	ELSIF pNVM3^.PRODUCT_INSTALL = eProductType.PRODUCT_NXT_INT THEN
		SCREW_PARAMETERS_CURRENT.TRUSS_SIDE_LEG_ANGLE := 20;
	ELSE
		// Normal array truss.
		SCREW_PARAMETERS_CURRENT.TRUSS_SIDE_LEG_ANGLE := pNVM1^.ROTATOR_SCREW_POS;
	END_IF
	// 3rd Leg screws:
	
	//***** new version *****
	IF isNXTmotorTruss_perScrewParams() THEN
		IF isNXT_SI_perHMI() THEN
			IF pNVM4^.TRACKER_ROW_TYPE = eTrackerRow.TRACKER_ROW_SI_STANDARD THEN
				SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := 20;
	// 			SCREW_PARAMETERS_CURRENT.MOTOR_TYPE := eTrackerRow.TRACKER_ROW_STANDARD;
			ELSIF pNVM4^.TRACKER_ROW_TYPE = eTrackerRow.TRACKER_ROW_SI_HEAVY THEN
				SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := 35;
	// 			SCREW_PARAMETERS_CURRENT.MOTOR_TYPE := eTrackerRow.TRACKER_ROW_HEAVY;
			END_IF
		ELSIF isNXT_INT_perHMI() THEN
			SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := 40;
		ELSE // variable truss geometry
			SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := pNVM4^.HMI_REALS[NXT_VAR_3L_ANGLE];
		END_IF
	ELSE
		SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := 0;
	END_IF
	//^^^^^ new version ^^^^^
// 	IF isNXT_SImotorThirdLegRemote() THEN
// 		IF pNVM4^.TRACKER_ROW_TYPE = eTrackerRow.TRACKER_ROW_SI_STANDARD THEN
// 			SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := 20;
// // 			SCREW_PARAMETERS_CURRENT.MOTOR_TYPE := eTrackerRow.TRACKER_ROW_STANDARD;
// 		ELSIF pNVM4^.TRACKER_ROW_TYPE = eTrackerRow.TRACKER_ROW_SI_HEAVY THEN
// 			SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := 35;
// // 			SCREW_PARAMETERS_CURRENT.MOTOR_TYPE := eTrackerRow.TRACKER_ROW_HEAVY;
// 		END_IF
// 	ELSIF isNXT_INTmotorThirdLegRemote() THEN
// 		SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := 40;
// // 		SCREW_PARAMETERS_CURRENT.MOTOR_TYPE := 2; // TODO add EARTH TRUSS 2.0 to enum in TD3-1 Framework
// 	ELSIF isNXTmotorTrussLatched() THEN // variable truss geometry
// 		SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := pNVM4^.HMI_REALS[NXT_VAR_3L_ANGLE];
// 	ELSE
// 		SCREW_PARAMETERS_CURRENT.THIRD_LEG_VERT_ANGLE := 0;
// 	END_IF
	// ^^^^^^ old version ^^^^^
	
	// embedment parameters
	SCREW_PARAMETERS_CURRENT.IE_MIN_EMBED := pNVM3^.EMBED_REDUCTION_MINIMUM;
	SCREW_PARAMETERS_CURRENT.IE_MIN_HAMMER := pNVM3^.EMBED_REDUCTION_DISTANCE;
	
	
END_IF

(*
// if not using remote:
CASE TO_INT(SCREW_PARAMETERS_CURRENT.TRUSS_TYPE) OF
	eTrussType.TRUSS_TYPE_NORMAL: 
		TRUSS_TYPE_LATCH := eTrussType.TRUSS_TYPE_NORMAL;
	eTrussType.TRUSS_TYPE_CENTER_STRUCTURE: 
		TRUSS_TYPE_LATCH := eTrussType.TRUSS_TYPE_CENTER_STRUCTURE;
	eTrussType.TRUSS_TYPE_END: 
		TRUSS_TYPE_LATCH := eTrussType.TRUSS_TYPE_END;
// determined by remote
	3: TRUSS_TYPE_LATCH := getTrussType();
END_CASE
*)
