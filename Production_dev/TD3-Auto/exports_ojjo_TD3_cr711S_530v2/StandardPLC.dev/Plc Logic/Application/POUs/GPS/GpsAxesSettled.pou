
(********************** Declaration ****************************)
FUNCTION GpsAxesSettled : BOOL
VAR_INPUT
	SETTLED_TYPE: USINT; // 0 for Trapezoid, 1 for Feedback/magnitude = 0
END_VAR
VAR
	i : USINT := 0;
END_VAR

(********************** Implementation ****************************)
CASE SETTLED_TYPE OF
	0: 
		GpsAxesSettled := 
		AXES[GPS_AXES[GPS_HEADING].ACTUATOR_AXIS].LOOP_PID.SETTLED AND
		AXES[GPS_AXES[GPS_X].ACTUATOR_AXIS].LOOP_PID.SETTLED AND
		AXES[GPS_AXES[GPS_Y].ACTUATOR_AXIS].LOOP_PID.SETTLED AND
		AXES[GPS_AXES[GPS_Z].ACTUATOR_AXIS].LOOP_PID.SETTLED;
	1: 
		GpsAxesSettled := 
		AXES[GPS_AXES[GPS_HEADING].ACTUATOR_AXIS].OUTPUT.MAGNITUDE = 0 AND
		AXES[GPS_AXES[GPS_X].ACTUATOR_AXIS].OUTPUT.MAGNITUDE = 0 AND
		AXES[GPS_AXES[GPS_Y].ACTUATOR_AXIS].OUTPUT.MAGNITUDE = 0 AND
		AXES[GPS_AXES[GPS_Z].ACTUATOR_AXIS].OUTPUT.MAGNITUDE = 0;
END_CASE


