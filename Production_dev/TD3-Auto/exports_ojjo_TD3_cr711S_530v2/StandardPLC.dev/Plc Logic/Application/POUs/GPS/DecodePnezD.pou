
(********************** Declaration ****************************)
FUNCTION DecodePnezD : BOOL
VAR_INPUT
END_VAR
VAR
	CODE_START: INT := 0;
	PARAMETERS: ARRAY [1..3] OF STRING(2);
	// Truss codes must be in correct order to correlate to switch positions [0,0,1,1,2,2]
	TRUSS_CODES_FME: ARRAY [0..3, 1..2] OF STRING(1) := ['f','F','m','M','e','E','r','R']; // use this after Jesse updaes codes
	TRUSS_CODES_ICE: ARRAY [0..3, 1..2] OF STRING(1) := ['i','I','c','C','e','E','r','R'];  
	
  
	letter_index : USINT := 1;
	case_index: USINT := 0;
END_VAR

(********************** Implementation ****************************)
DecodePnezD := TRUE; 
// Find the J_code
CODE_START := FIND(GPS_PNEZD_D,'J+') + FIND(GPS_PNEZD_D,'J-');
IF (CODE_START = 0) THEN
	DecodePnezD := FALSE; // did not find a valid code
	RETURN;
ELSE
	DecodePnezD := FALSE;
	FOR letter_index := 0 TO 3 DO
		FOR case_index := 1 TO 2 DO
			IF (MID(GPS_PNEZD_D, 1, CODE_START + 18) = TRUSS_CODES_FME[letter_index, case_index]) OR
				(MID(GPS_PNEZD_D, 1, CODE_START + 18) = TRUSS_CODES_ICE[letter_index, case_index]) THEN 
				DecodePnezD := TRUE;
				//SCREW_PARAMS_PNEZD.TRUSS_TYPE := TO_USINT(letter_index);
				SCREW_PARAMETERS_PNEZD.TRUSS_TYPE := TO_UINT(letter_index);(*
				CASE TO_INT(SCREW_PARAMETERS_PNEZD.TRUSS_TYPE) OF
					0: SCREW_PARAMETERS_PNEZD.TRUSS_TYPE := TO_UINT(getTrussType());
					1: SCREW_PARAMETERS_PNEZD.TRUSS_TYPE := TO_UINT(FILL_TRUSS);
					2: SCREW_PARAMETERS_PNEZD.TRUSS_TYPE := TO_UINT(MOTOR_TRUSS);
					3: SCREW_PARAMETERS_PNEZD.TRUSS_TYPE := TO_UINT(END_TRUSS);
				END_CASE *)
				
			END_IF
		END_FOR
	END_FOR
	IF DecodePnezD = FALSE THEN
		RETURN;
	END_IF
END_IF
	
CODE_START := CODE_START + 2;
// pull out the parameters
//SCREW_PARAMETERS[NS_PITCH] := STRING_TO_REAL(MID(GPS_PNEZD_D, 3, CODE_START));
SCREW_PARAMETERS_PNEZD.NS_PITCH := STRING_TO_REAL(MID(GPS_PNEZD_D, 2, CODE_START))/10.0;
CODE_START := CODE_START + 2;
// read sign
IF FIND(GPS_PNEZD_D,'J-') <> 0 THEN
	SCREW_PARAMETERS_PNEZD.NS_PITCH := - SCREW_PARAMETERS_PNEZD.NS_PITCH;
END_IF

//SCREW_PARAMETERS[SCREW_LENGTH] := STRING_TO_REAL(MID(GPS_PNEZD_D, 3, CODE_START));
SCREW_PARAMETERS_PNEZD.SCREW_LENGTH := STRING_TO_UINT(MID(GPS_PNEZD_D, 3, CODE_START));
CODE_START := CODE_START + 3;
//SCREW_PARAMETERS[TRUSS_VERT_ANGLE] := STRING_TO_REAL(MID(GPS_PNEZD_D, 2, CODE_START));
SCREW_PARAMETERS_PNEZD.TRUSS_SIDE_LEG_ANGLE := STRING_TO_USINT(MID(GPS_PNEZD_D, 2, CODE_START));
CODE_START := CODE_START + 2;
IF MID(GPS_PNEZD_D, 2, CODE_START) = 'ZZ' OR MID(GPS_PNEZD_D, 2, CODE_START) = 'zz' THEN
	//SCREW_PARAMETERS[THIRD_LEG_VERT_ANGLE] := NA;
	SCREW_PARAMETERS_PNEZD.THIRD_LEG_VERT_ANGLE := TO_USINT(NA);
ELSE
	//SCREW_PARAMETERS[THIRD_LEG_VERT_ANGLE] := STRING_TO_REAL(MID(GPS_PNEZD_D, 2, CODE_START));
	SCREW_PARAMETERS_PNEZD.THIRD_LEG_VERT_ANGLE := STRING_TO_USINT(MID(GPS_PNEZD_D, 2, CODE_START));
END_IF
CODE_START := CODE_START + 2;
//SCREW_PARAMETERS[EMBED_LENGTH] := STRING_TO_REAL(MID(GPS_PNEZD_D, 3, CODE_START));
SCREW_PARAMETERS_PNEZD.EMBED_LENGTH := STRING_TO_USINT(MID(GPS_PNEZD_D, 3, CODE_START));
CODE_START := CODE_START + 3;
IF MID(GPS_PNEZD_D, 2, CODE_START) = 'ZZ' OR MID(GPS_PNEZD_D, 2, CODE_START) = 'zz' OR
	MID(GPS_PNEZD_D, 2, CODE_START) = 'Zz' OR MID(GPS_PNEZD_D, 2, CODE_START) = 'zZ' THEN
//	SCREW_PARAMETERS[IE_MIN_HAMMER] := NA;
	SCREW_PARAMETERS_PNEZD.IE_MIN_HAMMER := TO_USINT(NA);
ELSE
//	SCREW_PARAMETERS[IE_MIN_HAMMER] := STRING_TO_REAL(MID(GPS_PNEZD_D, 2, CODE_START));
	SCREW_PARAMETERS_PNEZD.IE_MIN_HAMMER := STRING_TO_USINT(MID(GPS_PNEZD_D, 2, CODE_START));
END_IF
CODE_START := CODE_START + 2;

IF MID(GPS_PNEZD_D, 2, CODE_START) = 'ZZ' OR MID(GPS_PNEZD_D, 2, CODE_START) = 'zz' OR
	MID(GPS_PNEZD_D, 2, CODE_START) = 'Zz' OR MID(GPS_PNEZD_D, 2, CODE_START) = 'zZ' THEN
//	SCREW_PARAMETERS[IE_MIN_EMBED] := NA;
	SCREW_PARAMETERS_PNEZD.IE_MIN_EMBED := TO_USINT(NA);
ELSE
	//SCREW_PARAMETERS[IE_MIN_EMBED] := STRING_TO_REAL(MID(GPS_PNEZD_D, 2, CODE_START));
	SCREW_PARAMETERS_PNEZD.IE_MIN_EMBED := STRING_TO_USINT(MID(GPS_PNEZD_D, 2, CODE_START));
END_IF
CODE_START := CODE_START + 2;

SCREW_PARAMETERS_D_VALID := DecodePnezD; 