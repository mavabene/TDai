
(********************** Declaration ****************************)
(*
	Determine whether gps targeting is in range per range setpoints on HMI.  Actual range is greater.
*)
FUNCTION GpsTargetInRangeIndicationHighWP : BOOL
VAR_INPUT
END_VAR
VAR
	i: INT := 0;
END_VAR

(********************** Implementation ****************************)

GpsTargetInRangeIndicationHighWP := GPS_READY;
FOR i := 1 TO (NUM_GPS_AXES - 1) DO
	IF NOT GPS_INDICATE_AXIS_IN_RANGE[i] THEN
		GpsTargetInRangeIndicationHighWP := FALSE;
	END_IF
END_FOR
