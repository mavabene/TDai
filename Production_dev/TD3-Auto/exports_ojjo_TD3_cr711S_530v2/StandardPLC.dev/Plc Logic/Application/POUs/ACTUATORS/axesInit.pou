		MANUAL_OUTPUT_AT_HARDSTOP := 0,
		MANUAL_OUTPUT_MAX := 0,
		POS_FOLLOW_BAND := 0,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

(* Boom lifting *)
	AXES[AXIS_BOOM_LIFT].CONFIG.P_UNIT_NAME := 'Degrees';
	AXES[AXIS_BOOM_LIFT].CONFIG.V_UNIT_NAME := 'Degrees/sec';
	AXES[AXIS_BOOM_LIFT].CONFIG.A_UNIT_NAME := 'Degrees/sec^2';
	
	IF pNVM4^.HMI_SINTS[BOOM_LIFT_ENCODER_TYPE] = 1 THEN // Siko WV5800
		// Cts/rev of encoder is 16384, double the nominal.
		R_P_E := 2 * (8192.0 / 360.0);
		R_AT := 2 * 8192;
	ELSE // IFM RM7012
		// Cts/rev of the encoder is 8192, this is the nominal.
		R_P_E := 8192.0 / 360.0;
		R_AT := 8192;
	END_IF

	AXES[AXIS_BOOM_LIFT].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_BOOM_LIFT].FEEDBACK),
		RAW_PER_ENGR := R_P_E,
		RAW_WHEN_ENGR_ZERO := pNVM3^.BOOM_LIFT_ENCODER_AT_ZERO,
		FB_VALID_MAX := 31,
		FB_VALID_MIN := -19,
		ROLLOVER_AT := R_AT);

	HaweVpocInit(ADR(AXES[AXIS_BOOM_LIFT].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_BOOM_LIFT), ADR(DSW_BOOM_LIFT), ADR(VPOC_BOOM_LIFT), TRUE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_BOOM_LIFT].CONFIG),
		FB := AXES[AXIS_BOOM_LIFT].FEEDBACK,
		SPEED_PLUS_MAX := 2.5,
		SPEED_MINUS_MAX := 3.5,
		COMMAND_LIMIT_MAX := 30,
		COMMAND_LIMIT_MIN := -18,
		CYCLE_PLUS := 25,
		CYCLE_MINUS := 0,
		CYCLE_VEL := 1,
		CYCLE_ACCEL := 2,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 5,
		MANUAL_OUTPUT_AT_HARDSTOP := 250,
		MANUAL_OUTPUT_MAX := 1000,
		POS_FOLLOW_BAND := 0,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

	LoopPIDInit(pLOOPPI := ADR(AXES[AXIS_BOOM_LIFT].LOOP_PID),
		CFG := AXES[AXIS_BOOM_LIFT].CONFIG,
		SETTLED_BAND := 0.25,
		KP := 60,
		KI := 2,
		INTEGRATOR_MAX := 500,
		KD := 0);

(* Joint lifting *)
	AXES[AXIS_JOINT_LIFT].CONFIG.P_UNIT_NAME := 'Degrees';
	AXES[AXIS_JOINT_LIFT].CONFIG.V_UNIT_NAME := 'Degrees/sec';
	AXES[AXIS_JOINT_LIFT].CONFIG.A_UNIT_NAME := 'Degrees/sec^2';
	
	IF pNVM4^.HMI_SINTS[JOINT_LIFT_ENCODER_TYPE] = 1 THEN // Siko WV5800
		// Cts/rev of encoder is 16384, double the nominal.
		R_P_E := 2 * (8192.0 / 360.0);
		R_AT := 2 * 8192;
	ELSE // IFM RM7012
		// Cts/rev of the encoder is 8192, this is the nominal.
		R_P_E := 8192.0 / 360.0;
		R_AT := 8192;
	END_IF

	AXES[AXIS_JOINT_LIFT].FEEDBACK.INSTALLED := TRUE;
