		KD := 0);

(* Pendulum *)
	AXES[AXIS_PENDULUM].CONFIG.P_UNIT_NAME := 'Revs';
	AXES[AXIS_PENDULUM].CONFIG.V_UNIT_NAME := 'Revs/sec';
	AXES[AXIS_PENDULUM].CONFIG.A_UNIT_NAME := 'Revs/sec^2';

	AXES[AXIS_PENDULUM].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_PENDULUM].FEEDBACK),
