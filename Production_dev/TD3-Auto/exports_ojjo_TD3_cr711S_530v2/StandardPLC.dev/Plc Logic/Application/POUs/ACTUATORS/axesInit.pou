		COMMAND_LIMIT_MIN := 0,
		CYCLE_PLUS := 0,
		CYCLE_MINUS := 0,
		CYCLE_VEL := 0,
		CYCLE_ACCEL := 0,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
