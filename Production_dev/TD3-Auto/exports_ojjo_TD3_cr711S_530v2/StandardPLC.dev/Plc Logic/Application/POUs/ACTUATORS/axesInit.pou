	HaweVpocInit(ADR(AXES[AXIS_CENTRALIZER].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_CENTRALIZER), ADR(DSW_CENTRALIZER), ADR(VPOC_CENTRALIZER), TRUE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_CENTRALIZER].CONFIG),
		FB := AXES[AXIS_CENTRALIZER].FEEDBACK,
		SPEED_PLUS_MAX := 0.0,
		SPEED_MINUS_MAX := 0.0,
		COMMAND_LIMIT_MAX := 0,
		COMMAND_LIMIT_MIN := 0,
		CYCLE_PLUS := 0,
		CYCLE_MINUS := 0,
		CYCLE_VEL := 0,
		CYCLE_ACCEL := 0,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 0,
		MANUAL_OUTPUT_AT_HARDSTOP := 0,
		MANUAL_OUTPUT_MAX := 0,
		POS_FOLLOW_BAND := 0,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

(* Left crimper *)
	AXES[AXIS_LEFT_CRIMPER].CONFIG.P_UNIT_NAME := 'Revs';
	AXES[AXIS_LEFT_CRIMPER].CONFIG.V_UNIT_NAME := 'Revs/sec';
	AXES[AXIS_LEFT_CRIMPER].CONFIG.A_UNIT_NAME := 'Revs/sec^2';

	AXES[AXIS_LEFT_CRIMPER].FEEDBACK.INSTALLED := FALSE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_LEFT_CRIMPER].FEEDBACK),
		RAW_PER_ENGR := 2.5 * 1024.0,
		RAW_WHEN_ENGR_ZERO := 0,
		FB_VALID_MAX := 100,
		FB_VALID_MIN := -100,
		ROLLOVER_AT := 0);

	HaweVpocInit(ADR(AXES[AXIS_LEFT_CRIMPER].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_LEFT_CRIMPER), ADR(DSW_LEFT_CRIMPER), ADR(VPOC_LEFT_CRIMPER), FALSE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_LEFT_CRIMPER].CONFIG),
		FB := AXES[AXIS_LEFT_CRIMPER].FEEDBACK,
		SPEED_PLUS_MAX := 0.0,
		SPEED_MINUS_MAX := 0.0,
		COMMAND_LIMIT_MAX := 0,
		COMMAND_LIMIT_MIN := 0,
		CYCLE_PLUS := 0,
		CYCLE_MINUS := 0,
		CYCLE_VEL := 0,
		CYCLE_ACCEL := 0,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 0,
		MANUAL_OUTPUT_AT_HARDSTOP := 0,
		MANUAL_OUTPUT_MAX := 0,
		POS_FOLLOW_BAND := 0,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

(* Right crimper *)
	AXES[AXIS_RIGHT_CRIMPER].CONFIG.P_UNIT_NAME := 'Revs';
	AXES[AXIS_RIGHT_CRIMPER].CONFIG.V_UNIT_NAME := 'Revs/sec';
	AXES[AXIS_RIGHT_CRIMPER].CONFIG.A_UNIT_NAME := 'Revs/sec^2';

	AXES[AXIS_RIGHT_CRIMPER].FEEDBACK.INSTALLED := FALSE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_RIGHT_CRIMPER].FEEDBACK),
		RAW_PER_ENGR := 2.5 * 1024.0,
		RAW_WHEN_ENGR_ZERO := 0,
		FB_VALID_MAX := 100,
		FB_VALID_MIN := -100,
		ROLLOVER_AT := 0);

	HaweVpocInit(ADR(AXES[AXIS_RIGHT_CRIMPER].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_RIGHT_CRIMPER), ADR(DSW_RIGHT_CRIMPER), ADR(VPOC_RIGHT_CRIMPER), FALSE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_RIGHT_CRIMPER].CONFIG),
		FB := AXES[AXIS_RIGHT_CRIMPER].FEEDBACK,
		SPEED_PLUS_MAX := 0.0,
		SPEED_MINUS_MAX := 0.0,
		COMMAND_LIMIT_MAX := 0,
		COMMAND_LIMIT_MIN := 0,
		CYCLE_PLUS := 0,
		CYCLE_MINUS := 0,
		CYCLE_VEL := 0,
		CYCLE_ACCEL := 0,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 0,
		MANUAL_OUTPUT_AT_HARDSTOP := 0,
		MANUAL_OUTPUT_MAX := 0,
		POS_FOLLOW_BAND := 0,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

(* Target plate *)
	AXES[AXIS_TARGET_PLATE].CONFIG.P_UNIT_NAME := 'Revs';
	AXES[AXIS_TARGET_PLATE].CONFIG.V_UNIT_NAME := 'Revs/sec';
	AXES[AXIS_TARGET_PLATE].CONFIG.A_UNIT_NAME := 'Revs/sec^2';

	AXES[AXIS_TARGET_PLATE].FEEDBACK.INSTALLED := FALSE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_TARGET_PLATE].FEEDBACK),
		RAW_PER_ENGR := 2.5 * 1024.0,
		RAW_WHEN_ENGR_ZERO := 0,
		FB_VALID_MAX := 100,
		FB_VALID_MIN := -100,
		ROLLOVER_AT := 0);

	IF  pNVM3^.MACHINE_VERSION >= 1 THEN
		HaweVpocInit(ADR(AXES[AXIS_TARGET_PLATE].CONFIG.HAWE_VPOC), USED := TRUE,
			ADR(DCW_MAST_SLIDE), ADR(DSW_MAST_SLIDE), ADR(VPOC_MAST_SLIDE), FALSE);
	ELSE
		HaweVpocInit(ADR(AXES[AXIS_TARGET_PLATE].CONFIG.HAWE_VPOC), USED := TRUE,
			ADR(DCW_TARGET_PLATE), ADR(DSW_TARGET_PLATE), ADR(VPOC_TARGET_PLATE), FALSE);
	END_IF

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_TARGET_PLATE].CONFIG),
		FB := AXES[AXIS_TARGET_PLATE].FEEDBACK,
		SPEED_PLUS_MAX := 0.0,
		SPEED_MINUS_MAX := 0.0,
		COMMAND_LIMIT_MAX := 0,
		COMMAND_LIMIT_MIN := 0,
		CYCLE_PLUS := 0,
		CYCLE_MINUS := 0,
		CYCLE_VEL := 0,
		CYCLE_ACCEL := 0,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 0,
		MANUAL_OUTPUT_AT_HARDSTOP := 0,
		MANUAL_OUTPUT_MAX := 0,
		POS_FOLLOW_BAND := 0,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

(* Water pump *)
	AXES[AXIS_WATER].CONFIG.P_UNIT_NAME := 'Revs';
	AXES[AXIS_WATER].CONFIG.V_UNIT_NAME := 'Revs/sec';
	AXES[AXIS_WATER].CONFIG.A_UNIT_NAME := 'Revs/sec^2';

	AXES[AXIS_WATER].FEEDBACK.INSTALLED := FALSE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_TARGET_PLATE].FEEDBACK),
		RAW_PER_ENGR := 2.5 * 1024.0,
		RAW_WHEN_ENGR_ZERO := 0,
		FB_VALID_MAX := 100,
		FB_VALID_MIN := -100,
		ROLLOVER_AT := 0);

	IF pNVM3^.MACHINE_VERSION >= 1 THEN
		HaweVpocInit(ADR(AXES[AXIS_WATER].CONFIG.HAWE_VPOC), USED := TRUE,
			ADR(DCW_WATER_PUMP), ADR(DSW_WATER_PUMP), ADR(VPOC_WATER_PUMP), FALSE);
	ELSE
		HaweVpocInit(ADR(AXES[AXIS_WATER].CONFIG.HAWE_VPOC), USED := FALSE,
			ADR(DCW_WATER_PUMP), ADR(DSW_WATER_PUMP), ADR(VPOC_WATER_PUMP), FALSE);
	END_IF
	
	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_WATER].CONFIG),
		FB := AXES[AXIS_WATER].FEEDBACK,
		SPEED_PLUS_MAX := 0.0,
		SPEED_MINUS_MAX := 0.0,
		COMMAND_LIMIT_MAX := 0,
		COMMAND_LIMIT_MIN := 0,
		CYCLE_PLUS := 0,
		CYCLE_MINUS := 0,
		CYCLE_VEL := 0,
		CYCLE_ACCEL := 0,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 0,
		MANUAL_OUTPUT_AT_HARDSTOP := 0,
		MANUAL_OUTPUT_MAX := 0,
		POS_FOLLOW_BAND := 0,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);
		
	IF pNVM3^.MACHINE_VERSION >= 1 THEN
		// Clearances on lots of bearings are tighter on this machine to reduce compliance.  This reduces top speeds
		//	of many actuators, requiring changes to configurations, especially those related to open loop behavior
		//	(e.g. feedforwards, manual operation speeds).
		ConfigVFFInit(ADR(AXES[AXIS_MAST_SLIDE].CONFIG), AXES[AXIS_MAST_SLIDE].FEEDBACK, SPEED_PLUS_MAX := 35, SPEED_MINUS_MAX := 30); 
		ConfigVFFInit(ADR(AXES[AXIS_X_SLIDE].CONFIG), AXES[AXIS_X_SLIDE].FEEDBACK, SPEED_PLUS_MAX := 12, SPEED_MINUS_MAX := 6);
		ConfigVFFInit(ADR(AXES[AXIS_BOOM_LIFT].CONFIG), AXES[AXIS_BOOM_LIFT].FEEDBACK, SPEED_PLUS_MAX := 1.5, SPEED_MINUS_MAX := 3);
		ConfigVFFInit(ADR(AXES[AXIS_BOOM_SWING].CONFIG), AXES[AXIS_BOOM_SWING].FEEDBACK, SPEED_PLUS_MAX := 16, SPEED_MINUS_MAX := 6);
		ConfigVFFInit(ADR(AXES[AXIS_ROTATOR].CONFIG), AXES[AXIS_ROTATOR].FEEDBACK, SPEED_PLUS_MAX := 10, SPEED_MINUS_MAX := 10);
		// ConfigVFFInit(ADR(AXES[AXIS_Z_SLIDE].CONFIG), ADR(AXES[AXIS_Z_SLIDE].FEEDBACK), SPEED_PLUS_MAX := , SPEED_MINUS_MAX := );
	END_IF
END_IF