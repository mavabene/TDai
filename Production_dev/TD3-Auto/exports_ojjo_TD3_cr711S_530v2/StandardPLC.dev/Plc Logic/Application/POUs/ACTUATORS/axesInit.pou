	AXES[AXIS_CENTRALIZER].CONFIG.V_UNIT_NAME := 'Revs/sec';
	AXES[AXIS_CENTRALIZER].CONFIG.A_UNIT_NAME := 'Revs/sec^2';

	AXES[AXIS_CENTRALIZER].FEEDBACK.INSTALLED := FALSE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_CENTRALIZER].FEEDBACK),
		RAW_PER_ENGR := 2.5 * 1024.0,
		RAW_WHEN_ENGR_ZERO := 0,
