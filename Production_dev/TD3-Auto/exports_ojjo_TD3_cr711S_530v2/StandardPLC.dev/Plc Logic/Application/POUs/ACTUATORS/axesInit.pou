
(********************** Declaration ****************************)
FUNCTION axesInit : BOOL
VAR_INPUT
	INIT: BOOL;
END_VAR
VAR
	AX : sAxis;
	pFB : POINTER TO sFeedback;
	PWM_CHAN : WORD := 0;

	R_P_E: REAL;
	R_AT: DINT;
	
	OUTMAX: UINT;	
	PGAIN: REAL;
	IGAIN: REAL;
END_VAR
(********************** Implementation ****************************)
(* Initialization of all axes should come here!! *)
IF INIT THEN

	// Set addresses before application code can use the valve table.
	CAN_VALVES[1]  := ADR(BOOM_SWING_VALVE);
	CAN_VALVES[2]  := ADR(X_SLIDE_VALVE);
	CAN_VALVES[3]  := ADR(YAW_VALVE);
	CAN_VALVES[4]  := ADR(PITCH_VALVE);
	CAN_VALVES[5]  := ADR(Z_SLIDE_VALVE);
	CAN_VALVES[6]  := ADR(ROTATOR_VALVE);
	CAN_VALVES[7]  := ADR(MAST_SLIDE_VALVE);
	CAN_VALVES[8]  := ADR(LOWER_CROWD_VALVE);
	CAN_VALVES[9]  := ADR(LOWER_ROTARY_VALVE);
	CAN_VALVES[10] := ADR(UPPER_CROWD_VALVE);
	CAN_VALVES[11] := ADR(UPPER_ROTARY_VALVE);
	CAN_VALVES[12] := ADR(LEFT_TRACK_VALVE);
	CAN_VALVES[13] := ADR(RIGHT_TRACK_VALVE);
	CAN_VALVES[14] := ADR(BOOM_LIFT_VALVE);
	CAN_VALVES[15] := ADR(JOINT_LIFT_VALVE);
	CAN_VALVES[16] := ADR(PENDULUM_VALVE);
	CAN_VALVES[17] := ADR(HAMMER_VALVE);
	CAN_VALVES[18] := ADR(OUTRIGGER_VALVE);
	CAN_VALVES[19] := ADR(CENTRALIZER_VALVE);
	CAN_VALVES[20] := ADR(LEFT_CRIMPER_VALVE);
	CAN_VALVES[21] := ADR(RIGHT_CRIMPER_VALVE);
	CAN_VALVES[22] := ADR(TARGET_PLATE_VALVE);

	(* Boom swing. *)
	// 	+: CCW (swing towards right from operator position at rear)
	AXES[AXIS_BOOM_SWING].CONFIG.P_UNIT_NAME := 'Degrees';
	AXES[AXIS_BOOM_SWING].CONFIG.V_UNIT_NAME := 'Degrees/sec';
	AXES[AXIS_BOOM_SWING].CONFIG.A_UNIT_NAME := 'Degrees/sec^2';
	
	IF pNVM4^.HMI_SINTS[BOOM_SWING_ENCODER_TYPE] = 1 THEN // Siko WV5800
		// Cts/rev of encoder is 16384, double the nominal.
		R_P_E := 2 * (8192.0 / 360.0);
		R_AT := 2 * 8192;
	ELSE // IFM RM7012
		// Cts/rev of the encoder is 8192, this is the nominal.
		R_P_E := 8192.0 / 360.0;
		R_AT := 8192;
	END_IF

	AXES[AXIS_BOOM_SWING].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_BOOM_SWING].FEEDBACK),
		RAW_PER_ENGR := R_P_E,
		RAW_WHEN_ENGR_ZERO := pNVM1^.BOOM_SWING_ENCODER_AT_ZERO,
		FB_VALID_MAX := 27,
		FB_VALID_MIN := -27,
		ROLLOVER_AT := R_AT);

	HaweVpocInit(ADR(AXES[AXIS_BOOM_SWING].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_BOOM_SWING), ADR(DSW_BOOM_SWING), ADR(VPOC_BOOM_SWING), FALSE);

	IF pNVM3^.MACHINE_VERSION = 0 THEN
		PGAIN := 40;
		IGAIN := 10;
	ELSE
		PGAIN := 100;
		IGAIN := 15;
	END_IF
	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_BOOM_SWING].CONFIG),
		FB := AXES[AXIS_BOOM_SWING].FEEDBACK,
		SPEED_PLUS_MAX := 8.0,
		SPEED_MINUS_MAX := 8.0,
		COMMAND_LIMIT_MAX := 27,
		COMMAND_LIMIT_MIN := -27,
		CYCLE_PLUS := 20,
		CYCLE_MINUS := -20,
		CYCLE_VEL := BOOM_SWING_VEL,
		CYCLE_ACCEL := BOOM_SWING_ACCEL,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 5,
		MANUAL_OUTPUT_AT_HARDSTOP := 200,
		MANUAL_OUTPUT_MAX := 667,
		POS_FOLLOW_BAND := 50,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := FALSE);

	LoopPIDInit(pLOOPPI := ADR(AXES[AXIS_BOOM_SWING].LOOP_PID),
		CFG := AXES[AXIS_BOOM_SWING].CONFIG,
		SETTLED_BAND := 0.2,
		KP := PGAIN,
		KI := IGAIN,
		INTEGRATOR_MAX := 1000,
		KD := 0);

	(* Xslide. going toward rear of machine is positive *)
	AXES[AXIS_X_SLIDE].CONFIG.P_UNIT_NAME := 'cm';
	AXES[AXIS_X_SLIDE].CONFIG.V_UNIT_NAME := 'cm/sec';
	AXES[AXIS_X_SLIDE].CONFIG.A_UNIT_NAME := 'cm/sec^2';

	AXES[AXIS_X_SLIDE].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_X_SLIDE].FEEDBACK),
		RAW_PER_ENGR := 100.0,
		RAW_WHEN_ENGR_ZERO := pNVM1^.X_SLIDE_ENCODER_AT_ZERO,
		FB_VALID_MAX := 31,
		FB_VALID_MIN := -1,
		ROLLOVER_AT := 0);

	HaweVpocInit(ADR(AXES[AXIS_X_SLIDE].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_X_SLIDE), ADR(DSW_X_SLIDE), ADR(VPOC_X_SLIDE), TRUE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_X_SLIDE].CONFIG),
		FB := AXES[AXIS_X_SLIDE].FEEDBACK,
		SPEED_PLUS_MAX := 14.0,
		SPEED_MINUS_MAX := 10.0,
		COMMAND_LIMIT_MAX := 30,
		COMMAND_LIMIT_MIN := 0,
		CYCLE_PLUS := 25,
		CYCLE_MINUS := 5,
		CYCLE_VEL := X_SLIDE_VEL,
		CYCLE_ACCEL := X_SLIDE_ACCEL,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 10,
		MANUAL_OUTPUT_AT_HARDSTOP := 100,
		MANUAL_OUTPUT_MAX := 667,
		POS_FOLLOW_BAND := 50,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := FALSE);

	LoopPIDInit(pLOOPPI := ADR(AXES[AXIS_X_SLIDE].LOOP_PID),
		CFG := AXES[AXIS_X_SLIDE].CONFIG,
		SETTLED_BAND := 0.2,
		KP := 5,
		KI := 2,
		INTEGRATOR_MAX := 200,
		KD := 0);

	(* Yaw *)
	// 	+: CW (swing towards left from operator position at rear)
	AXES[AXIS_YAW].CONFIG.P_UNIT_NAME := 'Degrees';
	AXES[AXIS_YAW].CONFIG.V_UNIT_NAME := 'Degrees/sec';
	AXES[AXIS_YAW].CONFIG.A_UNIT_NAME := 'Degrees/sec^2';
	
	IF pNVM4^.HMI_SINTS[YAW_ENCODER_TYPE] = 1 THEN // Siko WV5800
		// Cts/rev of encoder is 16384, double the nominal.
		R_P_E := 2 * (8192.0 / 360.0);
		R_AT := 2 * 8192;
	ELSE // IFM RM7012
		// Cts/rev of the encoder is 8192, this is the nominal.
		R_P_E := 8192.0 / 360.0;
		R_AT := 8192;
	END_IF

	AXES[AXIS_YAW].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_YAW].FEEDBACK),
		RAW_PER_ENGR := R_P_E,
		RAW_WHEN_ENGR_ZERO := pNVM1^.YAW_ENCODER_AT_ZERO,
		FB_VALID_MAX := 30,
		FB_VALID_MIN := -30,
		ROLLOVER_AT := R_AT);

	HaweVpocInit(ADR(AXES[AXIS_YAW].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_YAW), ADR(DSW_YAW), ADR(VPOC_YAW), FALSE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_YAW].CONFIG),
		FB := AXES[AXIS_YAW].FEEDBACK,
		SPEED_PLUS_MAX := 6.5,
		SPEED_MINUS_MAX := 6.5,
		COMMAND_LIMIT_MAX := 29,
		COMMAND_LIMIT_MIN := -29,
		CYCLE_PLUS := 25,
		CYCLE_MINUS := -25,
		CYCLE_VEL := YAW_VEL,
		CYCLE_ACCEL := YAW_ACCEL,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 4,
		MANUAL_OUTPUT_AT_HARDSTOP := 200,
		MANUAL_OUTPUT_MAX := 1000,
		POS_FOLLOW_BAND := 500,
		CYL_GAIN_RATIO := 1,
		CYL_EXT_POSITIVE := FALSE);

	LoopPIDInit(pLOOPPI := ADR(AXES[AXIS_YAW].LOOP_PID),
		CFG := AXES[AXIS_YAW].CONFIG,
		(* THIS SETTING HERE IS NOT USED, WE SET THIS DIFFERENTLY IN DIFFERENT STATES IN THE ACTUATOR CODE. *)
		SETTLED_BAND := 0.2,
		KP := 50,
		KI := 10,
		// Changed from 500 to 1000 for YP tight settling on NXT 3LM.
		INTEGRATOR_MAX := 1000,
		KD := 0);

	(* Pitch *)
	// 0 deg is vertical
	AXES[AXIS_PITCH].CONFIG.P_UNIT_NAME := 'Degrees';
	AXES[AXIS_PITCH].CONFIG.V_UNIT_NAME := 'Degrees/sec';
	AXES[AXIS_PITCH].CONFIG.A_UNIT_NAME := 'Degrees/sec^2';

	AXES[AXIS_PITCH].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_PITCH].FEEDBACK),
		RAW_PER_ENGR := 1000.0,
		RAW_WHEN_ENGR_ZERO := 0,
		FB_VALID_MAX := 103.0,
		FB_VALID_MIN := -20.0,
		ROLLOVER_AT := 0);

	HaweVpocInit(ADR(AXES[AXIS_PITCH].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_PITCH), ADR(DSW_PITCH), ADR(VPOC_PITCH), FALSE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_PITCH].CONFIG),
		FB := AXES[AXIS_PITCH].FEEDBACK,
		SPEED_PLUS_MAX := 15.0,
		SPEED_MINUS_MAX := 20.0,
		COMMAND_LIMIT_MAX := 80,
		COMMAND_LIMIT_MIN := -6,
		CYCLE_PLUS := 20,
		CYCLE_MINUS := -6,
		CYCLE_VEL := PITCH_VEL,
		CYCLE_ACCEL := PITCH_ACCEL,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 10,
		MANUAL_OUTPUT_AT_HARDSTOP := 200,
		MANUAL_OUTPUT_MAX := 600,
		POS_FOLLOW_BAND := 500,
		CYL_GAIN_RATIO := 1,
		CYL_EXT_POSITIVE := FALSE);

	LoopPIDInit(pLOOPPI := ADR(AXES[AXIS_PITCH].LOOP_PID),
		CFG := AXES[AXIS_PITCH].CONFIG,
		SETTLED_BAND := 0.2,
		KP := 1.0,
		KI := 0.1,
		INTEGRATOR_MAX := 30,
		KD := 0);

(* Z-slide : 58" of travel, or 147.3 cm. Going up is positive *)
	AXES[AXIS_Z_SLIDE].CONFIG.P_UNIT_NAME := 'CM';
	AXES[AXIS_Z_SLIDE].CONFIG.V_UNIT_NAME := 'CM/sec';
	AXES[AXIS_Z_SLIDE].CONFIG.A_UNIT_NAME := 'CM/sec^2';

	AXES[AXIS_Z_SLIDE].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_Z_SLIDE].FEEDBACK),
		RAW_PER_ENGR := 100.0,
		RAW_WHEN_ENGR_ZERO := pNVM1^.Z_SLIDE_ENCODER_AT_ZERO,
		FB_VALID_MAX := 167.5 + 1,
		FB_VALID_MIN := 0 - 1,
		ROLLOVER_AT := 0);

	IF pNVM3^.MACHINE_VERSION >= 1 THEN
		HaweVpocInit(ADR(AXES[AXIS_Z_SLIDE].CONFIG.HAWE_VPOC), USED := TRUE,
			ADR(DCW_TARGET_PLATE), ADR(DSW_TARGET_PLATE), ADR(VPOC_TARGET_PLATE), FALSE);
	ELSE
		HaweVpocInit(ADR(AXES[AXIS_Z_SLIDE].CONFIG.HAWE_VPOC), USED := TRUE,
			ADR(DCW_Z_SLIDE), ADR(DSW_Z_SLIDE), ADR(VPOC_Z_SLIDE), FALSE);
	END_IF		

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_Z_SLIDE].CONFIG),
		FB := AXES[AXIS_Z_SLIDE].FEEDBACK,
		SPEED_PLUS_MAX := 30.0,
		SPEED_MINUS_MAX := 40.0,
		COMMAND_LIMIT_MAX := 167.5,
		COMMAND_LIMIT_MIN := 2,
		CYCLE_PLUS := 145,
		CYCLE_MINUS := 50,
		CYCLE_VEL := Z_SLIDE_VEL,
		CYCLE_ACCEL := Z_SLIDE_ACCEL,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 10,
		MANUAL_OUTPUT_AT_HARDSTOP := 100,
		MANUAL_OUTPUT_MAX := 1000,
		POS_FOLLOW_BAND := 100,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

	LoopPIDInit(
		pLOOPPI := ADR(AXES[AXIS_Z_SLIDE].LOOP_PID),
		CFG := AXES[AXIS_Z_SLIDE].CONFIG,
		SETTLED_BAND := 0.2,
		KP := 4.0,
		KI := 1.0,
		INTEGRATOR_MAX := 1000,
		KD := 0);

(* Rotator - top tilting left is positive *)
	AXES[AXIS_ROTATOR].CONFIG.P_UNIT_NAME := 'Degrees';
	AXES[AXIS_ROTATOR].CONFIG.V_UNIT_NAME := 'Deg/sec';
	AXES[AXIS_ROTATOR].CONFIG.A_UNIT_NAME := 'Deg/sec^2';

	AXES[AXIS_ROTATOR].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_ROTATOR].FEEDBACK),
		RAW_PER_ENGR := 1000.0,
		RAW_WHEN_ENGR_ZERO := 0,
		FB_VALID_MAX := 39.0,
		FB_VALID_MIN := -39.0,
		ROLLOVER_AT := 0);
		
	HaweVpocInit(ADR(AXES[AXIS_ROTATOR].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_ROTATOR), ADR(DSW_ROTATOR), ADR(VPOC_ROTATOR), TRUE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_ROTATOR].CONFIG),
		FB := AXES[AXIS_ROTATOR].FEEDBACK,
		SPEED_PLUS_MAX := 11.0,
		SPEED_MINUS_MAX := 11.0,
		COMMAND_LIMIT_MAX := 38.0,
		COMMAND_LIMIT_MIN := -38.0,
		CYCLE_PLUS := 35,
		CYCLE_MINUS := -35,
		CYCLE_VEL := ROTATOR_VEL,
		CYCLE_ACCEL := ROTATOR_ACCEL,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 25,
		DEADBAND_MINUS := 25,
		MANUAL_HARDSTOP_BAND := 10,
		MANUAL_OUTPUT_AT_HARDSTOP := 75,
		MANUAL_OUTPUT_MAX := 900,
		POS_FOLLOW_BAND := 20,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

	LoopPIDInit(
		pLOOPPI := ADR(AXES[AXIS_ROTATOR].LOOP_PID),
		CFG := AXES[AXIS_ROTATOR].CONFIG,
		SETTLED_BAND := 0.25,
		KP := 0.3,
		KI := 0.4,
		INTEGRATOR_MAX := 50,
		KD := 0);

(* Mast slide going up is positive *)
	AXES[AXIS_MAST_SLIDE].CONFIG.P_UNIT_NAME := 'CM';
	AXES[AXIS_MAST_SLIDE].CONFIG.V_UNIT_NAME := 'CM/sec';
	AXES[AXIS_MAST_SLIDE].CONFIG.A_UNIT_NAME := 'CM/sec^2';

	(* When the encoder is reversed in sign from travel, this will be the smaller number *)
	AXES[AXIS_MAST_SLIDE].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_MAST_SLIDE].FEEDBACK),
		RAW_PER_ENGR := 100.0,
		RAW_WHEN_ENGR_ZERO := pNVM1^.MAST_SLIDE_ENCODER_AT_ZERO,
		FB_VALID_MAX := 197.5 + 1,
		FB_VALID_MIN := 0 - 1,
		ROLLOVER_AT := 0);

	IF pNVM3^.MACHINE_VERSION >= 1 THEN
		HaweVpocInit(ADR(AXES[AXIS_MAST_SLIDE].CONFIG.HAWE_VPOC), USED := TRUE,
			ADR(DCW_Z_SLIDE), ADR(DSW_Z_SLIDE), ADR(VPOC_Z_SLIDE), FALSE);
	ELSE
		HaweVpocInit(ADR(AXES[AXIS_MAST_SLIDE].CONFIG.HAWE_VPOC), USED := TRUE,
			ADR(DCW_MAST_SLIDE), ADR(DSW_MAST_SLIDE), ADR(VPOC_MAST_SLIDE), FALSE);
	END_IF

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_MAST_SLIDE].CONFIG),
		FB := AXES[AXIS_MAST_SLIDE].FEEDBACK,
		SPEED_PLUS_MAX := 14,
		SPEED_MINUS_MAX := 40,
		COMMAND_LIMIT_MAX := 197.5,
		COMMAND_LIMIT_MIN := 0,
		CYCLE_PLUS := 190,
		CYCLE_MINUS := 90,
		CYCLE_VEL := MAST_SLIDE_VEL,
		CYCLE_ACCEL := MAST_SLIDE_ACCEL,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 20,
		MANUAL_OUTPUT_AT_HARDSTOP := 150,
		MANUAL_OUTPUT_MAX := 800,
		POS_FOLLOW_BAND := 100,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

	LoopPIDInit(
		pLOOPPI := ADR(AXES[AXIS_MAST_SLIDE].LOOP_PID),
		CFG := AXES[AXIS_MAST_SLIDE].CONFIG,
		SETTLED_BAND := 0.40,
		KP := 3,
		KI := 1,
		INTEGRATOR_MAX := 200,
		KD := 0);

(* Lower crowd *)
	AXES[AXIS_LOWER_CROWD].CONFIG.P_UNIT_NAME := 'CM';
	AXES[AXIS_LOWER_CROWD].CONFIG.V_UNIT_NAME := 'CM/sec';
	AXES[AXIS_LOWER_CROWD].CONFIG.A_UNIT_NAME := 'CM/sec^2';

	IF pNVM4^.LOWER_CROWD_ENCODER_TYPE = 1 THEN
		// Cts/rev of encoder is 16384, double the nominal.
		R_P_E := 2 * (500 / 2.54);
		R_AT := 67108864;
		// Nominal ratio of LR/LC ratio calculted with nominal LC resolution.
		CTS_LR_PER_CT_LC := CTS_LR_PER_CT_LC / 2;
	ELSE
		// Cts/rev of the encoder is 8192, this is the nominal.
		R_P_E := 500 / 2.54;
		R_AT := 33554432;
	END_IF
	AXES[AXIS_LOWER_CROWD].FEEDBACK.INSTALLED := TRUE;

	IF pNVM1^.LOWER_CROWD_ENCODER_AT_REF < REAL_TO_UDINT(pNVM1^.LOWER_CROWD_MAST_TO_SLIDE_OFFSET * R_P_E) THEN
		pNVM1^.LOWER_CROWD_ENCODER_AT_ZERO := TO_UDINT(R_AT) - (TO_UDINT(pNVM1^.LOWER_CROWD_MAST_TO_SLIDE_OFFSET * R_P_E) - pNVM1^.LOWER_CROWD_ENCODER_AT_REF);
	ELSE
		pNVM1^.LOWER_CROWD_ENCODER_AT_ZERO := TO_UDINT(pNVM1^.LOWER_CROWD_ENCODER_AT_REF - REAL_TO_UDINT(pNVM1^.LOWER_CROWD_MAST_TO_SLIDE_OFFSET * R_P_E));
	END_IF
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_LOWER_CROWD].FEEDBACK),
		RAW_PER_ENGR := R_P_E,
		RAW_WHEN_ENGR_ZERO := pNVM1^.LOWER_CROWD_ENCODER_AT_ZERO,
		FB_VALID_MAX := 489.0,
		FB_VALID_MIN := 25.0,
		ROLLOVER_AT := R_AT);

	HaweVpocInit(ADR(AXES[AXIS_LOWER_CROWD].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_LOWER_CROWD), ADR(DSW_LOWER_CROWD), ADR(VPOC_LOWER_CROWD), TRUE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_LOWER_CROWD].CONFIG),
		FB := AXES[AXIS_LOWER_CROWD].FEEDBACK,
		SPEED_PLUS_MAX := 60,
		SPEED_MINUS_MAX := 30.0,
		COMMAND_LIMIT_MAX := 270,
		//COMMAND_LIMIT_MAX := 280, // pushing it here if there is a 12ft drill rod and 225cm screw we are putting the upper crowd right at the limit when disengaging from the truss cap after crimping and going to track
		COMMAND_LIMIT_MIN := LOWER_CROWD_MIN_END_POS,
		CYCLE_PLUS := 250,
		CYCLE_MINUS := 60,
		CYCLE_VEL := LOWER_CROWD_VEL,
		CYCLE_ACCEL := LOWER_CROWD_ACCEL,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 10,
		MANUAL_OUTPUT_AT_HARDSTOP := 100,
		MANUAL_OUTPUT_MAX := 1000,
		POS_FOLLOW_BAND := 500,
		CYL_GAIN_RATIO := 1,
		CYL_EXT_POSITIVE := FALSE);

	LoopPIDInit(pLOOPPI := ADR(AXES[AXIS_LOWER_CROWD].LOOP_PID),
		CFG := AXES[AXIS_LOWER_CROWD].CONFIG,
		SETTLED_BAND := 0.25,
		KP := 2.0,
		KI := 0.5,
		INTEGRATOR_MAX := 1500,
		KD := 0);;

(* Lower rotary *)
	AXES[AXIS_LOWER_ROTARY].CONFIG.P_UNIT_NAME := 'Revolutions';
	AXES[AXIS_LOWER_ROTARY].CONFIG.V_UNIT_NAME := 'Rev/sec';
	AXES[AXIS_LOWER_ROTARY].CONFIG.A_UNIT_NAME := 'Rev/sec/sec';

	// Check to see if we have a valid encoder resolution.  This needs to be minimum 4096, and cannot be more than 16000.
	IF pNVM4^.LR_ENCODER_RES < 1000 OR pNVM4^.LR_ENCODER_RES > 8192 THEN
		// Choices are:
		//
		//	1) RB3500: 4096 cts/rev
		//	2) RLS RE58IA: 1024 cts/rev
		//
		// If we don't have a proper setting, default the old style encoder.  This would typically happen when
		//	installing a new version of code onto an existing TD-3.[01] machine.
		pNVM4^.LR_ENCODER_RES := 4096;
	END_IF
	CTS_LR_PER_CT_LC := CTS_LR_PER_CT_LC * (pNVM4^.LR_ENCODER_RES / CTS_LR_PER_REV_NOMINAL);
	
	IF pNVM4^.MACHINE_LR = 0 THEN
		// Danfoss OMT250 motors on DT unit can each take 125 liter/minute continuous.
		//	Valve is 210 lpm, so we can open wide.
		OUTMAX := 1000;
		R_P_E := 2.5 * pNVM4^.LR_ENCODER_RES;
	ELSE
		// Eurodrill 4X rotary is limited to 95 liter/minute/motor, with 2x motors, so 190 lpm total.
		OUTMAX := TO_UINT((190 / 210.0) * 1000.0);
		R_P_E := 48.0/19.0 * pNVM4^.LR_ENCODER_RES;
	END_IF
	
	AXES[AXIS_LOWER_ROTARY].FEEDBACK.INSTALLED := TRUE;

	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_LOWER_ROTARY].FEEDBACK),
		RAW_PER_ENGR := R_P_E,
		RAW_WHEN_ENGR_ZERO := 0,
		FB_VALID_MAX := 1000,
		FB_VALID_MIN := -1000,
		ROLLOVER_AT := 0);

	HaweVpocInit(ADR(AXES[AXIS_LOWER_ROTARY].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_LOWER_ROTARY), ADR(DSW_LOWER_ROTARY), ADR(VPOC_CMD_LOWER_ROTARY), FALSE);


	
	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_LOWER_ROTARY].CONFIG),
		FB := AXES[AXIS_LOWER_ROTARY].FEEDBACK,
		SPEED_PLUS_MAX := 8,
		SPEED_MINUS_MAX := 7.5,
		//SPEED_PLUS_MAX := 6,
		//SPEED_MINUS_MAX := 6,
		COMMAND_LIMIT_MAX := 100,
		COMMAND_LIMIT_MIN := -100,
		CYCLE_PLUS := 20,
		CYCLE_MINUS := 0,
		CYCLE_VEL := LOWER_ROTARY_VEL,
		CYCLE_ACCEL := LOWER_ROTARY_ACCEL,
		OUTPUT_PLUS_MAX := OUTMAX,
		OUTPUT_MINUS_MAX := OUTMAX,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 0,
		MANUAL_OUTPUT_AT_HARDSTOP := 0,
		MANUAL_OUTPUT_MAX := 0,
		POS_FOLLOW_BAND := 500,
		CYL_GAIN_RATIO := 1,
		CYL_EXT_POSITIVE := FALSE);

	LoopPIDInit(pLOOPPI := ADR(AXES[AXIS_LOWER_ROTARY].LOOP_PID),
		CFG := AXES[AXIS_LOWER_ROTARY].CONFIG,
		SETTLED_BAND := 0.05,
		// Changed from 4 to 3 (!) at Gemini to prevent lower rotary destabilization on insertion.
		// KP := 4.0,
		KP := 3.0,
		KI := 0.0,
		INTEGRATOR_MAX := 0,
		KD := 0);
(*
	LoopPIDInit(pLOOPPI := ADR(AXES[AXIS_LOWER_ROTARY].LOOP_PID),
		CFG := AXES[AXIS_LOWER_ROTARY].CONFIG,
		SETTLED_BAND := 0.05,
		KP := 5.0,
		KI := 0.0,
		INTEGRATOR_MAX := 0,
		KD := 10.0);
*)

(* Upper crowd *)
	AXES[AXIS_UPPER_CROWD].CONFIG.P_UNIT_NAME := 'CM';
	AXES[AXIS_UPPER_CROWD].CONFIG.V_UNIT_NAME := 'CM/sec';
	AXES[AXIS_UPPER_CROWD].CONFIG.A_UNIT_NAME := 'CM/sec^2';
	
// 	IF pNVM4^.HMI_SINTS[UPPER_CROWD_ENCODER_TYPE] = 1 THEN // Siko WV5800 @TODO confirm these numbers
// 		// Cts/rev of encoder is 16384, double the nominal.
// 		R_P_E := 2 * (250.0 / 2.54);
// 		R_AT := 2 * 16777216;
// 	ELSE // IFM RM7012
// 		// Cts/rev of the encoder is 8192, this is the nominal.
// 		R_P_E := 250.0 / 2.54;
// 		R_AT := 16777216;
// 	END_IF
	
	// Cts/rev of the encoder is 8192, this is the nominal.
	R_P_E := 250.0 / 2.54;
	R_AT := 16777216;

	AXES[AXIS_UPPER_CROWD].FEEDBACK.INSTALLED := TRUE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_UPPER_CROWD].FEEDBACK),
		RAW_PER_ENGR := R_P_E,
		RAW_WHEN_ENGR_ZERO := pNVM1^.UPPER_CROWD_ENCODER_AT_ZERO,
		FB_VALID_MAX := 530.0,
		FB_VALID_MIN := -5.0,
		ROLLOVER_AT := R_AT);

	HaweVpocInit(ADR(AXES[AXIS_UPPER_CROWD].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_UPPER_CROWD), ADR(DSW_UPPER_CROWD), ADR(VPOC_UPPER_CROWD), TRUE);

	ConfigInitPositionControlled(
		pCONFIG := ADR(AXES[AXIS_UPPER_CROWD].CONFIG),
		FB := AXES[AXIS_UPPER_CROWD].FEEDBACK,
		SPEED_PLUS_MAX := 80.0,
		SPEED_MINUS_MAX := 80.0,
		COMMAND_LIMIT_MAX := 300.0,
		COMMAND_LIMIT_MIN := 1.0,
		CYCLE_PLUS := 200,
		CYCLE_MINUS := 5,
		CYCLE_VEL := UPPER_CROWD_VEL,
		CYCLE_ACCEL := UPPER_CROWD_ACCEL,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 20,
		MANUAL_OUTPUT_AT_HARDSTOP := 100,
		MANUAL_OUTPUT_MAX := 500,
		POS_FOLLOW_BAND := 100,
		CYL_GAIN_RATIO := 1.0,
		CYL_EXT_POSITIVE := TRUE);

	LoopPIDInit(
		pLOOPPI := ADR(AXES[AXIS_UPPER_CROWD].LOOP_PID),
		CFG := AXES[AXIS_UPPER_CROWD].CONFIG,
		SETTLED_BAND := 0.5,
		KP := 3,
		KI := 2,
		INTEGRATOR_MAX := 500,
		KD := 0);

(* Upper rotary *)
	AXES[AXIS_UPPER_ROTARY].CONFIG.P_UNIT_NAME := 'Revs';
	AXES[AXIS_UPPER_ROTARY].CONFIG.V_UNIT_NAME := 'Revs/sec';
	AXES[AXIS_UPPER_ROTARY].CONFIG.A_UNIT_NAME := 'Revs/sec^2';

	AXES[AXIS_UPPER_ROTARY].FEEDBACK.INSTALLED := FALSE;
	FeedbackInit(
		pFEEDBACK := ADR(AXES[AXIS_UPPER_ROTARY].FEEDBACK),
		RAW_PER_ENGR := 2.5 * 1024.0,
		RAW_WHEN_ENGR_ZERO := 0,
		FB_VALID_MAX := 100,
		FB_VALID_MIN := -100,
		ROLLOVER_AT := 0);

	HaweVpocInit(ADR(AXES[AXIS_UPPER_ROTARY].CONFIG.HAWE_VPOC), USED := TRUE,
		ADR(DCW_UPPER_ROTARY), ADR(DSW_UPPER_ROTARY), ADR(VPOC_CMD_UPPER_ROTARY), FALSE);

