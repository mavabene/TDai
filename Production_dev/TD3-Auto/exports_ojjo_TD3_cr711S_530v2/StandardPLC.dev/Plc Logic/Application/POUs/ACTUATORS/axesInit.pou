		SPEED_MINUS_MAX := 6.0,
		COMMAND_LIMIT_MAX := 30,
		COMMAND_LIMIT_MIN := -12,
		CYCLE_PLUS := 25,
		CYCLE_MINUS := 0,
		CYCLE_VEL := 2,
		CYCLE_ACCEL := 2,
		OUTPUT_PLUS_MAX := 1000,
		OUTPUT_MINUS_MAX := 1000,
		DEADBAND_PLUS := 0,
		DEADBAND_MINUS := 0,
		MANUAL_HARDSTOP_BAND := 10,
		MANUAL_OUTPUT_AT_HARDSTOP := 300,
