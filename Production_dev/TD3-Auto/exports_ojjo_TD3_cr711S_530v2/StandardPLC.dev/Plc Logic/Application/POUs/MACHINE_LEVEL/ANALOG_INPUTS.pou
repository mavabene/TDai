
(********************** Declaration ****************************)
PROGRAM ANALOG_INPUTS
VAR
	FUEL_READING_MINIMUM: REAL := 30.0;
	FUEL_READING_MAXIMUM: REAL := 240.0;
	FUEL_MEASURING_FRACTION: REAL := 32.0 / 37.0;

END_VAR
(********************** Implementation ****************************)

IN_PUMP_PRESSURE(
	uiValueAnalogue => PUMP_PRESSURE_RAW);

IN_HYDRAULIC_TEMP(
	uiValueAnalogue => HYDRAULIC_TEMP_RAW);

PUMP_PRESSURE := (PUMP_PRESSURE_RAW - PRESSURE_OFFSET) * PRESSURE_SCALE_FACTOR;
HYDRAULIC_TEMP := (HYDRAULIC_TEMP_RAW - TEMPERATURE_OFFSET) * TEMPERATURE_SCALE_FACTOR + TEMPERATURE_ZERO;

PLC_BOARD_TEMP := TemperatureBoard0.Temperature;
PLC_CHIP_TEMP := TemperatureChip0.Temperature;

IF PLC_BOARD_TEMP > pNVM2^.PLC_BOARD_TEMP_MAX THEN
	pNVM2^.PLC_BOARD_TEMP_MAX := PLC_BOARD_TEMP;
ELSIF PLC_BOARD_TEMP < pNVM2^.PLC_BOARD_TEMP_MIN THEN
	pNVM2^.PLC_BOARD_TEMP_MIN := PLC_BOARD_TEMP;
END_IF

IF PLC_CHIP_TEMP > pNVM2^.PLC_CHIP_TEMP_MAX THEN
	pNVM2^.PLC_CHIP_TEMP_MAX := PLC_CHIP_TEMP;
ELSIF PLC_CHIP_TEMP < pNVM2^.PLC_CHIP_TEMP_MIN THEN
	pNVM2^.PLC_CHIP_TEMP_MIN := PLC_CHIP_TEMP;
END_IF

VBB15_MV := VBB15.VBBx;
IF VBB15_MV > pNVM2^.VBB15_MV_MAX THEN
	pNVM2^.VBB15_MV_MAX := VBB15_MV;
ELSIF VBB15_MV < pNVM2^.VBB15_MV_MIN THEN
	pNVM2^.VBB15_MV_MIN := VBB15_MV;
END_IF

VBB30_MV := VBB30.VBBx;
IF VBB30_MV > pNVM2^.VBB30_MV_MAX THEN
	pNVM2^.VBB30_MV_MAX := VBB30_MV;
ELSIF VBB30_MV < pNVM2^.VBB30_MV_MIN THEN
	pNVM2^.VBB30_MV_MIN := VBB30_MV;
END_IF
