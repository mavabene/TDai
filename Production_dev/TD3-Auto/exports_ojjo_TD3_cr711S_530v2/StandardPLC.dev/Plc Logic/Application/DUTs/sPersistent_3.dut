
(********************** Declaration ****************************)
(* ***** Only add var's to end of sPersistents, or the values will be corrupted!!! ***** *)

TYPE sPersistent_3 :
STRUCT
	NVM3_NEEDS_INIT: UDINT := 1000;
	NVM3_FORMAT_VERSION: UDINT := 1;
	NVM3_FORMAT_PLACEHOLDER_1: UDINT := 0;
	NVM3_FORMAT_PLACEHOLDER_2: UDINT := 0;
	
	// Who build the machine:
	//	0: Drilltech
	//	1: Hutte
	//	2: ???
// 	MACHINE_VENDOR: UDINT := 1; // hardcoded
	sPersistent_3_AVAIL_03: UDINT := 1;
	
	// Families are:
	//	0: TD-1.0
	//	1: TD-1.1
	//	2: TD-2
	//	3: TD-3
// 	MACHINE_FAMILY: UDINT := 3;
	sPersistent_3_AVAIL_04: UDINT := 3;
	
	// Version (note version is within a family, so you can have a V2 of TD2 and a V2 of TD3!).  This must be
	//	rolled when essentials of the machine construction have changed (different I/O, dimensions, etc.).
	//	0, 1, 2, 3...
	//
	// TD-2, Version 0: the original Drill Tech manufactured machine, from April 2020.
	// TD-3, Version 0: the original Hutte machine, from August 2020.
	// TD-3, Version 1: the updated Hutte machine for Kiewit, February 2021.
	// TD-3, Version 2: the re-updated Hutte machines, delivered February 2023
	//
	MACHINE_VERSION: UDINT := 2;
	
	BOOM_LIFT_ENCODER_AT_ZERO: UDINT := 0;
	JOINT_LIFT_ENCODER_AT_ZERO: UDINT := 0;
	
	sPersistent_3_AVAIL_05: BOOL := FALSE; 
// 	AUTO_PENDULUM: BOOL := FALSE;  // *** NOT USED _ CAN REUSE ***
	LOGIN_BYPASS: BOOL := FALSE;

	// Dimension for the ATI center structure from WP to the Average Top of Leg (ATOL).
	ATOL_TO_WP_MOTOR: REAL := 133.32 + 2.54; // ESM version of ATI => 130.49 + 2.54; NXT: N/A
	MAST_LEAN: REAL := 0.0; // deg
	RIGHT_LEFT_DIFF: REAL := 0.0;
	
	(*
		Product you want to installed:
			1) NXT SI (original, Titan version install)
			2) NXT INT (heart shaped)
			3) NXT VAR (customizable truss geometry)
			4) ATI (original, ESM version install)
	*)
	PRODUCT_INSTALL: INT := eProductType.PRODUCT_ATI;
	
	(* Controls whether or not the controls attempts to preload the front end of the machine before
		screw drive. *)
	sPersistent_3_AVAIL_01: BOOL := TRUE; // this has been turned into HMI_SINTS[AUTO_PRELOAD_SELECTION]
	sPersistent_3_AVAIL_02: REAL := 0.5;
	PRELOAD_SPEED: REAL := 1.3;
	MANUAL_DEPTH: BOOL := FALSE;

	EMBED_REDUCTION_ENABLED: BOOL := FALSE;
	EMBED_REDUCTION_DISTANCE: REAL := 18.0 * 2.54;
	EMBED_REDUCTION_HYSTERESIS: REAL := 2.54;
	EMBED_REDUCTION_MINIMUM: REAL := 24 * 2.54;
	
	UR_STALL_ENABLED: BOOL := FALSE;
	// Minimum pressure at which we can be considered stalled.
	UR_STALL_P_MIN: REAL := 2300;
	// Time window over which pressure is monitored.
	UR_STALL_P_TIME: REAL := 0.3;
	// How far away from the rail can we be and still be considered at the rail?
	UR_STALL_P_BAND: REAL := 30.0;
	// Velocity parameters are similar meanings to pressure parameters above...
	UR_STALL_V_MAX: REAL := 5;
	UR_STALL_V_TIME: REAL := 0.25;
	UR_STALL_V_BAND: REAL := 5;
	
	DRILL_BIT_WING_POSITION: REAL := 0.0;
	
	WATER_USED: BOOL := FALSE;
	// Liters per minute from the pump at full valve opening.
	WATER_PUMP_LPM: REAL := 5.0;
	// Liters per meter to the drill when screw drill/drive.
	WATER_DRILL_LPD: REAL := 1.0;

	NVM3_PADDING: UDINT := 16#DEADBEEF;

END_STRUCT
END_TYPE

(* ***** Only add var's to end of sPersistents, or the values will be corrupted!!! ***** *)