
(********************** Declaration ****************************)
FUNCTION_BLOCK valveFailed
VAR_INPUT
END_VAR
VAR_OUTPUT
	FAILED: BOOL;
END_VAR
VAR CONSTANT
	CONSTANT NUM_VALVES: INT := 22;
END_VAR
VAR
	INDEX: INT;
	VALVE_FAILED: ARRAY [1..NUM_VALVES] OF BOOL;
END_VAR

(********************** Implementation ****************************)
VALVE_FAIL_CURRENT := 0;
VALVE_COMM_CURRENT := 0;

FOR INDEX := 1 TO NUM_VALVES DO
	VALVE_FAILED[INDEX] := FALSE;	
END_FOR

FOR INDEX := 1 TO NUM_AXES DO
	// Some axes are on dumb valves, but still treated as axis.
	IF AXES[INDEX].CONFIG.HAWE_VPOC.EXISTS THEN //INDEX <> AXIS_UPPER_ROTARY THEN
		IF AXES[INDEX].CONFIG.HAWE_VPOC.pDSW^ <> 15 THEN
				VALVE_FAILED[INDEX] := TRUE;
				VALVE_FAIL_CURRENT := VALVE_FAIL_CURRENT OR SHL(1, INDEX - 1);
		END_IF
		IF AXES[INDEX].CONFIG.HAWE_VPOC.pDSW^ = 0 THEN
			VALVE_COMM_CURRENT := VALVE_COMM_CURRENT OR SHL(1, INDEX - 1);
		END_IF
	END_IF
END_FOR

// temp debug
// IF TEST THEN
//     VALVE_FAIL_CURRENT := VALVE_FAIL_CURRENT OR DWORD#16#80000000;
// END_IF
// Track this in case we have intermittent failures.
VALVE_FAIL_LATCH := VALVE_FAIL_LATCH OR VALVE_FAIL_CURRENT;
VALVE_COMM_LATCH := VALVE_COMM_LATCH OR VALVE_COMM_CURRENT;

FAILED := VALVE_FAIL_CURRENT <> 0 OR VALVE_COMM_CURRENT <> 0;
