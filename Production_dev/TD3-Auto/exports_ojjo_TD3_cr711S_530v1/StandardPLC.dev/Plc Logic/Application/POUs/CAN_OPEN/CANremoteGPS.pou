PROGRAM CANremoteGPS
VAR CONSTANT
	usiCANremoteNode: USINT:= 29;
	eCanRemoteChannel: ifmDevice.CAN_CHANNEL:= ifmDevice.CAN_CHANNEL.CHAN_0;
	
	tGetGpsEvery: TIME:= T#2S;
	
	uiLatitudeIdx: UINT:= 16#5209;
	usiLatitudeSubIdx: USINT:= 0;
	
	uiLongitudeIdx: UINT:= 16#5208;
	usiLongitudeSubIdx: USINT:= 0;
END_VAR
VAR_INPUT
	
END_VAR
VAR_OUTPUT
	xError: BOOL;
	rLatitude: REAL;
	rLongitude: REAL;
END_VAR
VAR
	xStartCanRemote: BOOL:= TRUE;
	tonGetGps: CIA405.TON;
	xReadLat: BOOL;
	xReadLong: BOOL;
	sdoReadLatitude: ifmR360_3.ifmCOP_MG.COP_SDOread;
	sdoReadLongitude: ifmR360_3.ifmCOP_MG.COP_SDOread;
	nmtCanRemote: ifmR360_3.ifmCOP_MG.COP_SendNMT;
END_VAR