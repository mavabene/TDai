
(********************** Declaration ****************************)
FUNCTION_BLOCK FilterFIR_20Hz
VAR_INPUT
	CURRENT: REAL;
END_VAR
VAR_OUTPUT
	OUTPUT: REAL;
END_VAR
VAR
	FILTERED: LREAL;
	S_INDEX: INT;
	C_INDEX: INT;
	THIS_SAMPLE: INT;
	(* Filter design from:
	
		http://t-filter.engineerjs.com/
		
		Setup was:
			1) Sampling frequency of 100 Hz
			2) Passband of 0-2 Hz, allowable ripple 0.5 dB
			3) Stop band of 4-50 Hz, attenuation of -40 dB
		
		**** NOTE THAT THIS WEBSITE GIVES COEFFICIENTS WITH A DC GAIN, SO THEY MUST BE ADJUSTED IF YOU WANT GAIN
			OF 1 !!!  THIS HAS BEEN DONE BELOW ****
	*)
	FILTER_LENGTH: INT := 91;
	COEFFS: ARRAY[1..91] OF LREAL :=
		// Adjusted coefficients.
		[
		0.00572431968821139,
		0.00205402065561119,
		0.00230595772968888,
		0.00250086166725314,
		0.00260153361134166,
		0.00259466326485535,
		0.00246451645821110,
		0.00219572588208601,
		0.00177673276233721,
		0.00120207086608682,
		0.00047351104507184,
		-0.00039958817423098,
		-0.00140032103723370,
		-0.00250436671298413,
		-0.00368010615629640,
		-0.00488880432847194,
		-0.00608504290947136,
		-0.00721757872165045,
		-0.00823070212964002,
		-0.00906603740683486,
		-0.00966462730608705,
		-0.00996911509481552,
		-0.00992587801056471,
		-0.00948704250420412,
		-0.00861237804852256,
		-0.00727108906760070,
		-0.00544349703219398,
		-0.00312254724622068,
		-0.00031502143500250,
		0.00295768234095084,
		0.00665931531579058,
		0.01073914174783210,
		0.01513288326459360,
		0.01976417268534180,
		0.02454642393687300,
		0.02938503235243510,
		0.03417984233237510,
		0.03882783775221800,
		0.04322601086509140,
		0.04727434554388640,
		0.05087881965679830,
		0.05395430405099500,
		0.05642722504403210,
		0.05823786870081910,
		0.05934223423453260,
		0.05971337973341210,
		0.05934223423453260,
		0.05823786870081910,
		0.05642722504403210,
		0.05395430405099500,
		0.05087881965679830,
		0.04727434554388640,
		0.04322601086509140,
		0.03882783775221800,
		0.03417984233237510,
		0.02938503235243510,
		0.02454642393687300,
		0.01976417268534180,
		0.01513288326459360,
		0.01073914174783210,
		0.00665931531579058,
		0.00295768234095084,
		-0.00031502143500250,
		-0.00312254724622068,
		-0.00544349703219398,
		-0.00727108906760070,
		-0.00861237804852256,
		-0.00948704250420412,
		-0.00992587801056471,
		-0.00996911509481552,
		-0.00966462730608705,
		-0.00906603740683486,
		-0.00823070212964002,
		-0.00721757872165045,
		-0.00608504290947136,
		-0.00488880432847194,
		-0.00368010615629640,
		-0.00250436671298413,
		-0.00140032103723370,
		-0.00039958817423098,
		0.00047351104507184,
		0.00120207086608682,
		0.00177673276233721,
		0.00219572588208601,
		0.00246451645821110,
		0.00259466326485535,
		0.00260153361134166,
		0.00250086166725314,
		0.00230595772968888,
		0.00205402065561119,
		0.00572431968821139
		];
	SAMPLES: ARRAY[1..91] OF REAL;
	NEXT_SAMPLE: INT := 1;
END_VAR

(********************** Implementation ****************************)

(* Store away the sample. *)
SAMPLES[NEXT_SAMPLE] := CURRENT;

(* Calculate the filter output. *)
FILTERED := 0.0;
S_INDEX := NEXT_SAMPLE;
FOR C_INDEX := 1 TO FILTER_LENGTH DO
	FILTERED := FILTERED + COEFFS[C_INDEX] * SAMPLES[S_INDEX];
	IF S_INDEX = 1 THEN
		S_INDEX := FILTER_LENGTH;
	ELSE
		S_INDEX := S_INDEX - 1;
	END_IF
END_FOR

(* Bump and wrap to ready for next sample. *)
IF NEXT_SAMPLE = FILTER_LENGTH THEN
	NEXT_SAMPLE := 1;
ELSE
	NEXT_SAMPLE := NEXT_SAMPLE + 1;
END_IF

OUTPUT := TO_REAL(FILTERED);