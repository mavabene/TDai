
(********************** Declaration ****************************)
FUNCTION isNXT_SI3LAdjustNeeded : BOOL
VAR_INPUT
END_VAR
VAR
END_VAR

(********************** Implementation ****************************)

isNXT_SI3LAdjustNeeded :=
	pNVM4^.GPS_AUTOTARGET_SELECTION.GPS_3RD_LEG_X_ADJUST AND
	pNVM3^.PRODUCT_INSTALL = eProductType.PRODUCT_NXT_SI AND
// 	(SCREW_PARAMETERS_CURRENT.TRUSS_TYPE = TO_UINT(eTrussType.TRUSS_TYPE_CENTER_STRUCTURE)) AND
	(getTrussType() = eTrussType.TRUSS_TYPE_CENTER_STRUCTURE) AND
	//( getTrussType() = eTrussType.TRUSS_TYPE_CENTER_STRUCTURE) AND
	(getScrewSide() = eScrewSide.SCREW_CENTER);
