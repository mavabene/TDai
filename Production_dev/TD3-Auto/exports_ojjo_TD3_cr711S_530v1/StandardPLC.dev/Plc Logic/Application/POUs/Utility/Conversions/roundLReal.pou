
(********************** Declaration ****************************)
FUNCTION roundLReal : LREAL  // mostly works - see testSimpleConversions for exception (many decimal places near .5, eg  or 0.49999999 rounds up, but 0.499 rounds down)
VAR_INPUT
    x      : LREAL;   // value to round
    places : DINT;   // 2=hundredths, 0=units, -1=tens, -2=hundreds, ...
END_VAR
VAR
    absPlaces, i : DINT;
    factor, scaled, y : LREAL;
    n            : DINT;
END_VAR
(********************** Implementation ****************************)
// build 10^|places| safely
factor := 1.0;
IF places < 0 THEN 
	absPlaces := -places;
ELSE 
	absPlaces := places;
END_IF;
FOR i := 1 TO absPlaces DO 
	factor := factor * 10.0; 
END_FOR

// scale to target unit
scaled := x;
IF places >= 0 THEN
    scaled := scaled * factor;
ELSE
    scaled := scaled / factor;
END_IF;

// half-away-from-zero using TRUNC (avoids double rounding)
IF scaled >= 0.0 THEN
    n := LREAL_TO_DINT( TRUNC(scaled + 0.5) );
ELSE
    n := LREAL_TO_DINT( TRUNC(scaled - 0.5) );
END_IF;

// unscale
IF places >= 0 THEN
    y := DINT_TO_LREAL(n) / factor;
ELSE
    y := DINT_TO_LREAL(n) * factor;
END_IF;

roundLReal := LREAL_TO_REAL(y);