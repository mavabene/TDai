
(********************** Declaration ****************************)
FUNCTION GetSimpleHeading : USINT
VAR_INPUT
END_VAR
VAR
END_VAR

(********************** Implementation ****************************)
TD_HEADING_NORTH := FALSE;
TD_HEADING_EAST := FALSE;
TD_HEADING_SOUTH := FALSE;
TD_HEADING_WEST := FALSE;


IF GPS_ABSOLUTE_HEADING >= 315 OR GPS_ABSOLUTE_HEADING <= 45 THEN
	TD_HEADING_NORTH := TRUE;
ELSIF GPS_ABSOLUTE_HEADING > 45 AND GPS_ABSOLUTE_HEADING < 135 THEN
	TD_HEADING_EAST := TRUE;
ELSIF GPS_ABSOLUTE_HEADING >= 135 AND GPS_ABSOLUTE_HEADING <= 225 THEN
	TD_HEADING_SOUTH := TRUE;
ELSE
	TD_HEADING_WEST := TRUE;
END_IF