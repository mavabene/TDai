
(********************** Declaration ****************************)
// take GPS values and return world (pNEZD) values
// assume TD is heading north, then positve world x aligns with forward on machine and forward in mast frame
// in this case mast frame aligns with world frame, so we just have to resolve heading, pitch, and roll
FUNCTION CONVERT_MAST_FRAME_ROTATION_TO_FROM_LHR : Rotation3D
VAR_INPUT
	FRAME_ROTATION: Rotation3D;
END_VAR
VAR

END_VAR

(********************** Implementation ****************************)

CONVERT_MAST_FRAME_ROTATION_TO_FROM_LHR[rot.YAW_DEG] :=  FRAME_ROTATION[rot.YAW_DEG];
CONVERT_MAST_FRAME_ROTATION_TO_FROM_LHR[rot.PITCH_DEG] := FRAME_ROTATION[rot.PITCH_DEG];
CONVERT_MAST_FRAME_ROTATION_TO_FROM_LHR[rot.ROLL_DEG] := FRAME_ROTATION[rot.ROLL_DEG];

