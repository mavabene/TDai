
(********************** Declaration ****************************)
FUNCTION COS_DEG : REAL
VAR_INPUT
	DEGREES: REAL;
END_VAR
VAR
	RADIANS: REAL;
END_VAR
(********************** Implementation ****************************)

//RADIANS := (3.14159 * DEGREES / 180.0);
RADIANS := (Pi * DEGREES / 180.0);
COS_DEG := COS(RADIANS);


