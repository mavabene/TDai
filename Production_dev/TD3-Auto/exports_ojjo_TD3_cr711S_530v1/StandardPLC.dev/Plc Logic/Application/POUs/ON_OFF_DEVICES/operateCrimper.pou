
(********************** Declaration ****************************)
FUNCTION_BLOCK operateCrimper
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	START_TIME: DWORD;
	
	LEFT_CRIMPER_TON: TON;
	RIGHT_CRIMPER_TON: TON;

	LEFT_CRIMPER_OPEN_CMD: UINT;
	LEFT_CRIMPER_OPEN_ERROR: BOOL;
	LEFT_CRIMPER_OPEN_ACTIVATED: BOOL;
	LEFT_CRIMPER_OPEN_PREPARED: BOOL;

	RIGHT_CRIMPER_OPEN_CMD: UINT;
	RIGHT_CRIMPER_OPEN_ERROR: BOOL;
	RIGHT_CRIMPER_OPEN_ACTIVATED: BOOL;
	RIGHT_CRIMPER_OPEN_PREPARED: BOOL;

	LEFT_CRIMPER_CLOSE_CMD: UINT;
	LEFT_CRIMPER_CLOSE_ERROR: BOOL;
	LEFT_CRIMPER_CLOSE_ACTIVATED: BOOL;
	LEFT_CRIMPER_CLOSE_PREPARED: BOOL;

	RIGHT_CRIMPER_CLOSE_CMD: UINT;
	RIGHT_CRIMPER_CLOSE_ERROR: BOOL;
	RIGHT_CRIMPER_CLOSE_ACTIVATED: BOOL;
	RIGHT_CRIMPER_CLOSE_PREPARED: BOOL;

	LEFT_CRIMPER_PWM_OUTPUT: HawePSVPwmOutput;
	LEFT_CRIMPER_MAGNITUDE: WORD;
	LEFT_CRIMPER_POSITIVE: BOOL;
	RIGHT_CRIMPER_PWM_OUTPUT: HawePSVPwmOutput;
	RIGHT_CRIMPER_MAGNITUDE: WORD;
	RIGHT_CRIMPER_POSITIVE: BOOL;
END_VAR
(********************** Implementation ****************************)
IF MACHINE_MODE = SCREW_MODE AND SCREW_STATE = SCREW_STATE_CRIMP AND isScrewModeStateChange() THEN
	RIGHT_CRIMPER_CLOSE_ACTIVATED := FALSE;
	LEFT_CRIMPER_CLOSE_ACTIVATED := FALSE;
END_IF
(* Always sample the buttons. *)
IN_LEFT_CRIMPER_OPEN_BUTTON(uiCHANNEL := LEFT_CRIMPER_OPEN_BUTTON_POINT, eMode := ifmIOCommon.MODE_INPUT.IN_DIGITAL_CSI, xValueDigital => LEFT_CRIMPER_OPEN_BUTTON, eDiagInfo => LEFT_CRIMPER_OPEN_DIAG);
IN_LEFT_CRIMPER_CLOSE_BUTTON(uiCHANNEL := LEFT_CRIMPER_CLOSE_BUTTON_POINT, eMode := ifmIOCommon.MODE_INPUT.IN_DIGITAL_CSI, xValueDigital => LEFT_CRIMPER_CLOSE_BUTTON, eDiagInfo => LEFT_CRIMPER_CLOSE_DIAG);
IN_LEFT_CRIMPER_CONFIRM_BUTTON(uiCHANNEL := LEFT_CRIMPER_CONFIRM_BUTTON_POINT, eMode := ifmIOCommon.MODE_INPUT.IN_DIGITAL_CSI, xValueDigital => LEFT_CRIMPER_CONFIRM_BUTTON, eDiagInfo => LEFT_CRIMPER_CONFIRM_DIAG);
IN_RIGHT_CRIMPER_OPEN_BUTTON(uiCHANNEL := RIGHT_CRIMPER_OPEN_BUTTON_POINT, eMode := ifmIOCommon.MODE_INPUT.IN_DIGITAL_CSI, xValueDigital => RIGHT_CRIMPER_OPEN_BUTTON, eDiagInfo => RIGHT_CRIMPER_OPEN_DIAG);
IN_RIGHT_CRIMPER_CLOSE_BUTTON(uiCHANNEL := RIGHT_CRIMPER_CLOSE_BUTTON_POINT, eMode := ifmIOCommon.MODE_INPUT.IN_DIGITAL_CSI, xValueDigital => RIGHT_CRIMPER_CLOSE_BUTTON, eDiagInfo => RIGHT_CRIMPER_CLOSE_DIAG);
IN_RIGHT_CRIMPER_CONFIRM_BUTTON(uiCHANNEL := RIGHT_CRIMPER_CONFIRM_BUTTON_POINT, eMode := ifmIOCommon.MODE_INPUT.IN_DIGITAL_CSI, xValueDigital => RIGHT_CRIMPER_CONFIRM_BUTTON, eDiagInfo => RIGHT_CRIMPER_CONFIRM_DIAG);

// Handle the "confirm close" button.
LEFT_CRIMPER_CONFIRMED_CLOSE := (NOT LEFT_CRIMPER_OPEN_BUTTON) AND LEFT_CRIMPER_CLOSE_BUTTON AND LEFT_CRIMPER_CONFIRM_BUTTON AND (NOT LEFT_CRIMPER_TON.Q OR LEFT_CRIMPER_CONFIRMED_CLOSE);
RIGHT_CRIMPER_CONFIRMED_CLOSE := (NOT RIGHT_CRIMPER_OPEN_BUTTON) AND RIGHT_CRIMPER_CLOSE_BUTTON AND RIGHT_CRIMPER_CONFIRM_BUTTON AND (NOT RIGHT_CRIMPER_TON.Q OR RIGHT_CRIMPER_CONFIRMED_CLOSE);

LEFT_CRIMPER_TON(IN := LEFT_CRIMPER_CLOSE_BUTTON OR LEFT_CRIMPER_CONFIRM_BUTTON, PT := T#0.5S);
RIGHT_CRIMPER_TON(IN := RIGHT_CRIMPER_CLOSE_BUTTON OR RIGHT_CRIMPER_CONFIRM_BUTTON, PT := T#0.5S);

(* Crimpers operate only in screw mode, crimp state. *)
IF MACHINE_MODE = SCREW_MODE AND
	((SCREW_STATE = SCREW_STATE_CRIMP) OR NOT AUTOMATIC)
	THEN
	IF LEFT_CRIMPER_OPEN_BUTTON AND LEFT_CRIMPER_CLOSE_BUTTON THEN
		(* Turn off if both buttons pushed. *)
		LEFT_CRIMPER_OPEN_CMD := 0;
		LEFT_CRIMPER_CLOSE_CMD := 0;
	ELSE
		(* Otherwise just map buttons onto valves. *)
		LEFT_CRIMPER_OPEN_CMD := TO_UINT(LEFT_CRIMPER_OPEN_BUTTON);
		LEFT_CRIMPER_CLOSE_CMD := TO_UINT(LEFT_CRIMPER_CONFIRMED_ClOSE); //TO_UINT(LEFT_CRIMPER_CLOSE_BUTTON);
	END_IF

	IF RIGHT_CRIMPER_OPEN_BUTTON AND RIGHT_CRIMPER_CLOSE_BUTTON THEN
		(* Turn off if both buttons pushed. *)
		RIGHT_CRIMPER_OPEN_CMD := 0;
		RIGHT_CRIMPER_CLOSE_CMD := 0;
	ELSE
		(* Otherwise just map buttons onto valves. *)
		RIGHT_CRIMPER_OPEN_CMD := TO_UINT(RIGHT_CRIMPER_OPEN_BUTTON);
		RIGHT_CRIMPER_CLOSE_CMD := TO_UINT(RIGHT_CRIMPER_CONFIRMED_CLOSE); //TO_UINT(RIGHT_CRIMPER_CLOSE_BUTTON);
	END_IF
ELSE
	LEFT_CRIMPER_OPEN_CMD := 0;
	LEFT_CRIMPER_CLOSE_CMD := 0;
	RIGHT_CRIMPER_OPEN_CMD := 0;
	RIGHT_CRIMPER_CLOSE_CMD := 0;
END_IF

(* Operate crimper as an assembly, don't let both valves be forced on simultaneously. *)
IF LEFT_CRIMPER_OPEN_FORCE.FORCED THEN
	LEFT_CRIMPER_OPEN_CMD := TO_UINT(LEFT_CRIMPER_OPEN_FORCE.DOUT_STATE);
	LEFT_CRIMPER_CLOSE_CMD := 0;
ELSIF LEFT_CRIMPER_CLOSE_FORCE.FORCED THEN
	LEFT_CRIMPER_OPEN_CMD := 0;
	LEFT_CRIMPER_CLOSE_CMD := TO_UINT(LEFT_CRIMPER_CLOSE_FORCE.DOUT_STATE);
END_IF

IF LEFT_CRIMPER_OPEN_CMD <> 0 THEN
	LEFT_CRIMPER_POSITIVE := FALSE;
	LEFT_CRIMPER_MAGNITUDE := pNVM2^.CRIMPER_LEFT_OPEN_SPEED * 10;
ELSIF LEFT_CRIMPER_CLOSE_CMD <> 0 THEN
	IF MACHINE_MODE = SCREW_MODE AND SCREW_STATE = SCREW_STATE_CRIMP THEN
		LEFT_CRIMPER_CLOSE_ACTIVATED := TRUE;
	END_IF
	
	LEFT_CRIMPER_POSITIVE := TRUE;
	LEFT_CRIMPER_MAGNITUDE := pNVM2^.CRIMPER_LEFT_CLOSE_SPEED * 10;
ELSE
	LEFT_CRIMPER_POSITIVE := FALSE;
	LEFT_CRIMPER_MAGNITUDE := 0;
END_IF

setOutput(ADR(AXES[AXIS_LEFT_CRIMPER].OUTPUT), LEFT_CRIMPER_MAGNITUDE, LEFT_CRIMPER_POSITIVE);
HaweOutput(ADR(AXES[AXIS_LEFT_CRIMPER]));	

IF RIGHT_CRIMPER_OPEN_FORCE.FORCED THEN
	RIGHT_CRIMPER_OPEN_CMD := TO_UINT(RIGHT_CRIMPER_OPEN_FORCE.DOUT_STATE);
	RIGHT_CRIMPER_CLOSE_CMD := 0;
ELSIF RIGHT_CRIMPER_CLOSE_FORCE.FORCED THEN
	RIGHT_CRIMPER_OPEN_CMD := 0;
	RIGHT_CRIMPER_CLOSE_CMD := TO_UINT(RIGHT_CRIMPER_CLOSE_FORCE.DOUT_STATE);
END_IF

IF RIGHT_CRIMPER_OPEN_CMD <> 0 THEN
	RIGHT_CRIMPER_POSITIVE := FALSE;
	RIGHT_CRIMPER_MAGNITUDE := pNVM2^.CRIMPER_RIGHT_OPEN_SPEED * 10;
ELSIF RIGHT_CRIMPER_CLOSE_CMD <> 0 THEN
	IF MACHINE_MODE = SCREW_MODE AND SCREW_STATE = SCREW_STATE_CRIMP THEN
		RIGHT_CRIMPER_CLOSE_ACTIVATED := TRUE;
	END_IF
	RIGHT_CRIMPER_POSITIVE := TRUE;
	RIGHT_CRIMPER_MAGNITUDE := pNVM2^.CRIMPER_RIGHT_CLOSE_SPEED * 10;
ELSE
	RIGHT_CRIMPER_POSITIVE := FALSE;
	RIGHT_CRIMPER_MAGNITUDE := 0;
END_IF

setOutput(ADR(AXES[AXIS_RIGHT_CRIMPER].OUTPUT), RIGHT_CRIMPER_MAGNITUDE, RIGHT_CRIMPER_POSITIVE);
HaweOutput(ADR(AXES[AXIS_RIGHT_CRIMPER]));	

IF MACHINE_MODE = SCREW_MODE AND SCREW_STATE = SCREW_STATE_CRIMP AND 
	LEFT_CRIMPER_CLOSE_ACTIVATED AND RIGHT_CRIMPER_CLOSE_ACTIVATED THEN
	TRUSS_COMPLETED := TRUE;
	LEFT_CRIMPER_CLOSE_ACTIVATED := FALSE;
	RIGHT_CRIMPER_CLOSE_ACTIVATED := FALSE;
	// reset
END_IF

