
(********************** Declaration ****************************)
FUNCTION_BLOCK operateTarget
VAR_INPUT
END_VAR
VAR
	DESIRE_UP: BOOL;
	
	LAST_DESIRE_UP: INT := -1;
	NEEDS_INIT: BOOL := TRUE;

	TOF_UP: TOF;
	TOF_DOWN: TOF;
	TOF_UP_FORCE: TOF;
	UP_FORCE: BOOL := FALSE;
	LAST_UP_FORCE: BOOL := FALSE;
	OPERATE: BOOL;
	UP_RUNNING: BOOL;
	DOWN_RUNNING: BOOL;
	ET_DOWN: TIME;
	ET_UP: TIME;
	ET_UP_FORCED: TIME;
	UP_TIME: TIME := T#5S;
	UP_CLEAR_TIME: TIME := T#3S;
	
	TARGET_PLATE_OCC: HawePSVCurrentControl;
	MAGNITUDE: UINT;
	POSITIVE: BOOL;
	
	TARGET_PLATE_UP_DIAG: ifmTypes.DIAG_INFO;
	TARGET_PLATE_UP_CMD: UINT;
	TARGET_PLATE_UP_ERROR: BOOL;
	TARGET_PLATE_UP_ACTIVATED: BOOL;
	TARGET_PLATE_UP_PREPARED: BOOL;

	TARGET_PLATE_DOWN_DIAG: ifmTypes.DIAG_INFO;
	TARGET_PLATE_DOWN_CMD: UINT;
	TARGET_PLATE_DOWN_ERROR: BOOL;
	TARGET_PLATE_DOWN_ACTIVATED: BOOL;
	TARGET_PLATE_DOWN_PREPARED: BOOL;
	
	PRESSURIZE_TARGET_PLATE: BOOL := FALSE;

END_VAR
(********************** Implementation ****************************)
IF (MACHINE_MODE = ERROR_MODE OR
	MACHINE_MODE = IDLE_MODE OR
	NOT (AUTOMATIC AND AUTOMATIC_ALLOWED))
	THEN
	(* Don't do anything here!  When the machine powers up, don't touch anything.  Then
		in track mode, make sure all setup motions are complete before sending this down. *)
// 	LASER_ONLY := TRUE;
	OPERATE := FALSE;
	DESIRE_UP := FALSE;
ELSIF TRUSS_BEING_ASSEMBLED AND MACHINE_MODE = SCREW_MODE THEN
	IF SCREW_STATE = SCREW_STATE_GPS_FWP_RETURN_TO_WP THEN
		PRESSURIZE_TARGET_PLATE := TRUE;
	END_IF
// 	LASER_ONLY := FALSE;
	OPERATE := TRUE;
	DESIRE_UP := FALSE;
ELSIF 
		// Screw mode and not assembling/crimping
		((MACHINE_MODE = TRACK_MODE) AND NOT TRACK_BACK_REQUIRED)
	OR
		(MACHINE_MODE =  RWP_MODE)
	OR
		(MACHINE_MODE = SCREW_MODE AND
			NOT (
				SCREW_STATE = SCREW_STATE_CRIMP OR
				SCREW_STATE = SCREW_STATE_ASSEMBLE OR
				SCREW_STATE = SCREW_STATE_CLEAR_TRUSS_CAP OR
				SCREW_STATE = SCREW_STATE_FWP OR
				SCREW_STATE = SCREW_STATE_LC_CLEAR OR
				SCREW_STATE = SCREW_STATE_GPS_FWP_RETURN_TO_WP OR
				SCREW_STATE = SCREW_STATE_GPS_FWP_AUTOTARGET_GPS OR
				(SCREW_STATE = SCREW_STATE_MAST_TO_VERTICAL AND SCREW_SIDE_LATCH = SCREW_LEFT)
			)
		) 
	OR
	   	// UC is in UPPER_CROWD_TRACK_POS during Tracking and RWP, so should pass this condition
		(
			(AXES[AXIS_UPPER_CROWD].FEEDBACK.POSITION_ENGR < (UPPER_CROWD_TRACK_POS - UPPER_CROWD_ACCURACY - 2)) 
			AND NOT
			(
				MACHINE_MODE = SCREW_MODE AND
					(SCREW_STATE = SCREW_STATE_CRIMP OR
					SCREW_STATE = SCREW_STATE_ASSEMBLE OR
					SCREW_STATE = SCREW_STATE_FWP OR
					SCREW_STATE = SCREW_STATE_GPS_FWP_RETURN_TO_WP OR
					SCREW_STATE = SCREW_STATE_GPS_FWP_AUTOTARGET_GPS )
			)
		) 
	THEN
	(* We want the target plate up when we are:
		1) Not operating in automatic, OR
		2) Not in crimp or assembly state of screw mode, OR
		3) When a software bug has wanted us to put the target plate down onto the drill steel!
	*)
// 	LASER_ONLY := FALSE;
	PRESSURIZE_TARGET_PLATE := FALSE;
	OPERATE := TRUE;
	DESIRE_UP := TRUE;
ELSE
// 	LASER_ONLY := FALSE;
	OPERATE := TRUE;
	DESIRE_UP := FALSE;
END_IF

// OPERATE := NOT LASER_ONLY;
TOF_UP(IN := (OPERATE AND DESIRE_UP AND (TO_INT(DESIRE_UP) <> LAST_DESIRE_UP)), PT := UP_TIME, ET => ET_UP, Q => UP_RUNNING);
TOF_DOWN(IN := (OPERATE AND NOT DESIRE_UP AND (TO_INT(DESIRE_UP) <> LAST_DESIRE_UP)), PT := T#10S, ET => ET_DOWN, Q => DOWN_RUNNING);
IF OPERATE THEN
	LAST_DESIRE_UP := TO_INT(DESIRE_UP);
ELSE
	// When we begin to operate the TP we want to force it to take the up or down motion.
	LAST_DESIRE_UP := -1;
END_IF;

IF OPERATE AND NOT DESIRE_UP THEN
	TARGET_PLATE_UP := FALSE;
ELSE
	IF OPERATE AND DESIRE_UP AND ET_UP > (UP_TIME - UP_CLEAR_TIME) THEN
		TARGET_PLATE_UP := TRUE;
	END_IF 
END_IF

IF OPERATE AND DESIRE_UP AND UP_RUNNING THEN
	TARGET_PLATE_UP_CMD := 1;
	TARGET_PLATE_DOWN_CMD := 0;
ELSIF OPERATE AND NOT DESIRE_UP AND DOWN_RUNNING THEN
	TARGET_PLATE_UP_CMD := 0;
	TARGET_PLATE_DOWN_CMD := 1;
ELSE
	TARGET_PLATE_UP_CMD := 0;
	TARGET_PLATE_DOWN_CMD := 0;
END_IF

// This is to try to track the state of the target plate, up or down.
UP_FORCE := TARGET_PLATE_UP_FORCE.FORCED AND TARGET_PLATE_UP_FORCE.DOUT_STATE;
TOF_UP_FORCE(IN := UP_FORCE AND NOT LAST_UP_FORCE, PT := UP_TIME, ET => ET_UP_FORCED);
LAST_UP_FORCE := UP_FORCE;

IF TARGET_PLATE_UP_FORCE.FORCED AND TARGET_PLATE_UP_FORCE.DOUT_STATE THEN
	TARGET_PLATE_UP_CMD := 1;
	TARGET_PLATE_DOWN_CMD := 0;
	// Hack!  If the operator has forced the target plate up for this time, consider it is out of the way of the
	//	drill bit.
	IF ET_UP_FORCED > UP_CLEAR_TIME THEN
		TARGET_PLATE_UP := TRUE;
	END_IF
	LAST_DESIRE_UP := -1;
ELSIF (TARGET_PLATE_DOWN_FORCE.FORCED AND TARGET_PLATE_DOWN_FORCE.DOUT_STATE) OR PRESSURIZE_TARGET_PLATE THEN
	TARGET_PLATE_UP_CMD := 0;
	TARGET_PLATE_DOWN_CMD := 1;
	// Any amount of sending the target plate down will cause us to consider it all the way down.
	TARGET_PLATE_UP := FALSE;
	LAST_DESIRE_UP := -1;
END_IF

IF TARGET_PLATE_UP_CMD = 0 AND TARGET_PLATE_DOWN_CMD = 0 THEN
	MAGNITUDE := 0;
ELSIF TARGET_PLATE_UP_CMD <> 0 THEN
	POSITIVE := TRUE;
	MAGNITUDE := pNVM2^.TCH_UP_SPEED * 10;
	IF AUTO_MODE_ADVANCE THEN 
		MAGNITUDE := MAGNITUDE / 2;
	END_IF
ELSIF TARGET_PLATE_DOWN_CMD <> 0 THEN
	POSITIVE := FALSE;
	MAGNITUDE := pNVM2^.TCH_DOWN_SPEED * 10;
END_IF

setOutput(ADR(AXES[AXIS_TARGET_PLATE].OUTPUT), MAGNITUDE, POSITIVE);
HaweOutput(ADR(AXES[AXIS_TARGET_PLATE]));	
	