
(********************** Declaration ****************************)
FUNCTION_BLOCK BOOM_SWING
VAR_INPUT
	INIT: BOOL;
	pBOOM_SWING: POINTER TO sAxis;
	TIME_US: DWORD;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	VALID: BOOL;
	POSITION_RAW: DINT;
	CLOSED_LOOP: BOOL := FALSE;
	PROFILER: BOOL := FALSE;
	JOYSTICK_01: joystickToJogOutput;
	OUTPUT_MAX: REAL;
	ERROR: REAL;
	ERROR_ABS: REAL;
	TARGET_POS: REAL;
	ACCEL: REAL;
	VEL: REAL;
	
	// GPS
	GPS_VEL: REAL := 0.8; // slower to prevent disturbing antennas, and slower than yaw so heading can maintain
	GPS_ACCEL: REAL := 0.6; // *****test these values < ^
	INITIATE_GPS_AUTO_MOVE: BOOL := FALSE;
	GPS_FINE_TUNE_SLOWDOWN_FACTOR: REAL := 0.5;
	GPS_FEEDBACK_AUTOTARGET_INIT : BOOL := TRUE;
	TARGET_LAST: REAL := 0; //
END_VAR
(********************** Implementation ****************************)
(* Operate the boom swing axis based on the top-level state of the machine.  Boom swing from the operator's viewpoint at rear
	is positive to the right, or CCW from above *)
VALID := TRUE;

// This is the one and only place that the A/B encoder values should be referenced!
IF pNVM4^.HMI_SINTS[BOOM_SWING_ENCODER_TYPE] = 1 THEN
	// Siko WV5800
	BOOM_SWING_ENCODER_STATUS := BOOM_SWING_ENCODER_B.CANopenState;
	BOOM_SWING_POS_RAW := TO_UDINT(pBOOM_SWING^.FEEDBACK.ROLLOVER_AT) - BOOM_SWING_POS_RAW_B;
ELSE
	// Default to IFM RM7012
	BOOM_SWING_ENCODER_STATUS := BOOM_SWING_ENCODER_A.CANopenState;
	BOOM_SWING_POS_RAW := BOOM_SWING_POS_RAW_A;
END_IF

(* ALWAYS begin in the actuator program by sampling the feedback and sending that into the motion system. *)
IF SIMULATION THEN
	POSITION_RAW := REAL_TO_DINT(pBOOM_SWING^.SETPOINT.POSITION_ENGR);
ELSE
	(* If no valid feedback is available and we are in automatic, don't run anything. *)
	VALID := (BOOM_SWING_ENCODER_STATUS = 5);
	POSITION_RAW := TO_DINT(BOOM_SWING_POS_RAW);
END_IF
Sampled(ADR(pBOOM_SWING^.FEEDBACK), POSITION_RAW, TIME_US, VALID);

(* Disallow automatic operation when feedback isn't working. *)
IF AUTOMATIC AND NOT VALID THEN
	disableActuator(pBOOM_SWING);
	RETURN;
END_IF

IF AUTOMATIC AND
	(
		(
			MACHINE_MODE = RWP_MODE AND
			(
				RWP_STATE = RWP_STATE_LOCATE_WP 
			)
		) OR
		(
			MACHINE_MODE = SCREW_MODE AND
			(
				SCREW_STATE = SCREW_STATE_INITIAL_ROTATE OR
				SCREW_STATE = SCREW_STATE_MAST_TO_VERTICAL OR
				SCREW_STATE = SCREW_STATE_MAST_TO_TARGET
			)
		)
	)
	THEN
	pBOOM_SWING^.LOOP_PID.SETTLED_BAND := 0.1;
ELSE
	pBOOM_SWING^.LOOP_PID.SETTLED_BAND := 0.2;
END_IF

CLOSED_LOOP := FALSE;
PROFILER := FALSE;

IF MACHINE_MODE = ERROR_MODE OR getEstopPressed() THEN
	(* This should always put zeros on the PWMs, and should be the first statement in this IF block. *)
	setOutput(ADR(pBOOM_SWING^.OUTPUT), 0, FALSE);
ELSIF MACHINE_NO_TOUCH OR VIS_TUNE_ENABLED THEN
	(* Don't touch anything; the operator cycles between states with a button, and we wait briefly
		after a state change in case the operator wants to skip a state. *)
	;
ELSIF GPS_AUTOTARGET_STATUS.GPS_USED_THIS_TRUSS AND GPS_AXES[GPS_Y].AUTOTARGET_ON AND AUTOMATIC AND AUTOMATIC_ALLOWED AND 
		(
			(
				(MACHINE_MODE = RWP_MODE) AND ( (RWP_STATE = RWP_STATE_WAIT_LEVEL) OR 
												(RWP_STATE = RWP_STATE_GPS_FAST_TARGET) OR
												(RWP_STATE = RWP_STATE_GPS_FINE_TARGET) OR
												(RWP_STATE = RWP_STATE_GPS_MANUAL_CYCLE) ) 
			)
			OR
			(	(MACHINE_MODE = SCREW_MODE) AND ( 	(SCREW_STATE = SCREW_STATE_GPS_FWP_RETURN_TO_WP) OR 
													(SCREW_STATE = SCREW_STATE_GPS_FWP_AUTOTARGET_GPS) OR 
													((SCREW_STATE = SCREW_STATE_INITIAL_ROTATE) AND (WP_HEIGHT_LATCH = WP_HIGH)) OR
													(SCREW_STATE = SCREW_STATE_NXT_TL_ADJUST AND NOT isNXTmotorThirdLeg_perLatch()) 	
												) 
			)
		)
	THEN
	
	IF GPS_TRUSS_CYCLE = GPS_FINE_SLOW_FEEDBACK_MOVE AND GPS_AUTOTARGET_ACTUATE THEN // only set reference first time
		TARGET_LAST := AXES[AXIS_BOOM_SWING].FEEDBACK.POSITION_ENGR; // set feedback profiler first step reference
	END_IF

	// execute movement
	IF GPS_TRUSS_CYCLE = GPS_FIRST_COARSE_MOVE THEN
		GPS_VEL := pNVM4^.GPS_GENERAL_SETTINGS[GPS_VELOCITY_FACTOR] * BOOM_SWING_VEL;
		GPS_ACCEL := 0.6 * pNVM4^.GPS_GENERAL_SETTINGS[GPS_ACCEL_FACTOR] * BOOM_SWING_ACCEL;
		TARGET_POS := GPS_AXES[GPS_Y].LOCKED_TARGET_POSITION;
	ELSIF GPS_TRUSS_CYCLE = GPS_SLOW_TRAPEZOID_MOVE THEN
		IF ((MACHINE_MODE = SCREW_MODE) AND (SCREW_STATE = SCREW_STATE_INITIAL_ROTATE)) THEN
			GPS_VEL := BOOM_SWING_VEL;
			GPS_ACCEL := BOOM_SWING_ACCEL;
		ELSE
			GPS_VEL := 0.3 * pNVM4^.GPS_GENERAL_SETTINGS[GPS_VELOCITY_FACTOR] * BOOM_SWING_VEL; // close so go super slow to minimize antenna bounce
			GPS_ACCEL := 0.1 * pNVM4^.GPS_GENERAL_SETTINGS[GPS_ACCEL_FACTOR] * BOOM_SWING_ACCEL;
		END_IF
		IF MACHINE_MODE = SCREW_MODE AND SCREW_STATE = SCREW_STATE_GPS_FWP_RETURN_TO_WP THEN
			TARGET_POS := BOOM_SWING_AT_WP;
		ELSE
			TARGET_POS := GPS_AXES[GPS_Y].FILTERED_TARGET_POSITION;
		END_IF
	ELSIF GPS_TRUSS_CYCLE = GPS_FINE_SLOW_FEEDBACK_MOVE THEN
		// close, so move slow to avoid instability
		GPS_VEL := 0.4 * GPS_TEST_VEL_FACTOR; // 0.5 * GPS_VEL;
		GPS_ACCEL := 0.2 * GPS_TEST_ACCEL_FACTOR; //0.5 * GPS_ACCEL;
		TARGET_POS := GPS_AXES[GPS_Y].FILTERED_TARGET_POSITION;	
	ELSIF GPS_TRUSS_CYCLE = GPS_FINISH_MOVE THEN
		TARGET_POS := AXES[GPS_AXES[GPS_Y].ACTUATOR_AXIS].FEEDBACK.POSITION_ENGR;
	END_IF
	TARGET_POS := MIN( MAX ( TARGET_POS, GPS_AXES[GPS_Y].AXIS_RANGE_MIN ), GPS_AXES[GPS_Y].AXIS_RANGE_MAX ); // limit target position to what is possible
	
	IF GPS_TRUSS_CYCLE = GPS_FIRST_COARSE_MOVE OR GPS_TRUSS_CYCLE = GPS_SLOW_TRAPEZOID_MOVE THEN
		IF isPauseRequested() THEN
			TrapezoidStop(ADR(pBOOM_SWING^.PROFILER), ADR(pBOOM_SWING^.SETPOINT), TIME_US, pBOOM_SWING^.CONFIG , pBOOM_SWING^.FEEDBACK);
		ELSIF GPS_AUTOTARGET_ACTUATE THEN // AND NOT GPS_YAW_AND_Y_SET THEN
			TrapezoidStart(ADR(pBOOM_SWING^.PROFILER), ADR(pBOOM_SWING^.SETPOINT), TIME_US, pBOOM_SWING^.FEEDBACK,
				TARGET_POS, GPS_VEL, GPS_ACCEL);
		END_IF
		CLOSED_LOOP := TRUE;
		PROFILER := TRUE;
	// close to target, so move slowly and smoothly
	ELSIF (GPS_TRUSS_CYCLE = GPS_FINE_SLOW_FEEDBACK_MOVE) OR (GPS_TRUSS_CYCLE = GPS_FINISH_MOVE) THEN
		IF isPauseRequested() OR (GPS_TRUSS_CYCLE = GPS_FINISH_MOVE) OR (NOT GPS_READY) THEN
			setOutput(ADR(pBOOM_SWING^.OUTPUT), 0, FALSE);
		ELSE
			// use actual target for vff term, use ddt target to limit feedback term to desired max vel
			setVelAccel(TARGET_POS, pBOOM_SWING^.FEEDBACK.POSITION_ENGR,
				//4 * GPS_AXES[GPS_Y].TARGET_LIMIT, 0.4 * GPS_AXES[GPS_Y].TARGET_LIMIT, 0.5 * GPS_VEL, 0.5 * GPS_ACCEL, ADR(VEL), ADR(ACCEL));;
				//1.0, 0.1, GPS_VEL, GPS_ACCEL, ADR(VEL), ADR(ACCEL)); // let ddt set the vel profile
				2.0, 0.05, GPS_VEL, GPS_ACCEL, ADR(VEL), ADR(ACCEL)); // let ddt set the vel profile
			TARGET_POS := ddt(TARGET_POS, TARGET_LAST, GPS_VEL);
			TARGET_LAST := TARGET_POS;
			SetpointInit(ADR(pBOOM_SWING^.SETPOINT), pBOOM_SWING^.FEEDBACK, TARGET_POS, VEL, ACCEL);
			CLOSED_LOOP := TRUE;
		END_IF
	ELSIF GPS_TRUSS_CYCLE = GPS_NO_MOVE THEN
			pBOOM_SWING^.OUTPUT.MAGNITUDE := 0;
			pBOOM_SWING^.OUTPUT.POSITIVE := FALSE;
	END_IF	
ELSIF AUTOMATIC AND AUTOMATIC_ALLOWED AND
		(
			(MACHINE_MODE = RWP_MODE AND RWP_STATE = RWP_STATE_LOCATE_WP) OR
			(MACHINE_MODE = SCREW_MODE AND SCREW_STATE = SCREW_STATE_FWP) OR
			(MACHINE_MODE = SCREW_MODE AND SCREW_STATE = SCREW_STATE_ASSEMBLE)
		) AND
		(xyzTrueMotion_01.STATE = eXyzTrueMotionStates.POSITION_X OR xyzTrueMotion_01.STATE = eXyzTrueMotionStates.POSITION_Y)
	THEN
	IF GPS_AUTOTARGET_STATUS.GPS_USED_THIS_TRUSS THEN
		GPS_FINE_TUNE_SLOWDOWN_FACTOR := 0.3;
	ELSE
		GPS_FINE_TUNE_SLOWDOWN_FACTOR := 1.0;
	END_IF
	SetpointInit(ADR(pBOOM_SWING^.SETPOINT), pBOOM_SWING^.FEEDBACK,
		xyzTrueMotion_01.BOOM_SWING_POS_SETPOINT,
		xyzTrueMotion_01.BOOM_SWING_VEL_SETPOINT * GPS_FINE_TUNE_SLOWDOWN_FACTOR,
		0);
	CLOSED_LOOP := TRUE;
	
ELSIF (NOT AUTOMATIC AND MACHINE_MODE = RWP_MODE) OR
	(AUTOMATIC AND AUTOMATIC_ALLOWED AND MACHINE_MODE = RWP_MODE AND 
				( (RWP_STATE = RWP_STATE_SQUARE_YAW) OR (RWP_STATE = RWP_STATE_LOCATE_WP AND GPS_AUTOTARGET_STATUS.GPS_USED_THIS_TRUSS) )
	)
	THEN
	
	IF nearHardStop(pBOOM_SWING^, JS := REMOTE.LJ_LR, JS_POS_IS_OUTPUT_POS := TRUE) THEN
		OUTPUT_MAX := protectHardStop(pBOOM_SWING^);
	ELSE
		(* Normal jogging. *)
		OUTPUT_MAX := pBOOM_SWING^.CONFIG.MANUAL_OUTPUT_MAX;
	END_IF

	IF AXES[AXIS_PITCH].FEEDBACK.POSITION_ENGR > 75.0 THEN
		(* Protect machine when pitch is down very low. *)
		OUTPUT_MAX := MIN(OUTPUT_MAX, pBOOM_SWING^.CONFIG.MANUAL_OUTPUT_MAX / 3);
	ELSIF (AUTOMATIC OR BUMP) THEN
		(* Better control when in RWP. *)
		OUTPUT_MAX := MIN(OUTPUT_MAX, pBOOM_SWING^.CONFIG.MANUAL_OUTPUT_MAX / 5);
	END_IF
	
	JOYSTICK_01(JS := REMOTE.LJ_LR, JS_POS_IS_OUTPUT_POS := TRUE, 
		FILTER := FALSE, OUTMAX := OUTPUT_MAX,
		MAG => pBOOM_SWING^.OUTPUT.MAGNITUDE, POSITIVE => pBOOM_SWING^.OUTPUT.POSITIVE);
	
	IF GPS_AUTOTARGET_STATUS.GPS_USED_THIS_TRUSS AND (RWP_STATE <> RWP_STATE_MANUAL) AND GPS_AXES[GPS_Y].AUTOTARGET_ON THEN 
		pBOOM_SWING^.OUTPUT.MAGNITUDE := pBOOM_SWING^.OUTPUT.MAGNITUDE / 2;// near target already, slow down for more precise control
	END_IF
ELSIF AUTOMATIC AND AUTOMATIC_ALLOWED AND
		((MACHINE_MODE = TRACK_MODE AND TRACK_STATE = TRACK_STATE_NORMAL) OR
		(MACHINE_MODE = RWP_MODE AND RWP_STATE = RWP_STATE_WAIT_LEVEL))
	THEN

	TARGET_POS := 0;

	IF isTrackModeStateChange() OR isRwpModeStateChange() OR isContinueRequested() THEN
		TrapezoidStart(ADR(pBOOM_SWING^.PROFILER), ADR(pBOOM_SWING^.SETPOINT), TIME_US, pBOOM_SWING^.FEEDBACK,
			TARGET_POS, BOOM_SWING_VEL, BOOM_SWING_ACCEL);
	ELSIF isPauseRequested() THEN
		TrapezoidStop(ADR(pBOOM_SWING^.PROFILER), ADR(pBOOM_SWING^.SETPOINT), TIME_US, pBOOM_SWING^.CONFIG , pBOOM_SWING^.FEEDBACK);
	END_IF
	CLOSED_LOOP := TRUE;
	PROFILER := TRUE;
ELSIF AUTOMATIC AND AUTOMATIC_ALLOWED AND (isNXTmotorThirdLeg_perLatch() OR (WP_HEIGHT_LATCH = WP_HIGH)) AND
	(
		MACHINE_MODE = SCREW_MODE AND
		(
			(SCREW_STATE = SCREW_STATE_INITIAL_ROTATE AND NOT GPS_AUTOTARGET_STATUS.GPS_USED_THIS_TRUSS) OR
			SCREW_STATE = SCREW_STATE_MAST_TO_VERTICAL OR
			(SCREW_STATE = SCREW_STATE_MAST_TO_TARGET AND NOT GPS_AUTOTARGET_STATUS.GPS_USED_THIS_TRUSS)
		)
	)
	THEN
	TARGET_POS := BOOM_SWING_AT_WP;
	// deprecated
	
	// When installing the NXT three legged motor, we are moving the X slide in screw drive on EW screws.  So when doing
	//	the initial rotate, we need to return to the loading position, and when we move into the screw drive state, we need
	//	to compensate for the boom swing moving to get Y in the right position.
	
// 	IF SCREW_STATE = SCREW_STATE_INITIAL_ROTATE OR SCREW_STATE = SCREW_STATE_MAST_TO_VERTICAL THEN
// 		TARGET_POS := BOOM_SWING_AT_WP;
// 	ELSE
// 		// EW screws of the NXT 3rd leg motor.  The workpoint for these trusses is above the torque tube.
// 		//	To compensate, we move the rotator left/right to get it aligned with the screw path.  When this
// 		//	motion happens, a machine with track base not flat in roll will pollute this.  Compensate here.
// 		IF SCREW_SIDE_LATCH = eScrewSide.SCREW_LEFT THEN
// 			TARGET_POS := NXT_3LM_BOOM_SWING_LEFT;
// 		ELSE
// 			TARGET_POS := NXT_3LM_BOOM_SWING_RIGHT;
// 		END_IF
// 	END_IF
	
	IF isScrewModeStateChange() OR isContinueRequested() THEN
		TrapezoidStart(ADR(pBOOM_SWING^.PROFILER), ADR(pBOOM_SWING^.SETPOINT), TIME_US, pBOOM_SWING^.FEEDBACK,
			TARGET_POS, BOOM_SWING_VEL, BOOM_SWING_ACCEL);
	ELSIF isPauseRequested() THEN
		(* Stop what we are doing. *)
		TrapezoidStop(ADR(pBOOM_SWING^.PROFILER), ADR(pBOOM_SWING^.SETPOINT), TIME_US, pBOOM_SWING^.CONFIG ,pBOOM_SWING^.FEEDBACK);
	END_IF

	(* Prepare to run the control loop. *)
	PROFILER := TRUE;
	CLOSED_LOOP := TRUE;
ELSIF AUTOMATIC AND AUTOMATIC_ALLOWED AND
		(MACHINE_MODE = SCREW_MODE AND
		SCREW_SIDE_LATCH <> SCREW_CENTER AND
		WP_HEIGHT_LATCH = WP_LOW AND
			(SCREW_STATE = SCREW_STATE_MAST_TO_TARGET OR
			SCREW_STATE = SCREW_STATE_MAST_TO_VERTICAL)
		)
	THEN
	(* TODO: low workpoint mode!!! *)
	IF SCREW_STATE = SCREW_STATE_MAST_TO_TARGET THEN
		(* Getting ready to screw. *)
		TARGET_POS := BOOM_SWING_SCREW;
	ELSE
		(* Return to vertical. *)
		TARGET_POS := BOOM_SWING_AT_WP;
	END_IF

	IF isScrewModeStateChange() OR isContinueRequested() THEN
		TrapezoidStart(ADR(pBOOM_SWING^.PROFILER), ADR(pBOOM_SWING^.SETPOINT), TIME_US, pBOOM_SWING^.FEEDBACK,
			TARGET_POS, BOOM_SWING_VEL, BOOM_SWING_ACCEL);
	ELSIF isPauseRequested() THEN
		TrapezoidStop(ADR(pBOOM_SWING^.PROFILER), ADR(pBOOM_SWING^.SETPOINT), TIME_US, pBOOM_SWING^.CONFIG , pBOOM_SWING^.FEEDBACK);
	END_IF
	CLOSED_LOOP := TRUE;
	PROFILER := TRUE;
ELSE
	pBOOM_SWING^.OUTPUT.MAGNITUDE := 0;
	pBOOM_SWING^.OUTPUT.POSITIVE := FALSE;
END_IF

IF NOT MACHINE_NO_TOUCH AND NOT VIS_TUNE_ENABLED THEN
	IF CLOSED_LOOP THEN
		IF PROFILER THEN
			TrapezoidRun(ADR(pBOOM_SWING^.PROFILER), ADR(pBOOM_SWING^.SETPOINT), TIME_US);
		END_IF
	
		LoopPID(ENABLE := TRUE, pLOOP := ADR(pBOOM_SWING^.LOOP_PID), pOUTPUT := ADR(pBOOM_SWING^.OUTPUT), SP := pBOOM_SWING^.SETPOINT, FB:= pBOOM_SWING^.FEEDBACK, CFG := pBOOM_SWING^.CONFIG,
			I_ENABLED := (pBOOM_SWING^.PROFILER.STATE = HOLD));
	ELSE
		pBOOM_SWING^.SETPOINT.POSITION_ENGR := pBOOM_SWING^.FEEDBACK.POSITION_ENGR;
		pBOOM_SWING^.SETPOINT.POSITION_RAW := pBOOM_SWING^.FEEDBACK.POSITION_RAW;
	END_IF

	HaweOutput(pBOOM_SWING);
END_IF