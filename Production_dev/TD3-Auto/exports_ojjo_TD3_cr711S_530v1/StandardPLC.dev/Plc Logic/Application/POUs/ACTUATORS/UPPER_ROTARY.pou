
(********************** Declaration ****************************)
FUNCTION_BLOCK UPPER_ROTARY
VAR_INPUT
	INIT: BOOL;
	pUPPER_ROTARY: POINTER TO sAxis;
	TIME_US: DWORD;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	INC_ENC_01: ifmFastInput.IncEncoder;
	CLOSED_LOOP: BOOL;
	JOYSTICK_01: joystickToJogOutput;
	DRILL_ON: BOOL := FALSE;
	DRILL_FWD: BOOL := TRUE;
	DRILL_ON_MANUAL: BOOL := FALSE;

	LAST_AUTO: BOOL := FALSE;
	
	FWD_DIAG: ifmTypes.DIAG_INFO;
	REV_DIAG: ifmTypes.DIAG_INFO;
	FWD_CMD: BOOL;
	REV_CMD: BOOL;
	FWD_ERROR: BOOL;
	REV_ERROR: BOOL;
	FWD_ACTIVATED: BOOL;
	REV_ACTIVATED: BOOL;
	FWD_PREPARED: BOOL;
	REV_PREPARED: BOOL;

	MAGNITUDE: WORD;
	POSITIVE: BOOL;

	PWM_OUTPUT: HawePSVPwmOutput;
END_VAR
(********************** Implementation ****************************)
(* The upper rotary is running anytime screwing is being done.  There is not an encoder, so this
	is not really an axis! *)

IF MACHINE_MODE <> SCREW_MODE THEN
	DRILL_ON_MANUAL := FALSE;
	DRILL_ON := FALSE;
ELSIF AUTOMATIC AND NOT LAST_AUTO THEN
	(* When we go from manual to automatic, we want to clear the flag that says the drill is on in manual.  Otherwise,
		next time we go into manual the drill will turn on immediately. *)
	DRILL_ON_MANUAL := FALSE;
END_IF;
LAST_AUTO := AUTOMATIC;

IF MACHINE_MODE = ERROR_MODE OR getEstopPressed() THEN
	(* This should always put zeros on the PWMs, and should be the first statement in this IF block. *)
	setOutput(ADR(pUPPER_ROTARY^.OUTPUT), 0, FALSE);
	DRILL_ON := FALSE;
ELSIF MACHINE_NO_TOUCH THEN
	(* Don't touch anything; the operator cycles between states with a button, and we wait briefly
		after a state change in case the operator wants to skip a state. *)
	;
ELSIF MACHINE_MODE = IDLE_MODE OR MACHINE_MODE = SETUP_MODE OR MACHINE_MODE = RWP_MODE OR MACHINE_MODE = FWP_MODE THEN
	(* Don't run upper rotary in this case.  Set outputs to 0. *)
	setOutput(ADR(pUPPER_ROTARY^.OUTPUT), 0, FALSE);
	DRILL_ON := FALSE;
ELSIF MACHINE_MODE = SCREW_MODE AND
		(NOT AUTOMATIC OR
		SCREW_STATE = SCREW_STATE_POSITION_MAST_SLIDE OR
		SCREW_STATE = SCREW_STATE_PRELOAD_COMPLIANCE OR
		SCREW_STATE = SCREW_STATE_DRIVE_ASSIST OR
		SCREW_STATE = SCREW_STATE_DRIVE_SCREW OR
		SCREW_STATE = SCREW_STATE_UNLOAD_SCREW OR
		SCREW_STATE = SCREW_STATE_RETRACT_AFTER_DRIVE OR
		SCREW_STATE = SCREW_STATE_DRILL_AHEAD OR
		SCREW_STATE = SCREW_STATE_DRILL_REVERSE OR
		SCREW_STATE = SCREW_STATE_DRILL_RETURN OR
		SCREW_STATE = SCREW_STATE_DRILL_EXTEND OR
		SCREW_STATE = SCREW_STATE_DRILL_TO_SCREW_END OR
		SCREW_STATE = SCREW_STATE_LC_REWIND OR
		SCREW_STATE = SCREW_STATE_RELIEVE_SPOILS_PRESSURE OR
		SCREW_STATE = SCREW_STATE_CLEAR_SPOILS)
	THEN

	IF (NOT AUTOMATIC) OR
		(AUTOMATIC AND AUTOMATIC_ALLOWED AND SCREW_STATE = SCREW_STATE_DRIVE_ASSIST) THEN
		IF REMOTE.RTCB1_UP_RE THEN
			DRILL_ON_MANUAL := TRUE;
		ELSIF REMOTE.RTCB1_DN_RE THEN
			DRILL_ON_MANUAL := FALSE;
		END_IF
	ELSE
		DRILL_ON_MANUAL := FALSE;
	END_IF

	(* Screw drive has provision to run the drill reverse at times. Default is run forward. *)
	DRILL_FWD := TRUE;

	IF AUTOMATIC AND AUTOMATIC_ALLOWED AND MACHINE_MODE = SCREW_MODE AND
		(
			//(SCREW_STATE = SCREW_STATE_DRIVE_SCREW OR SCREW_STATE = SCREW_STATE_UNLOAD_SCREW) AND
			//(NOT UPPER_CROWD_REVEALING AND NOT UPPER_CROWD_DONE_REVEALING)
			(SCREW_STATE = SCREW_STATE_DRIVE_SCREW OR SCREW_STATE = SCREW_STATE_UNLOAD_SCREW)
			AND (
				(NOT UPPER_CROWD_REVEALING AND NOT UPPER_CROWD_DONE_REVEALING)
				// We want to run the rotary while inside the screw to make spoils come out easier.				
				OR (
					(UPPER_CROWD_REVEALING OR UPPER_CROWD_DONE_REVEALING) AND
					(DRILL_TIP_BELOW_CHUCK > pNVM1^.DRILL_BIT_LENGTH - pNVM1^.DRILL_BIT_THREAD_LENGTH)
				)
			)
		) THEN
			DRILL_ON := TRUE;
	ELSIF
		(
		DRILL_ON_MANUAL OR
		SCREW_STATE = SCREW_STATE_POSITION_MAST_SLIDE OR
		SCREW_STATE = SCREW_STATE_PRELOAD_COMPLIANCE OR
		SCREW_STATE = SCREW_STATE_DRILL_REVERSE OR
		SCREW_STATE = SCREW_STATE_DRILL_AHEAD OR
		SCREW_STATE = SCREW_STATE_DRILL_RETURN OR
		SCREW_STATE = SCREW_STATE_DRILL_EXTEND OR
		SCREW_STATE = SCREW_STATE_DRILL_TO_SCREW_END OR
		SCREW_STATE = SCREW_STATE_LC_REWIND OR
		SCREW_STATE = SCREW_STATE_RELIEVE_SPOILS_PRESSURE OR
		SCREW_STATE = SCREW_STATE_CLEAR_SPOILS
		// When adding a state here, it needs to be added above to the outer IF statement, as well!!
		) THEN
		DRILL_ON := TRUE;
	ELSE
		DRILL_ON := FALSE;
	END_IF

	IF DRILL_ON THEN
		IF DRILL_FWD THEN
			pUPPER_ROTARY^.OUTPUT.MAGNITUDE := 1000;
			pUPPER_ROTARY^.OUTPUT.POSITIVE := TRUE;
		ELSE
			pUPPER_ROTARY^.OUTPUT.MAGNITUDE := 500;
			pUPPER_ROTARY^.OUTPUT.POSITIVE := FALSE;
		END_IF
	ELSE
		pUPPER_ROTARY^.OUTPUT.MAGNITUDE := 0;
		pUPPER_ROTARY^.OUTPUT.POSITIVE := FALSE;
	END_IF
ELSE
	(* Upper rotary off in other circumstances. *)
	pUPPER_ROTARY^.OUTPUT.MAGNITUDE := 0;
	pUPPER_ROTARY^.OUTPUT.POSITIVE := FALSE;
END_IF

// stop/prevent rotary motion and shutdown machine if operator detected in rotary exclusion zone
IF (isRotaryActive() AND NOT isRotaryMotionAllowed()) OR
	ROTARY_DESIRED_AND_PROXIMITY_VIOLATED THEN
	ROTARY_DESIRED_AND_PROXIMITY_VIOLATED := TRUE;
	setOutput(ADR(pUPPER_ROTARY^.OUTPUT), 0, FALSE);
END_IF

IF NOT MACHINE_NO_TOUCH AND NOT VIS_TUNE_ENABLED THEN
	IF CLOSED_LOOP THEN
		;
	ELSE
		pUPPER_ROTARY^.SETPOINT.POSITION_ENGR := pUPPER_ROTARY^.FEEDBACK.POSITION_ENGR;
		pUPPER_ROTARY^.SETPOINT.POSITION_RAW := pUPPER_ROTARY^.FEEDBACK.POSITION_RAW;
	END_IF

	IF pUPPER_ROTARY^.OUTPUT.MAGNITUDE <> 0 THEN
		IF pUPPER_ROTARY^.OUTPUT.POSITIVE THEN
			FWD_CMD := TRUE;
			REV_CMD := FALSE;
		ELSE
			FWD_CMD := FALSE;
			REV_CMD := TRUE;
		END_IF
	ELSE
		FWD_CMD := FALSE;
		REV_CMD := FALSE;
	END_IF

	// Only respect forces when not in automatic.
	IF NOT AUTOMATIC THEN
		IF UPPER_ROTARY_FWD_FORCE.FORCED THEN
			FWD_CMD := UPPER_ROTARY_FWD_FORCE.DOUT_STATE;
			REV_CMD := FALSE;
		ELSIF UPPER_ROTARY_REV_FORCE.FORCED THEN
			FWD_CMD := FALSE;
			REV_CMD := UPPER_ROTARY_REV_FORCE.DOUT_STATE;
		END_IF
	END_IF
	
	IF FWD_CMD THEN
		POSITIVE := TRUE;
		MAGNITUDE := pNVM2^.UPPER_ROTARY_FWD_SPEED * 10;
	ELSIF REV_CMD THEN
		POSITIVE := FALSE;
		MAGNITUDE := pNVM2^.UPPER_ROTARY_REV_SPEED * 10;
	ELSE
		POSITIVE := FALSE;
		MAGNITUDE := 0;
	END_IF

	SetOutput(ADR(AXES[AXIS_UPPER_ROTARY].OUTPUT), MAGNITUDE, POSITIVE);
	HaweOutput(ADR(AXES[AXIS_UPPER_ROTARY]));

END_IF
