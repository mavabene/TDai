
(********************** Declaration ****************************)
FUNCTION setRwpModeState : BOOL
VAR_INPUT
	NEW_STATE: eRWPStates;
END_VAR
VAR
END_VAR
(********************** Implementation ****************************)
setState(TO_WORD(NEW_STATE), ADR(RWP_STATE), ADR(RWP_MODE_STATE_CHANGE));
DEBUG_SUBSTATE := RWP_STATE_NAMES[NEW_STATE];
setWaitingStrings('Nothing', 'Nothing');

(* Monitors across states not supported! *)
confirmMonitorStop();
f2MonitorStop();