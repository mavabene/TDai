
(********************** Declaration ****************************)
FUNCTION_BLOCK checkWarnings
VAR_INPUT
END_VAR
VAR_OUTPUT
	MW: BOOL;
END_VAR
VAR
	valveFailed_01: valveFailed;
	axisRange_01: axisRange;
	ANY_AXIS_RANGE: BOOL := FALSE;
	// delay warning due to Hawe valve failure so valve can have time to recover
	VALVE_FAIL_WARNING_DELAY: TON;
END_VAR
(********************** Implementation ****************************)

MW := FALSE;
WARNING_CURRENT := 0;

IF TIME_SECONDS < 30 THEN
	(* Wait for a few seconds for the remote, the CanBus, etc. to come up. *)
	WARNING_LATCH := 0;
ELSE
	valveFailed_01(FAILED => ANY_VALVE_FAILED);
	VALVE_FAIL_WARNING_DELAY(IN := ANY_VALVE_FAILED, PT := T#1.5S);
	
	axisRange_01(FAILED => ANY_AXIS_RANGE);
		
	(* Yellow light for warnings like overturning warning, pressure and temperatures out of acceptable ranges. *)
	IF (
			(AXES[AXIS_PITCH].FEEDBACK.POSITION_ENGR >= PITCH_FWD_WARNING) OR
			(AXES[AXIS_PITCH].FEEDBACK.POSITION_ENGR <= PITCH_BACK_WARNING)
		) AND 
		(NOT (MACHINE_MODE = SETUP_MODE OR MACHINE_MODE = ERROR_MODE OR MACHINE_MODE = IDLE_MODE)) THEN
		MW := TRUE;
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.PITCH);
	END_IF
	
	IF AXES[AXIS_LOWER_CROWD].FEEDBACK.POSITION_ENGR >= LOWER_CROWD_UP_WARNING THEN
		MW := TRUE;
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.LOWER_CROWD);
	END_IF
	
	IF ABS(BASE_ROLL_FILTERED_SLOW > BASE_ROLL_WARNING) THEN
		MW := TRUE;
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.BASE_ROLL);
	END_IF
	
	IF ABS(BASE_PITCH_FILTERED_SLOW > BASE_PITCH_WARNING) THEN
		MW := TRUE;
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.BASE_PITCH);
	END_IF
	
	IF DRIFTER_TO_TOP < DRIFTER_TO_TOP_WARNING THEN
		MW := TRUE;
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.DRIFTER_TO_TOP);
	END_IF
	
	IF PUMP_PRESSURE < PUMP_PRESSURE_WARNING THEN
		MW := TRUE;
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.PUMP1_PRESSURE);
	END_IF
	
	IF REMOTE.LOW_VOLTAGE THEN
		MW := TRUE;
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.REMOTE_BATTERY);
	END_IF
	
	//IF ANY_VALVE_FAILED THEN
	IF VALVE_FAIL_WARNING_DELAY.Q THEN
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.ANY_VALVE);
	END_IF
	
	IF ANY_AXIS_RANGE THEN
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.ANY_AXIS_RANGE);
	END_IF
		
	IF TRACK_HIGH_SPEED THEN
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.TRACK_HIGH_SPEED);
	END_IF
		
	IF HYDRAULIC_TEMP > HYDRAULIC_TEMP_WARNING THEN
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.HYDRAULIC_TEMPERATURE);
	END_IF
		
	IF aiInput1Err OR aiInput2Err OR aiInput3Err OR aiInput4Err OR aiInput5Err OR aiInput6Err OR aiInput7Err OR aiInput8Err THEN
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.REMOTE_ERROR);
	END_IF

	IF ABS(AXES[AXIS_ROTATOR].FEEDBACK.POSITION_ENGR) > ROTATOR_WARNING THEN
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.ROTATOR);
	END_IF
	
	IF COMPRESSOR_WARNING THEN
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.COMPRESSOR);
	END_IF
	
	// removed per Steve - we are lowering pressures below these limits to reduce twizzling, and we can see data in reports
// 	IF UR_MOTOR_WARNING THEN
// 		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.UR_MOTOR);
// 	END_IF
// 	
// 	IF LC_MOTOR_WARNING THEN
// 		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.LC_MOTOR);
// 	END_IF
	
	IF pNVM4^.HMI_BOOLS[SCREW_PARAMS_SOURCE_IS_PNEZD] AND (NOT SCREW_PARAMETERS_D_VALID) AND (MACHINE_MODE = SCREW_MODE) THEN
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.PNEZD_D_INVALID);
	END_IF
	
	IF PROXIMITY_SENSOR_WARNING THEN
		WARNING_CURRENT := WARNING_CURRENT OR TO_DWORD(eWarningCauseMask.PROXIMITY_SENSOR_FAILED);
	END_IF
	
	// Must be at the end!
	WARNING_LATCH := WARNING_LATCH OR WARNING_CURRENT;
END_IF
