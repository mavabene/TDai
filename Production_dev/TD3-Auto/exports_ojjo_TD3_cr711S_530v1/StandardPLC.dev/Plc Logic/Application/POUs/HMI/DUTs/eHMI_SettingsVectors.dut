
(********************** Declaration ****************************)
(* 	These var names correlate to HMI_VECTORS array values.  
	To add persistent Vectors, just add name here and call via HMI_VECTORS[ENUM_NAME]
	!! If you change positions, persistent memory will be affected! !!
	** Updates here must be made in both PLC and HMI code **
*)
TYPE eHMI_SettingsVectors :
(
	(* We calibrate to the desired array truss location, with wp (side leg axes intersection) at COR (Center of Rotator on Z slide) and pin location at the PNEZD pin reference point.
	Motors may sit in the truss cap holder differently, depending on design. This would result in either motor wp not being at COR and/or motor pin not being at the PNEZD reference.
	*)
	NXT_VAR_THIRD_LEG_WP_OFFSET := 1,
	NXT_VAR_MOTOR_SIDE_LEG_WP_OFFSET := 2,
	NXT_VAR_STD_TRUSS_OFFSET := 3,
	NXT_VAR_MOTOR_CRIMP_OFFSET := 4,
	eHMI_SettingsVectors_RESERVED_5 := 5,
	eHMI_SettingsVectors_RESERVED_6 := 6,
	eHMI_SettingsVectors_RESERVED_7 := 7,
	eHMI_SettingsVectors_RESERVED_8 := 8,
	eHMI_SettingsVectors_RESERVED_9 := 9,
	eHMI_SettingsVectors_RESERVED_10 := 10,
	eHMI_SettingsVectors_RESERVED_11 := 11,
	eHMI_SettingsVectors_RESERVED_12 := 12,
	eHMI_SettingsVectors_RESERVED_13 := 13,
	eHMI_SettingsVectors_RESERVED_14 := 14,
	eHMI_SettingsVectors_RESERVED_15 := 15,
	eHMI_SettingsVectors_RESERVED_16 := 16,
	eHMI_SettingsVectors_RESERVED_17 := 17,
	eHMI_SettingsVectors_RESERVED_18 := 18,
	eHMI_SettingsVectors_RESERVED_19 := 19,
	eHMI_SettingsVectors_RESERVED_20 := 20
);
END_TYPE
