
(********************** Declaration ****************************)
FUNCTION calcDrillBitValues : BOOL
VAR_INPUT
END_VAR
VAR
END_VAR

(********************** Implementation ****************************)
UPPER_CROWD_UP_LIMIT := pNVM1^.UPPER_CROWD_DRILL_STEEL + pNVM1^.CHUCK_TO_BUSHING - pNVM1^.DRILL_BIT_THREAD_LENGTH  - UPPER_CROWD_ACCURACY;
UPPER_CROWD_TRACK_POS := pNVM1^.UPPER_CROWD_DRILL_STEEL + (pNVM1^.DRILL_BIT_LENGTH - pNVM1^.DRILL_BIT_THREAD_LENGTH) - (pNVM1^.CHUCK_TO_BIT_TIP_TRAVEL - UPPER_CROWD_ACCURACY);
IF UPPER_CROWD_TRACK_POS > UPPER_CROWD_UP_LIMIT THEN
	UPPER_CROWD_TRACK_POS := UPPER_CROWD_UP_LIMIT;
END_IF
