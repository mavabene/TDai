
(********************** Declaration ****************************)
FUNCTION_BLOCK interpretReceiveHmiVars

VAR_INPUT
	INIT				: BOOL;
END_VAR

VAR_OUTPUT
END_VAR

VAR
	DEBUG_LC_STALL_COUNT: DWORD := 0;
	DEBUG_UR_STALL_COUNT: DWORD := 0;
	DEBUG_HARD_SOIL_COUNT: DWORD := 0;
	HMI_WATCHDOG_LAST: DWORD := 0;
	HMI_LOST: BOOL := FALSE;
	HMI_WATCHDOG_TON: TON;
	HMI_WATCHDOG_START: DWORD := 0;
	HMI_WATCHDOG_DELTA: DWORD;
	
	SERIAL_ZERO: BOOL := FALSE;
	LAST_SET_OPERATOR_BREAK: BOOL := FALSE;
	LAST_TRIGGER_BITMASK: DWORD := 0;
	AFTER_POWERUP: BOOL := TRUE;
	DI_TMP: DINT;
	R_TRIG_Z_SLIDE_ENCODER_CAL			: R_TRIG;
	R_TRIG_X_SLIDE_ENCODER_CAL			: R_TRIG;
	R_TRIG_MAST_SLIDE_ENCODER_CAL		: R_TRIG;
	R_TRIG_YAW_ENCODER_CAL				: R_TRIG;
	R_TRIG_BOOM_SWING_ENCODER_CAL		: R_TRIG;
	R_TRIG_LOWER_CROWD_ENCODER_CAL		: R_TRIG;
	R_TRIG_UPPER_CROWD_ENCODER_CAL		: R_TRIG;
	R_TRIG_BOOM_LIFT_ENCODER_CAL		: R_TRIG;
	R_TRIG_JOINT_LIFT_ENCODER_CAL		: R_TRIG;
	CALIBRATE_Z_SLIDE_ENCODER			: BOOL;
	CALIBRATE_X_SLIDE_ENCODER			: BOOL;
	CALIBRATE_MAST_SLIDE_ENCODER		: BOOL;
	CALIBRATE_YAW_ENCODER				: BOOL;
	CALIBRATE_BOOM_SWING_ENCODER		: BOOL;
	CALIBRATE_LOWER_CROWD_ENCODER		: BOOL;
	CALIBRATE_UPPER_CROWD_ENCODER		: BOOL;
	CALIBRATE_BOOM_LIFT_ENCODER			: BOOL;
	CALIBRATE_JOINT_LIFT_ENCODER		: BOOL;
	Index								: UINT;
	LATCH_RESET_REQUEST_LAST: INT := 0;
	
	LAST_GPS_CUSTOM_SCREW_PARAMS_FILE_NUM: USINT := 0;
	SCREW_PARAMS_DISPLAY_INDEX_LAST: USINT := 0;
	SCREW_PARAMS_SOURCE_LAST: BOOL := FALSE;
	SET_NXT_DIMS_NEXT_CYCLE: BOOL := FALSE;
	
END_VAR
(********************** Implementation ****************************)

// Monitor whether we have lost the HMI...
IF HMI_WATCHDOG > HMI_WATCHDOG_LAST THEN
	// Incoming packet from HMI has updated the watchdog count.  Reset the on-delay timer.
	HMI_WATCHDOG_LAST := HMI_WATCHDOG;
	HMI_WATCHDOG_START := MSTIME;
	HMI_WATCHDOG_TON(IN := FALSE, PT := T#1S, Q => HMI_LOST);
ELSIF HMI_WATCHDOG < HMI_WATCHDOG_LAST THEN
	// Watchdog has gone DOWN, other side must have rebooted.
	HMI_LOST := TRUE;
ELSE
	// Incoming count from HMI has not changed.  If this doesn't change for 2 seconds, we consider the HMI gone and
	//	restart the data synchronization from scratch.
	HMI_WATCHDOG_DELTA := MSTIME - HMI_WATCHDOG_START;
	IF HMI_WATCHDOG_DELTA > HMI_WATCHDOG_MAX AND HMI_WATCHDOG_START <> 0 THEN
		HMI_WATCHDOG_MAX := HMI_WATCHDOG_DELTA;
	END_IF
// 	IF HMI_WATCHDOG_START <> 0 THEN
		HMI_WATCHDOG_TON(IN := TRUE, PT := T#1S, Q => HMI_LOST);
// 	END_IF
END_IF

IF HMI_LOST THEN
	// HMI has gone away for 2 seconds.  In the event the HMI has rebooted, we need to reset our flags that let us
	//	know the data connection between the PLC and HMI has been lost.
	HMI_HAS_VALID_DATA := FALSE;
	HMI_COMPLETE_SYNCH := FALSE;

	// add HMI_RECEIVED_PLC_DATA_1-7 := FALSE (latching behaviour)
	HMI_PLC_SYNCH_1_TOP := FALSE;
	HMI_PLC_SYNCH_2_TOP := FALSE;
	HMI_PLC_SYNCH_3_TOP := FALSE;
	HMI_PLC_SYNCH_5_TOP := FALSE;
	HMI_PLC_SYNCH_6_TOP := FALSE;
	HMI_PLC_SYNCH_7_TOP := FALSE;
	HMI_PLC_SYNCH_1_BOTTOM := FALSE;
	HMI_PLC_SYNCH_2_BOTTOM := FALSE;
	HMI_PLC_SYNCH_3_BOTTOM := FALSE;
	HMI_PLC_SYNCH_5_BOTTOM := FALSE;
	HMI_PLC_SYNCH_6_BOTTOM := FALSE;
	HMI_PLC_SYNCH_7_BOTTOM := FALSE;
END_IF

IF NOT HMI_HAS_VALID_DATA THEN
	(* If the HMI has just rebooted and does not have data from the PLC yet, we want to ignore what
		we hear from the HMI.  If this code is not here, values on the HMI that have defaults that
		aren't what the PLC is using may be overwritten! *)
	RETURN;
END_IF

HMI_PLC_SYNCH_1_TOP := TRUE;
HMI_PLC_SYNCH_2_TOP := TRUE;
HMI_PLC_SYNCH_3_TOP := TRUE;
HMI_PLC_SYNCH_5_TOP := TRUE;
HMI_PLC_SYNCH_6_TOP := TRUE;
HMI_PLC_SYNCH_7_TOP := TRUE;
HMI_PLC_SYNCH_1_BOTTOM := TRUE;
HMI_PLC_SYNCH_2_BOTTOM := TRUE;
HMI_PLC_SYNCH_3_BOTTOM := TRUE;
HMI_PLC_SYNCH_5_BOTTOM := TRUE;
HMI_PLC_SYNCH_6_BOTTOM := TRUE;
HMI_PLC_SYNCH_7_BOTTOM := TRUE;

IF NOT HMI_COMPLETE_SYNCH THEN
	RETURN;
END_IF

(* ----------- HMI can reset latches on PLC, handle those here.  Also clear latches after powerup stabilizes. ----------------- *)
IF (LATCH_RESET_REQUEST_LAST <> LATCH_RESET_REQUEST) OR (AFTER_POWERUP AND TIME_SECONDS > 60) THEN
	AFTER_POWERUP := FALSE;
	LATCH_RESET_REQUEST_LAST := LATCH_RESET_REQUEST;
	ESTOP_LATCH := 0;
	WARNING_LATCH := 0;
	FEEDBACK_FAIL_LATCH := 0;
	VALVE_FAIL_LATCH := 0;
	VALVE_COMM_LATCH := 0;
	AXIS_RANGE_LATCH := 0;
END_IF

(* ------------ Handle all of the setup data coming from the HMI ------------------- *)

(* ------------ Non-persistent variables here. --------------------------- *)

REFLECT_HMI_XMIT_COUNT := HMI_XMIT_COUNT;

// Code debugging facility to let user force process conditions.
//	Execute debug code only on rising edge of bitmask from HMI.
IF TRIGGER_BITMASK <> 0 AND LAST_TRIGGER_BITMASK = 0 THEN
	CASE TRIGGER_BITMASK OF
		1:
			DEBUG_UR_STALL_DETECTED := 1;
			DEBUG_UR_STALL_COUNT := DEBUG_UR_STALL_COUNT + 1;
		2:
			DEBUG_LC_STALL_DETECTED := 1;
			DEBUG_LC_STALL_COUNT := DEBUG_LC_STALL_COUNT + 1;
		4:
			DEBUG_HARD_SOIL_DETECTED := 1;
			DEBUG_HARD_SOIL_COUNT := DEBUG_HARD_SOIL_COUNT + 1;
			;
	END_CASE
END_IF;
LAST_TRIGGER_BITMASK := TRIGGER_BITMASK;

// Run this forcing all the time, because these get changed both by settings on the HMI and by states
//	on the machine.
twoStateForce(HMI_TRAVEL_ALARM_FORCE, ADR(TRAVEL_ALARM_FORCE));
twoStateForce(HMI_AIR_COMPRESSOR_REQUEST_FORCE, ADR(AIR_COMPRESSOR_REQUEST_FORCE));
twoStateForce(HMI_AIR_COMPRESSOR_SUPPLY_FORCE, ADR(AIR_COMPRESSOR_SUPPLY_FORCE));
twoStateForce(HMI_AIR_COMPRESSOR_FAN_FORCE, ADR(AIR_COMPRESSOR_FAN_FORCE));
twoStateForce(HMI_HAMMER_FORCE, ADR(HAMMER_FORCE));
twoStateForce(HMI_HYDRAULIC_FAN_FORCE, ADR(HYDRAULIC_FAN_FORCE));
twoStateForce(HMI_RED_LIGHT_FORCE, ADR(RED_LIGHT_FORCE));
twoStateForce(HMI_YELLOW_LIGHT_FORCE, ADR(YELLOW_LIGHT_FORCE));
twoStateForce(HMI_GREEN_LIGHT_FORCE, ADR(GREEN_LIGHT_FORCE));
twoStateForce(HMI_BLUE_LIGHT_FORCE, ADR(BLUE_LIGHT_FORCE));
twoStateForce(HMI_TRACK_HIGH_SPEED_FORCE, ADR(TRACK_HIGH_SPEED_FORCE));
twoStateForce(HMI_RES_1_FORCE, ADR(RES_1_FORCE));
twoStateForce(HMI_ESTOP_FORCE, ADR(E_STOP_OUT_FORCE));
twoStateForce(HMI_HORN_FORCE, ADR(HORN_FORCE));
twoStateForce(HMI_DRIFTER_AIR_OPEN_FORCE, ADR(DRIFTER_AIR_OPEN_FORCE));
twoStateForce(HMI_LIGHT_1_FORCE, ADR(LIGHT_1_FORCE));
twoStateForce(HMI_LIGHT_2_FORCE, ADR(LIGHT_2_FORCE));
twoStateForce(HMI_COOLER_SOLENOID_FORCE, ADR(COOLER_SOLENOID_FORCE));
twoStateForce(HMI_WATER_FORCE, ADR(WATER_FORCE));

twoStateForce(HMI_PROXIMITY_ALARM_FORCE, ADR(PROXIMITY_SENSOR_ALARM_MUTE_FORCE));
twoStateForce(HMI_PROXIMITY_ANTENNA_FORCE, ADR(PROXIMITY_SENSOR_DISABLE_FORCE));

threeStateForce(HMI_UPPER_ROTARY_FORCE, ADR(UPPER_ROTARY_FWD_FORCE), ADR(UPPER_ROTARY_REV_FORCE));
threeStateForce(HMI_BLADE_FORCE, ADR(BLADE_UP_FORCE), ADR(BLADE_DOWN_FORCE));
threeStateForce(HMI_CENTRALIZER_FORCE, ADR(CENTRALIZER_OPEN_FORCE), ADR(CENTRALIZER_CLOSE_FORCE));
threeStateForce(HMI_LEFT_CRIMPER_FORCE, ADR(LEFT_CRIMPER_OPEN_FORCE), ADR(LEFT_CRIMPER_CLOSE_FORCE));
threeStateForce(HMI_RIGHT_CRIMPER_FORCE, ADR(RIGHT_CRIMPER_OPEN_FORCE), ADR(RIGHT_CRIMPER_CLOSE_FORCE));
threeStateForce(HMI_TARGET_PLATE_FORCE, ADR(TARGET_PLATE_UP_FORCE), ADR(TARGET_PLATE_DOWN_FORCE));
	
(* ------------- Persistent variables here. ---------------------- *)
IF 	(PLC_TRANSMIT_1_VERSION = HMI_TRANSMIT_1_VERSION) AND 
	(PLC_TRANSMIT_2_VERSION = HMI_TRANSMIT_2_VERSION) THEN
		
	IF SET_MACHINE_SERIAL_VALUE = 0 THEN
		SERIAL_ZERO := TRUE;
	END_IF
	
	checkIntValueAndUpdate(VALUE_FROM_HMI := SET_MACHINE_SERIAL_VALUE, pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.MACHINE_SERIAL),
		pTRANSMIT_VALUE_ON_PLC := ADR(MACHINE_SERIAL_VALUE));
	
	checkUdintValueAndUpdate(VALUE_FROM_HMI := SET_MACHINE_VERSION_VALUE, pPERSISTENT_VALUE_ON_PLC := ADR(pNVM3^.MACHINE_VERSION),
		pTRANSMIT_VALUE_ON_PLC := ADR(MACHINE_VERSION_VALUE));
	checkUdintValueAndUpdate(VALUE_FROM_HMI := SET_MACHINE_COMPRESSOR_VALUE, pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.MACHINE_COMPRESSOR),
		pTRANSMIT_VALUE_ON_PLC := ADR(MACHINE_COMPRESSOR_VALUE));
	checkUdintValueAndUpdate(VALUE_FROM_HMI := SET_MACHINE_DRIFTER_VALUE, pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.MACHINE_DRIFTER),
		pTRANSMIT_VALUE_ON_PLC := ADR(MACHINE_DRIFTER_VALUE));
	checkUdintValueAndUpdate(VALUE_FROM_HMI := SET_MACHINE_LR_VALUE, pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.MACHINE_LR),
		pTRANSMIT_VALUE_ON_PLC := ADR(MACHINE_LR_VALUE));
	
	FOR Index := 1 TO SCREW_LENGTHS_COUNT DO
		pNVM1^.SCREW_LENGTHS_CM[Index] := SET_SCREW_LENGTHS_CM_VALUES[Index];
		SCREW_LENGTHS_CM_VALUE[Index] := SET_SCREW_LENGTHS_CM_VALUES[Index];
	END_FOR;
	
	FOR Index := 1 TO SCREW_LENGTHS_COUNT DO
		pNVM1^.STANDARD_EMBEDMENT_CM[Index] := SET_STANDARD_EMBEDMENT_CM_VALUES[Index];
		STANDARD_EMBEDMENT_CM_VALUE[Index] := SET_STANDARD_EMBEDMENT_CM_VALUES[Index];
	END_FOR;
	
	FOR Index := 1 TO SCREW_LENGTHS_COUNT DO
		pNVM4^.HEAVY_EMBEDMENT_CM[Index] := SET_HEAVY_EMBEDMENT_CM_VALUES[Index];
		HEAVY_EMBEDMENT_CM_VALUE[Index] := SET_HEAVY_EMBEDMENT_CM_VALUES[Index];
	END_FOR;
	
	FOR Index := 1 TO LEG_LENGTHS_COUNT DO
		pNVM2^.LEG_LENGTHS_CM[Index] := HMI_LEG_LENGTHS_CM[Index];
		pNVM2^.LEG_LENGTH_USED[Index] := HMI_LEG_LENGTH_USED[Index];
	END_FOR
	
	FOR Index := 1 TO FLOW_TABLE_SIZE DO
		checkRealValueAndUpdate(VALUE_FROM_HMI := SET_UR_PRESSURE_INPUT_VALUE[Index],
			pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.UR_PRESSURE_INPUT[Index]), pTRANSMIT_VALUE_ON_PLC := ADR(UR_PRESSURE_INPUT_VALUE[Index]));
		checkRealValueAndUpdate(VALUE_FROM_HMI := SET_AIR_FLOW_OUTPUT_VALUE[Index],
			pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.AIR_FLOW_OUTPUT[Index]), pTRANSMIT_VALUE_ON_PLC := ADR(AIR_FLOW_OUTPUT_VALUE[Index]));
	END_FOR
	
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_TCH_DOWN_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.TCH_DOWN_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(TCH_DOWN_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_TCH_UP_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.TCH_UP_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(TCH_UP_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_CENTRALIZER_OPEN_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.CENTRALIZER_OPEN_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(CENTRALIZER_OPEN_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_CENTRALIZER_CLOSE_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.CENTRALIZER_CLOSE_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(CENTRALIZER_CLOSE_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_CRIMPER_LEFT_OPEN_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.CRIMPER_LEFT_OPEN_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(CRIMPER_LEFT_OPEN_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_CRIMPER_LEFT_CLOSE_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.CRIMPER_LEFT_CLOSE_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(CRIMPER_LEFT_CLOSE_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_CRIMPER_RIGHT_OPEN_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.CRIMPER_RIGHT_OPEN_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(CRIMPER_RIGHT_OPEN_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_CRIMPER_RIGHT_CLOSE_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.CRIMPER_RIGHT_CLOSE_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(CRIMPER_RIGHT_CLOSE_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_UPPER_ROTARY_FWD_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.UPPER_ROTARY_FWD_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(UPPER_ROTARY_FWD_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_UPPER_ROTARY_REV_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.UPPER_ROTARY_REV_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(UPPER_ROTARY_REV_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_BLADE_UP_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.BLADE_UP_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(BLADE_UP_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_BLADE_DOWN_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM2^.BLADE_DOWN_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(BLADE_DOWN_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := HMI_HAMMER_SPEED,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.HAMMER_SPEED), pTRANSMIT_VALUE_ON_PLC := ADR(HAMMER_SPEED_TRANSMIT));
	checkUintValueAndUpdate(VALUE_FROM_HMI := SET_TRACKER_ROW_TYPE_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.TRACKER_ROW_TYPE), pTRANSMIT_VALUE_ON_PLC := ADR(TRACKER_ROW_TYPE_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_UC_END_RETRACT_HARD_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.UC_END_RETRACT_HARD), pTRANSMIT_VALUE_ON_PLC := ADR(UC_END_RETRACT_HARD_VALUE));
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_UC_END_RETRACT_SOFT_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.UC_END_RETRACT_SOFT), pTRANSMIT_VALUE_ON_PLC := ADR(UC_END_RETRACT_SOFT_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_ROTATOR_SCREW_POS_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.ROTATOR_SCREW_POS), pTRANSMIT_VALUE_ON_PLC := ADR(ROTATOR_SCREW_POS_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SCREW_STOP_THRESHOLD_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.SCREW_STOP_THRESHOLD), pTRANSMIT_VALUE_ON_PLC := ADR(SCREW_STOP_THRESHOLD_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_RIGHT_LEFT_DIFF_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM3^.RIGHT_LEFT_DIFF), pTRANSMIT_VALUE_ON_PLC := ADR(RIGHT_LEFT_DIFF_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_MAST_LEAN_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM3^.MAST_LEAN), pTRANSMIT_VALUE_ON_PLC := ADR(MAST_LEAN_VALUE));
	
		// deprecated sPersistent_1_AVAIL_04
// 	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_LOWER_CROWD_DRIVE_VEL_VALUE,
// 		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.LOWER_CROWD_DRIVE_VEL), pTRANSMIT_VALUE_ON_PLC := ADR(LOWER_CROWD_DRIVE_VEL_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_LC_DRIVE_VEL_HI_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.LC_DRIVE_VEL_HI), pTRANSMIT_VALUE_ON_PLC := ADR(LC_DRIVE_VEL_HI_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_LC_DRIVE_VEL_LOW_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.LC_DRIVE_VEL_LOW), pTRANSMIT_VALUE_ON_PLC := ADR(LC_DRIVE_VEL_LOW_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_UR_DRIVE_PRESSURE_LOW_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.UR_DRIVE_PRESSURE_LOW), pTRANSMIT_VALUE_ON_PLC := ADR(UR_DRIVE_PRESSURE_LOW_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_UR_DRIVE_PRESSURE_HI_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.UR_DRIVE_PRESSURE_HI), pTRANSMIT_VALUE_ON_PLC := ADR(UR_DRIVE_PRESSURE_HI_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SS_DRIVE_VEL_HI_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.SS_DRIVE_VEL_HI), pTRANSMIT_VALUE_ON_PLC := ADR(SS_DRIVE_VEL_HI_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SS_DRIVE_VEL_LOW_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.SS_DRIVE_VEL_LOW), pTRANSMIT_VALUE_ON_PLC := ADR(SS_DRIVE_VEL_LOW_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_LC_DRIVE_PRESSURE_LOW_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.LC_DRIVE_PRESSURE_LOW), pTRANSMIT_VALUE_ON_PLC := ADR(LC_DRIVE_PRESSURE_LOW_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_LC_DRIVE_PRESSURE_HI_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.LC_DRIVE_PRESSURE_HI), pTRANSMIT_VALUE_ON_PLC := ADR(LC_DRIVE_PRESSURE_HI_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SS_LC_PRELOAD_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.SS_LC_PRELOAD), pTRANSMIT_VALUE_ON_PLC := ADR(SS_LC_PRELOAD_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SS_BIT_PROTRUSION_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.SS_BIT_PROTRUSION), pTRANSMIT_VALUE_ON_PLC := ADR(SS_BIT_PROTRUSION_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SS_CLEAR_SPOILS_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.SS_CLEAR_SPOILS), pTRANSMIT_VALUE_ON_PLC := ADR(SS_CLEAR_SPOILS_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SS_LC_STALL_TIME_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.SS_LC_STALL_TIME), pTRANSMIT_VALUE_ON_PLC := ADR(SS_LC_STALL_TIME_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SS_LC_STALL_PRESSURE_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.SS_LC_STALL_PRESSURE), pTRANSMIT_VALUE_ON_PLC := ADR(SS_LC_STALL_PRESSURE_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SS_DETECT_BAND_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.SS_DETECT_BAND), pTRANSMIT_VALUE_ON_PLC := ADR(SS_DETECT_BAND_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_SS_DETECT_TIME_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.SS_DETECT_TIME), pTRANSMIT_VALUE_ON_PLC := ADR(SS_DETECT_TIME_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_TORQUE_TUBE_PITCH_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.TORQUE_TUBE_PITCH), pTRANSMIT_VALUE_ON_PLC := ADR(TORQUE_TUBE_PITCH_VALUE));
	
// 	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_MAST_SLIDE_COR_POS_VALUE,
// 		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.MAST_SLIDE_COR_POS), pTRANSMIT_VALUE_ON_PLC := ADR(MAST_SLIDE_COR_POS_VALUE));
//	setting deprecated - hardcoded now.  sPersistent_1_AVAIL_01
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_LOWER_CROWD_COR_POS_VALUE,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM1^.LOWER_CROWD_COR_POS), pTRANSMIT_VALUE_ON_PLC := ADR(LOWER_CROWD_COR_POS_VALUE));
	
	checkRealValueAndUpdate(VALUE_FROM_HMI := SET_CHUCK_TO_TARGET_VALUE,
