					pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.HMI_UINTS[Index]), pTRANSMIT_VALUE_ON_PLC := ADR(HMI_UINTS_VALUES[Index]));
			checkIntValueAndUpdate(VALUE_FROM_HMI := SET_HMI_INTS[Index],
					pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.HMI_INTS[Index]), pTRANSMIT_VALUE_ON_PLC := ADR(HMI_INTS_VALUES[Index]));
		END_IF
		checkRealValueAndUpdate(VALUE_FROM_HMI := SET_HMI_REALS[Index],
				pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.HMI_REALS[Index]), pTRANSMIT_VALUE_ON_PLC := ADR(HMI_REALS_VALUES[Index]));
		IF Index < 11 THEN // 10 vars
			checkVectorValueAndUpdate(VALUE_FROM_HMI := SET_HMI_VECTORS[Index],
				pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.HMI_VECTORS[Index]), pTRANSMIT_VALUE_ON_PLC := ADR(HMI_VECTORS_VALUES[Index]));
			IF pNVM4^.HMI_STRINGS[Index] <> SET_HMI_STRINGS[Index] THEN 
				pNVM4^.HMI_STRINGS[Index] := SET_HMI_STRINGS[Index];
				HMI_STRINGS_VALUES[Index] := SET_HMI_STRINGS[Index];
			END_IF
// 			checkStringValueAndUpdate(VALUE_FROM_HMI := SET_HMI_STRINGS[Index],
// 				pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.HMI_STRINGS[Index]), pTRANSMIT_VALUE_ON_PLC := 				ADR(HMI_STRINGS_VALUES[Index]));
		END_IF
	END_FOR
	// don't allow /0 error if settings get wiped (this runs before updateTransmitHmiVars)
	pNVM4^.GPS_GENERAL_SETTINGS[GPS_VELOCITY_FACTOR] := MAX(pNVM4^.GPS_GENERAL_SETTINGS[GPS_VELOCITY_FACTOR], 0.05); 
	pNVM4^.GPS_GENERAL_SETTINGS[GPS_ACCEL_FACTOR] := MAX(pNVM4^.GPS_GENERAL_SETTINGS[GPS_ACCEL_FACTOR], 0.05);
		
	checkUIntValueAndUpdate(VALUE_FROM_HMI := SET_GPS_VENDOR,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.GPS_VENDOR), pTRANSMIT_VALUE_ON_PLC := ADR(GPS_VENDOR_VALUE));
	
	checkUintValueAndUpdate(VALUE_FROM_HMI := SET_GPS_AUTOTARGET_SELECTION,
		pPERSISTENT_VALUE_ON_PLC := ADR(pNVM4^.GPS_AUTOTARGET_SELECTION), pTRANSMIT_VALUE_ON_PLC := ADR(GPS_AUTOTARGET_SELECTION_VALUE));
		
	// Screw Parameters
	IF pNVM4^.HMI_BOOLS[SCREW_PARAMS_SOURCE_IS_PNEZD] <> SCREW_PARAMS_SOURCE_LAST THEN
		SCREW_PARAMS_SOURCE_LAST := pNVM4^.HMI_BOOLS[SCREW_PARAMS_SOURCE_IS_PNEZD];
		setScrewParameters();
	END_IF
END_IF	

// TODO: Delete if not used by Pinnington/Bellefield: 
(*
IF SCREW_PARAMS_DISPLAY_INDEX_LAST <> SCREW_PARAMS_DISPLAY_INDEX THEN
	SCREW_PARAMS_DISPLAY_INDEX_LAST := SCREW_PARAMS_DISPLAY_INDEX;
	SCREW_PARAMS_CALLED := pNVM4^.SCREW_PARAMS_CUSTOM[SCREW_PARAMS_DISPLAY_INDEX];
ELSIF (SCREW_PARAMS_SOURCE + SCREW_PARAMS_INDEX) <> SCREW_PARAMS_SOURCE_LAST THEN
	SCREW_PARAMS_SOURCE_LAST := SCREW_PARAMS_SOURCE + SCREW_PARAMS_INDEX;
	setScrewParameters();
END_IF
	
IF SCREW_PARAMS_SAVE_CUSTOM THEN
	pNVM4^.SCREW_PARAMS_CUSTOM[SCREW_PARAMS_DISPLAY_INDEX] := SCREW_PARAMS_CUSTOM_FROM_HMI;
END_IF *)
	
(* ---------- Handle the calibration of the absolute encoders from the HMI controls.  ---------- *)
R_TRIG_Z_SLIDE_ENCODER_CAL(
	CLK := SET_Z_SLIDE_ENCODER_AT_ZERO_FLAG,
	Q => CALIBRATE_Z_SLIDE_ENCODER);

R_TRIG_X_SLIDE_ENCODER_CAL(
	CLK := SET_X_SLIDE_ENCODER_AT_ZERO_FLAG,
	Q => CALIBRATE_X_SLIDE_ENCODER);

R_TRIG_MAST_SLIDE_ENCODER_CAL(
	CLK := SET_MAST_SLIDE_ENCODER_AT_ZERO_FLAG,
	Q => CALIBRATE_MAST_SLIDE_ENCODER);

R_TRIG_YAW_ENCODER_CAL(
	CLK := SET_YAW_ENCODER_AT_ZERO_FLAG,
	Q => CALIBRATE_YAW_ENCODER);

R_TRIG_BOOM_SWING_ENCODER_CAL(
	CLK := SET_BOOM_SWING_ENCODER_AT_ZERO_FLAG,
	Q => CALIBRATE_BOOM_SWING_ENCODER);

R_TRIG_LOWER_CROWD_ENCODER_CAL(
	CLK := SET_LOWER_CROWD_ENCODER_AT_REF_FLAG,
	Q => CALIBRATE_LOWER_CROWD_ENCODER);

R_TRIG_UPPER_CROWD_ENCODER_CAL(
	CLK := SET_UPPER_CROWD_ENCODER_AT_ZERO_FLAG,
	Q => CALIBRATE_UPPER_CROWD_ENCODER);

R_TRIG_BOOM_LIFT_ENCODER_CAL(
	CLK := SET_BOOM_LIFT_ENCODER_AT_ZERO_FLAG,
	Q => CALIBRATE_BOOM_LIFT_ENCODER);

R_TRIG_JOINT_LIFT_ENCODER_CAL(
	CLK := SET_JOINT_LIFT_ENCODER_AT_ZERO_FLAG,
	Q => CALIBRATE_JOINT_LIFT_ENCODER);

(* We are just setting the ENCODER_AT_ZERO value here, so don't push in all of the paramters, just take what was initialized on powerup. *)

IF (CALIBRATE_Z_SLIDE_ENCODER) THEN
	(* ---------- Z slide encoder is calibrated when Z slide is at full up position.  ---------- *)
	pNVM1^.Z_SLIDE_ENCODER_AT_ZERO := (15000 - TO_UDINT(Z_SLIDE_ENCODER_RAW)) -
		REAL_TO_UDINT(AXES[AXIS_Z_SLIDE].CONFIG.COMMAND_LIMIT_MAX * AXES[AXIS_Z_SLIDE].FEEDBACK.RAW_PER_ENGR);
	
	AxisZeroInit(
		pFEEDBACK := ADR(AXES[AXIS_Z_SLIDE].FEEDBACK),
		RAW_WHEN_ENGR_ZERO := pNVM1^.Z_SLIDE_ENCODER_AT_ZERO
		);
END_IF

IF (CALIBRATE_X_SLIDE_ENCODER) THEN
	(* ---------- X slide encoder is calibrated when X slide is at 0 cm (full forward).  ---------- *)
	pNVM1^.X_SLIDE_ENCODER_AT_ZERO := TO_UDINT(X_SLIDE_ENCODER_RAW);

	AxisZeroInit(
		pFEEDBACK := ADR(AXES[AXIS_X_SLIDE].FEEDBACK),
		RAW_WHEN_ENGR_ZERO := pNVM1^.X_SLIDE_ENCODER_AT_ZERO
		);
END_IF


IF (CALIBRATE_MAST_SLIDE_ENCODER) THEN
	(* ---------- Mast slide encoder is calibrated when mast slide is at its top limit of travel.  ---------- *)
	pNVM1^.MAST_SLIDE_ENCODER_AT_REF := TO_UDINT(MAST_SLIDE_ENCODER_RAW);
	pNVM1^.MAST_SLIDE_ENCODER_AT_ZERO := pNVM1^.MAST_SLIDE_ENCODER_AT_REF -
		REAL_TO_UDINT(AXES[AXIS_MAST_SLIDE].CONFIG.COMMAND_LIMIT_MAX * AXES[AXIS_MAST_SLIDE].FEEDBACK.RAW_PER_ENGR);

	AxisZeroInit(
		pFEEDBACK := ADR(AXES[AXIS_MAST_SLIDE].FEEDBACK),
		RAW_WHEN_ENGR_ZERO := pNVM1^.MAST_SLIDE_ENCODER_AT_ZERO
		);
END_IF

IF (CALIBRATE_YAW_ENCODER) THEN
	(* ---------- Yaw encoder is calibrated when at the hard stop on the operator's left.  ---------- *)
	pNVM1^.YAW_ENCODER_AT_ZERO := AxisCalculateZero(pCONFIG := ADR(AXES[AXIS_YAW].CONFIG), pFEEDBACK := ADR(AXES[AXIS_YAW].FEEDBACK),
		ENGR := AXES[AXIS_YAW].CONFIG.COMMAND_LIMIT_MAX, RAW := TRUNION_POS_RAW);

	AxisZeroInit(
		pFEEDBACK := ADR(AXES[AXIS_YAW].FEEDBACK),
		RAW_WHEN_ENGR_ZERO := pNVM1^.YAW_ENCODER_AT_ZERO
		);
END_IF

IF (CALIBRATE_BOOM_SWING_ENCODER) THEN
	(* ---------- Boom swing encoder is calibrated at the hard stop on the operator's left.  ---------- *)
	pNVM1^.BOOM_SWING_ENCODER_AT_ZERO := AxisCalculateZero(pCONFIG := ADR(AXES[AXIS_BOOM_SWING].CONFIG),
		pFEEDBACK := ADR(AXES[AXIS_BOOM_SWING].FEEDBACK),
		ENGR := AXES[AXIS_BOOM_SWING].CONFIG.COMMAND_LIMIT_MIN,
		RAW := BOOM_SWING_POS_RAW);

	AxisZeroInit(
		pFEEDBACK := ADR(AXES[AXIS_BOOM_SWING].FEEDBACK),
		RAW_WHEN_ENGR_ZERO := pNVM1^.BOOM_SWING_ENCODER_AT_ZERO
		);
END_IF

IF (CALIBRATE_LOWER_CROWD_ENCODER) THEN
	(* ---------- Lower crowd encoder is calibrated when the lower crowd is at a measured offset from the end of mast.  ---------- *)
	pNVM1^.LOWER_CROWD_MAST_TO_SLIDE_OFFSET := LOWER_CROWD_MIN_END_POS; // Changed this with fixed position for LC reference. SET_LOWER_CROWD_MAST_TO_SLIDE_OFFSET_VALUE;
	pNVM1^.LOWER_CROWD_ENCODER_AT_REF := LOWER_CROWD_POS_RAW;
	
	(* ---------- Compute the encoder position at the lower limit.  ---------- *)
	IF (TO_REAL(pNVM1^.LOWER_CROWD_ENCODER_AT_REF) > (pNVM1^.LOWER_CROWD_MAST_TO_SLIDE_OFFSET * AXES[AXIS_LOWER_CROWD].FEEDBACK.RAW_PER_ENGR)) THEN
		pNVM1^.LOWER_CROWD_ENCODER_AT_ZERO := pNVM1^.LOWER_CROWD_ENCODER_AT_REF - REAL_TO_UDINT(pNVM1^.LOWER_CROWD_MAST_TO_SLIDE_OFFSET * AXES[AXIS_LOWER_CROWD].FEEDBACK.RAW_PER_ENGR);
	ELSE
		(* We have to handle the wrap ourselves here, ugh. *)
		pNVM1^.LOWER_CROWD_ENCODER_AT_ZERO := TO_UDINT(AXES[AXIS_LOWER_CROWD].FEEDBACK.ROLLOVER_AT) -
			REAL_TO_UDINT(pNVM1^.LOWER_CROWD_MAST_TO_SLIDE_OFFSET * AXES[AXIS_LOWER_CROWD].FEEDBACK.RAW_PER_ENGR) + TO_UDINT(pNVM1^.LOWER_CROWD_ENCODER_AT_REF);
	END_IF
	
	AxisZeroInit(
		pFEEDBACK := ADR(AXES[AXIS_LOWER_CROWD].FEEDBACK),
		RAW_WHEN_ENGR_ZERO := pNVM1^.LOWER_CROWD_ENCODER_AT_ZERO
		);
END_IF

IF (CALIBRATE_UPPER_CROWD_ENCODER) THEN
	(* ---------- Upper crowd encoder is calibrated when the upper crowd is at the zero position.  ---------- *)
	pNVM1^.UPPER_CROWD_ENCODER_AT_ZERO := UPPER_CROWD_POS_RAW;

	AxisZeroInit(
		pFEEDBACK := ADR(AXES[AXIS_UPPER_CROWD].FEEDBACK),
		RAW_WHEN_ENGR_ZERO := pNVM1^.UPPER_CROWD_ENCODER_AT_ZERO
		);
END_IF

(* --------- Boom lift encoder is calibrated at the hard stop on the operator's left.  ---------- *)
IF (CALIBRATE_BOOM_LIFT_ENCODER) THEN
	pNVM3^.BOOM_LIFT_ENCODER_AT_ZERO := AxisCalculateZero(pCONFIG := ADR(AXES[AXIS_BOOM_LIFT].CONFIG),
											pFEEDBACK := ADR(AXES[AXIS_BOOM_LIFT].FEEDBACK),
											ENGR := AXES[AXIS_BOOM_LIFT].CONFIG.COMMAND_LIMIT_MAX,
											RAW := BOOM_LIFT_POS_RAW);

	AxisZeroInit(
		pFEEDBACK := ADR(AXES[AXIS_BOOM_LIFT].FEEDBACK),
		RAW_WHEN_ENGR_ZERO := pNVM3^.BOOM_LIFT_ENCODER_AT_ZERO
		);
END_IF

(* ---------- Joint lift encoder is calibrated at the hard stop on the operator's left.  ---------- *)
IF (CALIBRATE_JOINT_LIFT_ENCODER) THEN
	pNVM3^.JOINT_LIFT_ENCODER_AT_ZERO := AxisCalculateZero(pCONFIG := ADR(AXES[AXIS_JOINT_LIFT].CONFIG),
											pFEEDBACK := ADR(AXES[AXIS_JOINT_LIFT].FEEDBACK),
											ENGR := AXES[AXIS_JOINT_LIFT].CONFIG.COMMAND_LIMIT_MIN,
											RAW := JOINT_LIFT_POS_RAW);

	AxisZeroInit(
		pFEEDBACK := ADR(AXES[AXIS_JOINT_LIFT].FEEDBACK),
		RAW_WHEN_ENGR_ZERO := pNVM3^.JOINT_LIFT_ENCODER_AT_ZERO
		);
END_IF

(* ----------  Config Settings  ---------- *)
IF (TO_BOOL(SET_MAST_SLIDE_ENCODER_AT_REF) OR TO_BOOL(SET_MAST_SLIDE_ENCODER_AT_ZERO) OR TO_BOOL(SET_Z_SLIDE_ENCODER_AT_ZERO) OR TO_BOOL(SET_X_SLIDE_ENCODER_AT_ZERO))
	 THEN
	pNVM1^.Z_SLIDE_ENCODER_AT_ZERO := SET_Z_SLIDE_ENCODER_AT_ZERO;
	pNVM1^.X_SLIDE_ENCODER_AT_ZERO := SET_X_SLIDE_ENCODER_AT_ZERO;
	pNVM1^.MAST_SLIDE_ENCODER_AT_REF := SET_MAST_SLIDE_ENCODER_AT_REF;
	pNVM1^.MAST_SLIDE_ENCODER_AT_ZERO := SET_MAST_SLIDE_ENCODER_AT_ZERO;
// 	pNVM1^.Z_SLIDE_CALIBRATION_OFFSET := SET_Z_SLIDE_CALIBRATION_OFFSET; // not used anywhere, so deprecated sPersistent_1_AVAIL_02
	pNVM1^.YAW_ENCODER_AT_ZERO := SET_YAW_ENCODER_AT_ZERO;
	pNVM1^.LOWER_CROWD_ENCODER_AT_REF := SET_LOWER_CROWD_ENCODER_AT_REF;
	pNVM1^.LOWER_CROWD_ENCODER_AT_ZERO := SET_LOWER_CROWD_ENCODER_AT_ZERO;
	pNVM1^.LOWER_CROWD_MAST_TO_SLIDE_OFFSET := SET_LOWER_CROWD_MAST_TO_SLIDE_OFFSET;
	pNVM1^.UPPER_CROWD_ENCODER_AT_ZERO := SET_UPPER_CROWD_ENCODER_AT_ZERO;
	pNVM1^.BOOM_SWING_ENCODER_AT_ZERO := SET_BOOM_SWING_ENCODER_AT_ZERO;
	pNVM3^.BOOM_LIFT_ENCODER_AT_ZERO := SET_BOOM_LIFT_ENCODER_AT_ZERO;
	pNVM3^.JOINT_LIFT_ENCODER_AT_ZERO := SET_JOINT_LIFT_ENCODER_AT_ZERO;
	
	pNVM1^.SCREW_NUMBER := SET_SCREW_NUMBER;
	
	FOR Index := 1 TO 10 DO 
		pNVM4^.LEG_LENGTH_COUNT[Index] := SET_LEG_LENGTH_COUNT[Index];
	END_FOR
	FOR Index := 1 TO 3 DO 
		pNVM4^.SCREW_LENGTH_COUNT[Index] := SET_SCREW_LENGTH_COUNT[Index];
	END_FOR
	
	
	pNVM2^.PLC_BOARD_TEMP_MAX := SET_PLC_BOARD_TEMP_MAX;
	pNVM2^.PLC_CHIP_TEMP_MAX := SET_PLC_CHIP_TEMP_MAX;
	pNVM2^.PLC_BOARD_TEMP_MIN := SET_PLC_BOARD_TEMP_MIN;
	pNVM2^.PLC_CHIP_TEMP_MIN := SET_PLC_CHIP_TEMP_MIN;
	pNVM2^.VBB15_MV_MAX := SET_VBB15_MV_MAX;
	pNVM2^.VBB30_MV_MAX := SET_VBB30_MV_MAX;
	pNVM2^.VBB15_MV_MIN := SET_VBB15_MV_MIN;
	pNVM2^.VBB30_MV_MIN := SET_VBB30_MV_MIN;
	pNVM4^.AIR_COMPRESSOR_TEMP_MAX := SET_AIR_COMPRESSOR_TEMP_MAX;
	pNVM4^.AIR_COMPRESSOR_PRESSURE_MAX := SET_AIR_COMPRESSOR_PRESSURE_MAX;
	
END_IF