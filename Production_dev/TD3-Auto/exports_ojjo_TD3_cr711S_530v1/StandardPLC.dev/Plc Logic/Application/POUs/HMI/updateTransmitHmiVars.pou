
(********************** Declaration ****************************)
FUNCTION updateTransmitHmiVars : BOOL

VAR_INPUT
	INIT				: BOOL;
	VISUALIZATION		: BOOL;
END_VAR

VAR
	WARNING_FLAG		: BOOL;
	MachineStateString	: STRING(50);
	RtnVal				: BOOL;
	Index				: UINT;
	Hawe_Index			: INT;
	
END_VAR
(********************** Implementation ****************************)
XMIT_1_COUNT := XMIT_1_COUNT + 1;
XMIT_2_COUNT := XMIT_2_COUNT + 1;
XMIT_3_COUNT := XMIT_3_COUNT + 1;
XMIT_5_COUNT := XMIT_5_COUNT + 1;
XMIT_6_COUNT := XMIT_6_COUNT + 1;
XMIT_7_COUNT := XMIT_7_COUNT + 1;

AUTOMATIC_TRANSMIT := AUTOMATIC;
MANUAL_TRANSMIT := MANUAL;
BUMP_TRANSMIT := BUMP;

MACHINE_MODE_TRANSMIT := MACHINE_MODE;

TRACK_STATE_TRANSMIT := TRACK_STATE;
RWP_STATE_TRANSMIT := RWP_STATE;
SCREW_STATE_TRANSMIT := SCREW_STATE;

MACHINE_SERIAL_VALUE := pNVM1^.MACHINE_SERIAL;
MACHINE_VENDOR_TRANSMIT := 1; // 1: Hutte
MACHINE_FAMILY_TRANSMIT := 3; // TD3
MACHINE_VERSION_VALUE := pNVM3^.MACHINE_VERSION;
MACHINE_COMPRESSOR_VALUE := pNVM4^.MACHINE_COMPRESSOR;
MACHINE_DRIFTER_VALUE := pNVM4^.MACHINE_DRIFTER;
MACHINE_LR_VALUE := pNVM4^.MACHINE_LR;

(* Manage the HMI debugging messages for the machine state/substate. *)
IF AUTOMATIC (* OR BUMP *) THEN
	CASE MACHINE_MODE OF
		IDLE_MODE:
			MachineStateString := 'IDLE';
			MACHINE_STATE_STRING := '';
	
		TRACK_MODE:
			CASE TRACK_STATE OF
				TRACK_STATE_ENTRY:
					MachineStateString := 'TRACK - Entry';
					MACHINE_STATE_STRING := 'Entry';
				TRACK_STATE_CLEAR_GROUND:
					MachineStateString := 'TRACK - Clear Ground';
					MACHINE_STATE_STRING := 'Clr ground';
				TRACK_STATE_WAIT_DRIVE:
					MachineStateString := 'TRACK - Wait to clear truss';
					MACHINE_STATE_STRING := 'Track back';
				TRACK_STATE_CROWDS_DOWN:
					MachineStateString := 'TRACK - Bringing crowds down';
					MACHINE_STATE_STRING := 'Crowds down';
				TRACK_STATE_NORMAL:
					MachineStateString := 'TRACK - Normal';
					MACHINE_STATE_STRING := 'Normal';
				TRACK_STATE_POSITION_BOOM:
					MachineStateString := 'TRACK - Position boom';
					MACHINE_STATE_STRING := 'Center boom';
			ELSE
				MachineStateString := 'TRACK - Invalid State: ';
				CONCAT(MachineStateString, TO_STRING(TRACK_STATE));
				MACHINE_STATE_STRING := 'Invalid';
			END_CASE
	
		RWP_MODE:
			CASE RWP_STATE OF
				RWP_STATE_ENTRY:
					MachineStateString := 'RWP - Entry';
					MACHINE_STATE_STRING := 'Entry';
				RWP_STATE_MANUAL:
					MachineStateString := 'RWP - Manual';
					MACHINE_STATE_STRING := 'Manual';
				RWP_STATE_SELECT_OPERATION:
					MachineStateString := 'RWP - Select Operation';
					MACHINE_STATE_STRING := 'Select Op';
				RWP_STATE_WAIT_LEVEL:
					MachineStateString := 'RWP - Wait Level';
					MACHINE_STATE_STRING := 'Wait level';
				RWP_STATE_GPS_FAST_TARGET:
					MachineStateString := 'RWP - GPS Fast Target';
					MACHINE_STATE_STRING := 'GPS Coarse';	
				RWP_STATE_GPS_FINE_TARGET:
					MachineStateString := 'RWP - GPS Fine Target';
					MACHINE_STATE_STRING := 'GPS Fine';
				RWP_STATE_SQUARE_YAW:
					MachineStateString := 'RWP - Square Yaw';
					MACHINE_STATE_STRING := 'Square yaw';
				RWP_STATE_LOCATE_WP:
					MachineStateString := 'RWP - Locate WP';
					IF BUMP THEN
						MachineStateString := CONCAT(MachineStateString, ' (SEMI-AUTO)');
					END_IF
					MACHINE_STATE_STRING := 'Locate WP';
				RWP_STATE_EXIT:
					MachineStateString := 'RWP - Exit';
					MACHINE_STATE_STRING := 'Exit';
			ELSE
				MachineStateString := 'RWP - Invalid State: ';
				CONCAT(MachineStateString, TO_STRING(RWP_STATE));
				MACHINE_STATE_STRING := 'Invalid';
			END_CASE
	
		SCREW_MODE:
			CASE SCREW_STATE OF
				SCREW_STATE_ENTRY:
					MachineStateString := 'SCREW - Entry';
					MACHINE_STATE_STRING := 'Entry';
				SCREW_STATE_MANUAL:
					MachineStateString := 'SCREW - Manual';
					MACHINE_STATE_STRING := 'Manual';
				SCREW_STATE_TARGET_UP:
					MachineStateString := 'SCREW - Target Plate Up';
					MACHINE_STATE_STRING := 'Target up';
				SCREW_STATE_SELECT_OPERATION:
					MachineStateString := 'SCREW - Transmit';
					MACHINE_STATE_STRING := 'Select op';
				SCREW_STATE_PREPARE_TO_LOAD:
					MachineStateString := 'SCREW - Prepare To Load';
					MACHINE_STATE_STRING := 'Prep load';
				SCREW_STATE_LOAD_SCREW:
					MachineStateString := 'SCREW - Load Screw';
					MACHINE_STATE_STRING := 'Load screw';
				SCREW_STATE_MAST_TO_TARGET:
					MachineStateString := 'SCREW - Mast To Target';
					MACHINE_STATE_STRING := 'Mast targ';
				SCREW_STATE_NXT_TL_ADJUST:
					MachineStateString := 'SCREW - NXT 3L Adjust';
					MACHINE_STATE_STRING := 'NXT 3L Adj';
				SCREW_STATE_POSITION_MAST_SLIDE:
					MachineStateString := 'SCREW - Position Mast Slide';
					MACHINE_STATE_STRING := 'Move Mast';
				SCREW_STATE_DRIVE_SCREW:
					MachineStateString := 'SCREW - Drive Screw';
					MACHINE_STATE_STRING := 'Drive screw';
				SCREW_STATE_DRIVE_ASSIST:
					MachineStateString := 'SCREW - Drive Assist';
					MACHINE_STATE_STRING := 'Drive asst';
				SCREW_STATE_RETURN_TO_DRIVE:
					MachineStateString := 'SCREW - Upper Crowd Return';
					MACHINE_STATE_STRING := 'UC return';
				SCREW_STATE_UNLOAD_SCREW:
					MachineStateString := 'SCREW - Unload Screw';
					MACHINE_STATE_STRING := 'Unload';
				SCREW_STATE_RETRACT_AFTER_DRIVE:
					MachineStateString := 'SCREW - Retract After Drive';
					MACHINE_STATE_STRING := 'Retract';
				SCREW_STATE_CONFIRM_MAST_CLEAR:
					MachineStateString := 'SCREW - Confirm Mast Clear';
					MACHINE_STATE_STRING := 'Confirm clr';
				SCREW_STATE_MAST_TO_VERTICAL:
					MachineStateString := 'SCREW - Mast To Vertical';
					MACHINE_STATE_STRING := 'Mast vert';
				SCREW_STATE_CLEAR_TRUSS_CAP:
					MachineStateString := 'SCREW - Clear Truss Cap';
					MACHINE_STATE_STRING := 'Clear T Cap';
				SCREW_STATE_ASSEMBLE:
					MachineStateString := 'SCREW - Assemble Truss';
					MACHINE_STATE_STRING := 'Assemble';
				SCREW_STATE_FWP:
					MachineStateString := 'SCREW - Fine Work Point';
					MACHINE_STATE_STRING := 'FWP';
				SCREW_STATE_GPS_FWP_RETURN_TO_WP:
					MachineStateString := 'SCREW - Return to RWP WP';
					MACHINE_STATE_STRING := 'Return WP';
				SCREW_STATE_GPS_FWP_AUTOTARGET_GPS:
					MachineStateString := 'SCREW - GPS autotarget';
					MACHINE_STATE_STRING := 'FWP Auto';
				SCREW_STATE_CRIMP:
					MachineStateString := 'SCREW - Crimp';
					MACHINE_STATE_STRING := 'Crimp';
				SCREW_STATE_LC_CLEAR:
					MachineStateString := 'SCREW - Lower Crowd Clear';
					MACHINE_STATE_STRING := 'LC clear';
				SCREW_STATE_PRELOAD_COMPLIANCE:
					MachineStateString := 'SCREW - Preload Compliance';
					MACHINE_STATE_STRING := 'Preload';
				SCREW_STATE_INITIAL_ROTATE:
					MachineStateString := 'SCREW - Initial Rotate';
					MACHINE_STATE_STRING := 'Init rot';
				SCREW_STATE_DRILL_REVERSE:
					MachineStateString := 'SCREW - Drill Reverse';
					MACHINE_STATE_STRING := 'Drl rev';
				SCREW_STATE_DRILL_AHEAD:
					MachineStateString := 'SCREW - Drill Ahead';
					MACHINE_STATE_STRING := 'Drl ahead';
				SCREW_STATE_DRILL_RETURN:
					MachineStateString := 'SCREW - Drill Return';
					MACHINE_STATE_STRING := 'Drl return';
				SCREW_STATE_BRIEF_HAMMER:
					MachineStateString := 'SCREW - Brief Hammer';
					MACHINE_STATE_STRING := 'Brief ham';
				SCREW_STATE_DRILL_EXTEND:
					MachineStateString := 'SCREW - Drill Extend';
					MACHINE_STATE_STRING := 'Drl extend';
				SCREW_STATE_DRILL_TO_SCREW_END:
					MachineStateString := 'SCREW - Drill To Screw End';
					MACHINE_STATE_STRING := 'Drl to end';
				SCREW_STATE_RELIEVE_SPOILS_PRESSURE:
					MachineStateString := 'SCREW - Relieve Spoils Pressure';
					MACHINE_STATE_STRING := 'Rel spoils';
				SCREW_STATE_CLEAR_SPOILS:
					MachineStateString := 'SCREW - Clear Spoils';
					MACHINE_STATE_STRING := 'Clr spoils';
				SCREW_STATE_LC_REWIND:
					MachineStateString := 'SCREW - Reverse LC';
					MACHINE_STATE_STRING := 'Reverse LC';
				SCREW_STATE_EXIT:
					MachineStateString := 'SCREW - Exit';
					MACHINE_STATE_STRING := 'Exit';
			ELSE
				MachineStateString := 'SCREW - Invalid State: ';
				CONCAT(MachineStateString, TO_STRING(SCREW_STATE));
				MACHINE_STATE_STRING := 'Invalid';
			END_CASE
	
		FWP_MODE:
			MachineStateString := 'FWP';
			MACHINE_STATE_STRING := 'FWP';
	
		SETUP_MODE:
			MachineStateString := 'SETUP';
			MACHINE_STATE_STRING := 'Setup';
	
		ERROR_MODE:
			MachineStateString := 'ERROR';
			MACHINE_STATE_STRING := 'ERROR';
	
	ELSE
		MachineStateString := 'Invalid Operating Mode: ';
		CONCAT(MachineStateString, TO_STRING(MACHINE_MODE));
		MACHINE_STATE_STRING := 'Invalid';
	END_CASE
ELSE
	MACHINE_STATE_STRING := 'MANUAL';
	CASE MACHINE_MODE OF
		IDLE_MODE:
			MachineStateString := 'Idle (MANUAL)';
		TRACK_MODE:
			MachineStateString := 'Track Mode (MANUAL)';
		RWP_MODE:
			MachineStateString := 'RWP Mode (MANUAL)';
		SCREW_MODE:
			MachineStateString := 'Screw Mode (MANUAL)';
		FWP_MODE:
			MachineStateString := 'FWP Mode (MANUAL)';
		SETUP_MODE:
			MachineStateString := 'Setup Mode (MANUAL)';
		ERROR_MODE:
			MachineStateString := 'Error (MANUAL)';
	ELSE
		MachineStateString := 'Invalid Operating Mode: ';
		CONCAT(MachineStateString, TO_STRING(MACHINE_MODE));
		MACHINE_STATE_STRING := 'Invalid';
	END_CASE	
END_IF

IF INIT THEN
	(* This flag is meant for the HMI... when this goes TRUE on the HMI, then the HMI will send back TRUE on HMI_HAS_VALID_DATA so
		that the PLC can trust what it gets from the HMI. *)
	HMI_RECEIVED_PLC_DATA_1 := TRUE;	
	HMI_RECEIVED_PLC_DATA_2 := TRUE;
	HMI_RECEIVED_PLC_DATA_3 := TRUE;
	HMI_RECEIVED_PLC_DATA_4 := TRUE;
	HMI_RECEIVED_PLC_DATA_5 := TRUE;
	HMI_RECEIVED_PLC_DATA_6 := TRUE;
	HMI_RECEIVED_PLC_DATA_7 := TRUE;
	
	FOR Index := 1 TO SCREW_LENGTHS_COUNT DO
		SCREW_LENGTHS_CM_VALUE[Index] := pNVM1^.SCREW_LENGTHS_CM[Index];
		STANDARD_EMBEDMENT_CM_VALUE[Index] := pNVM1^.STANDARD_EMBEDMENT_CM[Index];
		HEAVY_EMBEDMENT_CM_VALUE[Index] := pNVM4^.HEAVY_EMBEDMENT_CM[Index];
		SCREW_LENGTH_COUNT_TRANSMIT[Index] := pNVM4^.SCREW_LENGTH_COUNT[Index];
	END_FOR;

	FOR Index := 1 TO FLOW_TABLE_SIZE DO
		UR_PRESSURE_INPUT_VALUE[Index] := pNVM4^.UR_PRESSURE_INPUT[Index];	
		AIR_FLOW_OUTPUT_VALUE[Index] := pNVM4^.AIR_FLOW_OUTPUT[Index];	
	END_FOR
	
	UC_END_RETRACT_HARD_VALUE := pNVM1^.UC_END_RETRACT_HARD;
	UC_END_RETRACT_SOFT_VALUE := pNVM4^.UC_END_RETRACT_SOFT;

	ROTATOR_SCREW_POS_VALUE := pNVM1^.ROTATOR_SCREW_POS;
	SCREW_STOP_THRESHOLD_VALUE := pNVM1^.SCREW_STOP_THRESHOLD;
	
// 	LOWER_CROWD_DRIVE_VEL_VALUE := pNVM1^.LOWER_CROWD_DRIVE_VEL; // deprecated sPersistent_1_AVAIL_03
	TORQUE_TUBE_PITCH_VALUE := pNVM1^.TORQUE_TUBE_PITCH;
	TRACKER_ROW_TYPE_VALUE := TO_UINT(pNVM4^.TRACKER_ROW_TYPE);
	NXT_TLM_3L_EMBEDMENT_CM_VALUE := pNVM4^.NXT_TLM_3L_EMBEDMENT_CM;
	NXT_TLM_3L_HEAVY_EMBEDMENT_CM_VALUE := pNVM4^.NXT_TLM_3L_HEAVY_EMBEDMENT_CM;
	NXT_TLM_T_ATOL_TO_WP_VALUE := pNVM4^.NXT_TLM_T_ATOL_TO_WP;
	NXT_TLM_3L_ATOL_TO_WP_VALUE := pNVM4^.NXT_TLM_3L_ATOL_TO_WP;
	NXT_TLM_3L_HEAVY_ATOL_TO_WP_VALUE := pNVM4^.NXT_TLM_3L_HEAVY_ATOL_TO_WP;
	NXT_TLM_T_ANGLE_VALUE := pNVM4^.NXT_TLM_T_ANGLE;

	LC_DRIVE_VEL_HI_VALUE := pNVM1^.LC_DRIVE_VEL_HI;
	LC_DRIVE_VEL_LOW_VALUE := pNVM1^.LC_DRIVE_VEL_LOW;
	UR_DRIVE_PRESSURE_HI_VALUE := pNVM1^.UR_DRIVE_PRESSURE_HI;
	UR_DRIVE_PRESSURE_LOW_VALUE := pNVM1^.UR_DRIVE_PRESSURE_LOW;
	SS_DRIVE_VEL_HI_VALUE := pNVM4^.SS_DRIVE_VEL_HI;
	SS_DRIVE_VEL_LOW_VALUE := pNVM4^.SS_DRIVE_VEL_LOW;
	LC_DRIVE_PRESSURE_HI_VALUE := pNVM4^.LC_DRIVE_PRESSURE_HI;
	LC_DRIVE_PRESSURE_LOW_VALUE := pNVM4^.LC_DRIVE_PRESSURE_LOW;
	SS_LC_PRELOAD_VALUE := pNVM4^.SS_LC_PRELOAD;
	SS_BIT_PROTRUSION_VALUE := pNVM4^.SS_BIT_PROTRUSION;
	SS_CLEAR_SPOILS_VALUE := pNVM4^.SS_CLEAR_SPOILS;
	SS_LC_STALL_TIME_VALUE := pNVM4^.SS_LC_STALL_TIME;
	SS_LC_STALL_PRESSURE_VALUE := pNVM4^.SS_LC_STALL_PRESSURE;
	SS_DETECT_BAND_VALUE := pNVM4^.SS_DETECT_BAND;
	SS_DETECT_TIME_VALUE := pNVM4^.SS_DETECT_TIME;
	SS_LC_CONTROL_SOURCE_VALUE := pNVM4^.SS_LC_CONTROL_SOURCE;
	SS_MAX_STALLS_VALUE := pNVM4^.SS_MAX_STALLS;
	SS_REVEAL_MAX_STALLS_VALUE := pNVM4^.SS_REVEAL_MAX_STALLS;
	
// 	MAST_SLIDE_COR_POS_VALUE := pNVM1^.MAST_SLIDE_COR_POS; // deprecated sPersistent_1_AVAIL_01
	LOWER_CROWD_COR_POS_VALUE := pNVM1^.LOWER_CROWD_COR_POS;

	CHUCK_TO_TARGET_VALUE := pNVM1^.CHUCK_TO_TARGET;
// 	LASER_OFFSET_VALUE := pNVM4^.LASER_OFFSET;
	ATOL_TO_WP_VALUE := pNVM1^.ATOL_TO_WP;
	
	SCREW_TIP_TO_GROUND_VALUE := pNVM1^.SCREW_TIP_TO_GROUND;
// 	SCREW_TIP_TO_START_VALUE := pNVM1^.SCREW_TIP_TO_START; // sPersistent_1_AVAIL_05
	LR_ENCODER_RES_VALUE := pNVM4^.LR_ENCODER_RES;
	
	HAMMER_ENABLED_VALUE := pNVM1^.HAMMER_ENABLED;
	HAMMER_CONTROL_SOURCE_VALUE := pNVM1^.HAMMER_CONTROL_SOURCE;
	HAMMER_ON_PRESSURE_VALUE := pNVM1^.HAMMER_ON_PRESSURE;
	HAMMER_OFF_PRESSURE_VALUE := pNVM1^.HAMMER_OFF_PRESSURE;

	EMBED_REDUCTION_ENABLED_VALUE := pNVM3^.EMBED_REDUCTION_ENABLED;
	EMBED_REDUCTION_DISTANCE_VALUE := pNVM3^.EMBED_REDUCTION_DISTANCE;
	EMBED_REDUCTION_HYSTERESIS_VALUE := pNVM3^.EMBED_REDUCTION_HYSTERESIS;
	EMBED_REDUCTION_MINIMUM_VALUE := pNVM3^.EMBED_REDUCTION_MINIMUM;

	UR_STALL_ENABLED_VALUE := pNVM3^.UR_STALL_ENABLED;
	UR_STALL_P_MIN_VALUE := pNVM3^.UR_STALL_P_MIN;
	UR_STALL_P_TIME_VALUE := pNVM3^.UR_STALL_P_TIME;
	UR_STALL_P_BAND_VALUE := pNVM3^.UR_STALL_P_BAND;
	UR_STALL_V_MAX_VALUE := pNVM3^.UR_STALL_V_MAX;
	UR_STALL_V_TIME_VALUE := pNVM3^.UR_STALL_V_TIME;
	UR_STALL_V_BAND_VALUE := pNVM3^.UR_STALL_V_BAND;
	
// 	LC_STALL_ENABLED_VALUE := pNVM4^.LC_STALL_ENABLED;
	sPersistent_4_AVAIL_03_VALUE := pNVM4^.sPersistent_4_AVAIL_03;
	LC_STALL_LR_ADVANCE_VALUE := pNVM4^.LC_STALL_LR_ADVANCE;
	LC_STALL_LR_OUTPUT_VALUE := pNVM4^.LC_STALL_LR_OUTPUT;
	
	AIR_COMPRESSOR_POWERED_VALUE := pNVM1^.AIR_COMPRESSOR_POWERED;
	AIR_ON_DISTANCE_VALUE := pNVM1^.AIR_ON_DISTANCE;
	AIR_OFF_DISTANCE_VALUE := pNVM1^.AIR_OFF_DISTANCE;

	WATER_USED_VALUE := pNVM3^.WATER_USED;
	WATER_PUMP_LPM_VALUE := pNVM3^.WATER_PUMP_LPM;
	WATER_DRILL_LPD_VALUE := pNVM3^.WATER_DRILL_LPD;
	WATER_HOVER_LPT_VALUE := pNVM4^.WATER_HOVER_LPT;
	WATER_ENTER_LPT_VALUE := pNVM4^.WATER_ENTER_LPT;
	WATER_HAMMER_RATIO_VALUE := pNVM4^.WATER_HAMMER_RATIO;
	
	UPPER_CROWD_DRILL_STEEL_VALUE := pNVM1^.UPPER_CROWD_DRILL_STEEL;	
	DRILL_BIT_LENGTH_VALUE := pNVM1^.DRILL_BIT_LENGTH;
	DRILL_BIT_THREAD_LENGTH_VALUE := pNVM1^.DRILL_BIT_THREAD_LENGTH;
	DRILL_BIT_DRIVE_PROTRUSION_VALUE := pNVM1^.DRILL_BIT_DRIVE_PROTRUSION;
	DRILL_BIT_LOAD_PROTRUSION_VALUE := pNVM1^.DRILL_BIT_LOAD_PROTRUSION;
	DRILL_BIT_WING_POSITION_VALUE := pNVM3^.DRILL_BIT_WING_POSITION;
	CHUCK_TO_BUSHING_VALUE := pNVM1^.CHUCK_TO_BUSHING;
	CHUCK_TO_TARGET_CLEARANCE_VALUE := pNVM1^.CHUCK_TO_BIT_TIP_TRAVEL;

	calcDrillBitValues();

	DRIVE_KVFF_VALUE := pNVM1^.DRIVE_KVFF;
	DRIVE_KP_VALUE := pNVM1^.DRIVE_KP;
	DRIVE_KI_VALUE := pNVM1^.DRIVE_KI;
	DRIVE_ILIMIT_VALUE := pNVM1^.DRIVE_ILIMIT;
	DRIVE_OUTPUT_MAX_VALUE := pNVM1^.DRIVE_OUTPUT_MAX;
	
	AIR_FLOW_REDUCED_VALUE := pNVM1^.AIR_FLOW_REDUCED;
	AIR_FLOW_VALUE := pNVM1^.AIR_FLOW;

	OUTRIGGER_ENABLED_VALUE := pNVM1^.OUTRIGGER_ENABLED;

	//MACHINE_VENDOR_VALUE := pNVM3^.MACHINE_VENDOR;	
	//MACHINE_FAMILY_VALUE := pNVM3^.MACHINE_FAMILY;	
	RIGHT_LEFT_DIFF_VALUE := pNVM3^.RIGHT_LEFT_DIFF;
	MAST_LEAN_VALUE := pNVM3^.MAST_LEAN;
	ATOL_TO_WP_MOTOR_VALUE := pNVM3^.ATOL_TO_WP_MOTOR;
// 	AUTO_PENDULUM_VALUE := pNVM3^.AUTO_PENDULUM; // sPersistent_3_AVAIL_05
	LOGIN_BYPASS_VALUE := pNVM3^.LOGIN_BYPASS;
	LOAD_UNLOAD_VALUE := pNVM4^.LOAD_UNLOAD;
	PRODUCT_INSTALL_VALUE := pNVM3^.PRODUCT_INSTALL;

	sPersistent_3_AVAIL_02_VALUE := pNVM3^.sPersistent_3_AVAIL_02;
	PRELOAD_SPEED_VALUE := pNVM3^.PRELOAD_SPEED;
	MANUAL_DEPTH_VALUE := pNVM3^.MANUAL_DEPTH;
// 	MOTOR_HAS_LASER_VALUE := pNVM4^.MOTOR_HAS_LASER_MOUNT;
	SOFT_SOIL_ENABLED_VALUE := pNVM4^.SOFT_SOIL_ENABLED;
	
	SCREW_PITCH_VALUE := pNVM4^.SCREW_PITCH_CM;
	PLUMB_SCREW_EMBEDMENT_VALUE := pNVM4^.PLUMB_SCREW_EMBEDMENT;
	
	MAX_ROLL_START_VALUE := pNVM4^.MAX_ROLL_START;
	MAX_PITCH_FWD_START_VALUE := pNVM4^.MAX_PITCH_FWD_START;
	MAX_PITCH_BACK_START_VALUE := pNVM4^.MAX_PITCH_BACK_START;
	MAX_ROLL_CONTINUE_VALUE := pNVM4^.MAX_ROLL_CONTINUE;
	MAX_PITCH_FWD_CONTINUE_VALUE := pNVM4^.MAX_PITCH_FWD_CONTINUE;
	MAX_PITCH_BACK_CONTINUE_VALUE := pNVM4^.MAX_PITCH_BACK_CONTINUE;
	MAX_BS_START_VALUE := pNVM4^.MAX_BS_START;

	LOWER_CROWD_ENCODER_TYPE_VALUE := pNVM4^.LOWER_CROWD_ENCODER_TYPE;

	DIAGS_TOPICS_LENGTH := NUM_DIAG_TOPICS; //sets transmitted value to TDX specific value
	
	// GPS
	GPS_VENDOR_VALUE := pNVM4^.GPS_VENDOR; 
	GPS_AUTOTARGET_SELECTION_VALUE := pNVM4^.GPS_AUTOTARGET_SELECTION;
	
	(*
	FOR Index := 1 TO NUM_GPS_AXES DO
	// FOR Index := LOWER_BOUND(GPS_AXES_SETTINGS_VALUES, 1) TO UPPER_BOUND(GPS_AXES_SETTINGS_VALUES, 1) DO
		GPS_AXES_SETTINGS_VALUES[Index, GPS_AXIS_IN_RANGE] := pNVM4^.GPS_AXES_SETTINGS[Index, GPS_AXIS_IN_RANGE];
		GPS_AXES_SETTINGS_VALUES[Index, GPS_AXIS_ON_TARGET] := pNVM4^.GPS_AXES_SETTINGS[Index, GPS_AXIS_ON_TARGET];
	END_FOR
	FOR Index := 1 TO SIZEOF(SET_GPS_GENERAL_SETTINGS) DO
	//FOR Index := LOWER_BOUND(GPS_GENERAL_SETTINGS_VALUES, 1) TO UPPER_BOUND(GPS_GENERAL_SETTINGS_VALUES, 1) DO
		GPS_GENERAL_SETTINGS_VALUES[Index] := pNVM4^.GPS_GENERAL_SETTINGS[Index];
	END_FOR
	//GPS_RTK_SIGNAL_WARNING_LIMIT := TO_USINT (pNVM4^.GPS_AXES_SETTINGS[6, GPS_AXIS_IN_RANGE]);
	//GPS_RTK_SIGNAL_CRITICAL_LIMIT := TO_USINT (pNVM4^.GPS_AXES_SETTINGS[6, GPS_AXIS_ON_TARGET]);     *)
	GPS_AXES_SETTINGS_VALUES := pNVM4^.GPS_AXES_SETTINGS;
	GPS_GENERAL_SETTINGS_VALUES := pNVM4^.GPS_GENERAL_SETTINGS;
	HMI_BOOLS_VALUES := pNVM4^.HMI_BOOLS;
	HMI_SINTS_VALUES := pNVM4^.HMI_SINTS;
	HMI_UINTS_VALUES := pNVM4^.HMI_UINTS;
	HMI_INTS_VALUES := pNVM4^.HMI_INTS;
	HMI_REALS_VALUES := pNVM4^.HMI_REALS;
	HMI_VECTORS_VALUES := pNVM4^.HMI_VECTORS;
	HMI_STRINGS_VALUES := pNVM4^.HMI_STRINGS;
END_IF

IF isNewModeEnabled() THEN
	IF SCREW_DRIVE_COMPLETE_REASON = eDataCollection.NEW_SCREW_DRIVE THEN // in a screw drive
		SCREW_DRIVE_COMPLETE_REASON := eDataCollection.SCREW_DRIVE_ENDED_BY_MODE_CHANGE; // exit screw drive due to mode change 
	END_IF
ELSIF MACHINE_MODE = ERROR_MODE THEN
	IF SCREW_DRIVE_COMPLETE_REASON = eDataCollection.NEW_SCREW_DRIVE THEN // in a screw drive
		SCREW_DRIVE_COMPLETE_REASON := eDataCollection.SCREW_DRIVE_ENDED_BY_ESTOP; // exit screw drive due to mode change 
	END_IF
END_IF

