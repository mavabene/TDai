IF td3_1.AXES[td3_1.AXIS_PENDULUM].OUTPUT.MAGNITUDE <> 0 THEN
	PLC_TRANSMIT_6.HMI_BOOLS_VALUES[ET_PLUMB_TRACKS_TO_BASE_PITCH_MATCHED] := FALSE;
END_IF


// updates transmitted array of diagnostic info
FOR Index := 2 TO NUM_DIAG_TOPICS DO
	updateDIAG(INDEX := Index, pDIAG := WIRED_OUTS[Index]);	
END_FOR

// Plotting
IF TRACE_PARAMETER_SELECT = 0  THEN
	TRACE_RUN := FALSE;
ELSIF TRACE_PARAMETER_SELECT = 1 THEN
	TRACE_PARAMETER_VEL := MAST_PITCH.VELOCITY_ENGR;
	TRACE_PARAMETER_SETPOINT := 0;
	TRACE_PARAMETER_POSITION := MAST_PITCH.POSITION_ENGR;
	TRACE_PARAMETER_VALVE_ACTUATION := 0;
ELSIF TRACE_PARAMETER_SELECT < 16 THEN // controlled actuators
	TRACE_PARAMETER_VEL := AXES[TRACE_PARAMETER_SELECT].FEEDBACK.VELOCITY_ENGR;
	TRACE_PARAMETER_SETPOINT := getPositionSetpointEngr(AXES[TRACE_PARAMETER_SELECT]);
	TRACE_PARAMETER_POSITION := AXES[TRACE_PARAMETER_SELECT].FEEDBACK.POSITION_ENGR;
	TRACE_PARAMETER_VALVE_ACTUATION := getReadableOutput(AXES[TRACE_PARAMETER_SELECT]);
ELSE // figure out what to put here to display - 
	TRACE_PARAMETER_VEL := 0;
	TRACE_PARAMETER_SETPOINT := 0;
	TRACE_PARAMETER_POSITION := 0;
	TRACE_PARAMETER_VALVE_ACTUATION := 0;
END_IF



