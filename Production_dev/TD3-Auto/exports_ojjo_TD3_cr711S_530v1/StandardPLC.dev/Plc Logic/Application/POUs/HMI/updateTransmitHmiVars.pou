	//HAWE_AXES_SETPOINT[Hawe_Index] := (AXES[Hawe_Index].CONFIG.HAWE_VPOC.pVPOC_CMD^ ;
	HAWE_AXES_SETPOINT[Hawe_Index] := SHL(TO_DWORD(AXES[Hawe_Index].CONFIG.HAWE_VPOC.pVPOC_CMD^), 16) OR TO_DWORD(AXES[Hawe_Index].CONFIG.HAWE_VPOC.pDCW^);

	HAWE_AXES_DSW[Hawe_Index] := TO_DWORD(AXES[Hawe_Index].CONFIG.HAWE_VPOC.pDSW^) ;
