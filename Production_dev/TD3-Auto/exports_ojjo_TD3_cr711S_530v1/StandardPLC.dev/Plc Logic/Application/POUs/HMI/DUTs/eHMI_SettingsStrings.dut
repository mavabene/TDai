
(********************** Declaration ****************************)
(* 	These var names correlate to HMI_SINTS array values.  
	To add persistent SINTs, just add name here and call via HMI_SINTS[ENUM_NAME]
	!! If you change positions, persistent memory will be affected! !!
	** Updates here must be made in both PLC and HMI code **
*)
TYPE eHMI_SettingsStrings :
(
	
	DRILL_SETTINGS_CONFIG_VERSION := 1,
    JOB_SETTINGS_CONFIG_VERSION := 2,
    GENERAL_SETTINGS_CONFIG_VERSION := 3,
    TD_SPECIFIC_SETTINGS_CONFIG_VERSION := 4,
    eHMI_SettingsStrings_RESERVED_5 := 5,
    eHMI_SettingsStrings_RESERVED_6 := 6,
    eHMI_SettingsStrings_RESERVED_7 := 7,
    eHMI_SettingsStrings_RESERVED_8 := 8,
    eHMI_SettingsStrings_RESERVED_9 := 9,
	eHMI_SettingsStrings_RESERVED_10 := 10,
    eHMI_SettingsStrings_RESERVED_11 := 11,
    eHMI_SettingsStrings_RESERVED_12 := 12,
    eHMI_SettingsStrings_RESERVED_13 := 13,
    eHMI_SettingsStrings_RESERVED_14 := 14,
    eHMI_SettingsStrings_RESERVED_15 := 15,
    eHMI_SettingsStrings_RESERVED_16 := 16,
    eHMI_SettingsStrings_RESERVED_17 := 17,
    eHMI_SettingsStrings_RESERVED_18 := 18,
    eHMI_SettingsStrings_RESERVED_19 := 19,
	eHMI_SettingsStrings_RESERVED_20 := 20
);
END_TYPE
