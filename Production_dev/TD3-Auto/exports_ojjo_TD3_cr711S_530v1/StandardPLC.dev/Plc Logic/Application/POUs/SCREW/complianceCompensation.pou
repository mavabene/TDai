
(********************** Declaration ****************************)
FUNCTION_BLOCK complianceCompensation
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	//MAST_LOADED_TRANSITION_PRESSURE: REAL := 2600;
	(*
	// TODO: size hardcoded
	CP_PITCH_SMALL_DETECTED: BOOL;
	CP_PITCH_SMALL_START: REAL;
	CP_PITCH_SMALL: ARRAY[1..300] OF REAL;
	CP_PITCH_SMALL_HEAD: INT;
	CP_PITCH_SMALL_FILLED: BOOL := FALSE;
	CP_PITCH_SMALL_SAMPLES: INT;
	CP_PITCH_SMALL_AVG: REAL;
	CP_PITCH_SMALL_FRACTION: REAL;
	
	CP_PITCH_LARGE_DETECTED: BOOL;
	CP_PITCH_LARGE_START: REAL;
	CP_PITCH_LARGE: ARRAY[1..300] OF REAL;
	CP_PITCH_LARGE_HEAD: INT;
	CP_PITCH_LARGE_FILLED: BOOL := FALSE;
	CP_PITCH_LARGE_SAMPLES: INT;
	CP_PITCH_LARGE_AVG: REAL;
	CP_PITCH_LARGE_FRACTION: REAL;
	
	// BASE roll.
	CP_BASE_ROLL_DETECTED: BOOL;
	CP_BASE_ROLL_START: REAL;
	CP_BASE_ROLL: ARRAY[1..300] OF REAL;
	CP_BASE_ROLL_HEAD: INT;
	CP_BASE_ROLL_FILLED: BOOL := FALSE;
	CP_BASE_ROLL_SAMPLES: INT;
	CP_BASE_ROLL_AVG: REAL;
	CP_BASE_ROLL_FRACTION: REAL;

	// BASE pitch.
	CP_BASE_PITCH_DETECTED: BOOL;
	CP_BASE_PITCH_START: REAL;
	CP_BASE_PITCH: ARRAY[1..300] OF REAL;
	CP_BASE_PITCH_HEAD: INT;
	CP_BASE_PITCH_FILLED: BOOL := FALSE;
	CP_BASE_PITCH_SAMPLES: INT;
	CP_BASE_PITCH_AVG: REAL;
	CP_BASE_PITCH_FRACTION: REAL; *)
	MAIN_PUMP_PRESSURE_RUNNING_AVG :REAL := 0;
	
	PRELOAD_PLUMB_MAST_PRESSURE: REAL := 1900;
	
	
	PRELOAD_PRESSURE_HEAD: INT;
	// look for preload complete:
	PRELOAD_PRESSSURE_DATA: ARRAY [1..20] OF REAL;
	
	// Current value of the variable being monitored
	CURRENT: REAL;
	// How far does the band extend from the center?
	BAND_SIZE: REAL;
	
	// Preload comp
	// Whether or not we have wrapped one time.
	FILLED: BOOL := FALSE;
	pFILLED: POINTER TO BOOL;
		// Minimum reading within the current window.
	MIN_VAL: REAL;
	// Maximum reading within the current window.
	MAX_VAL: REAL;
	// Minimum reading within the current window.
	AVG_VAL: REAL;
	// Fraction of values in the window that are within the given band.
	FRACTION_IN_BAND: REAL;
	
	// Mast Plumb trigger
	MAST_PLUMB_PRESSURE_HEAD: INT;
	// look for mast tilt correction to begin
	BEGIN_MAST_PLUMB_PRESSSURE_DATA: ARRAY [1..20] OF REAL;
	
	FILLED_MAST_PLUMB: BOOL := FALSE;
	pFILLED_MAST_PLUMB: POINTER TO BOOL;
		// Minimum reading within the current window.
	MIN_VAL_MAST_PLUMB: REAL;
	// Maximum reading within the current window.
	MAX_VAL_MAST_PLUMB: REAL;
	// Minimum reading within the current window.
	AVG_VAL_MAST_PLUMB: REAL;
	// Fraction of values in the window that are within the given band.
	FRACTION_IN_BAND_MAST_PLUMB: REAL;
	
	// iteration index
	INDEX: USINT := 1;
	START: BOOL := FALSE;
END_VAR

(********************** Implementation ****************************)
IF NOT START AND PUMP_PRESSURE < (pNVM4^.HMI_UINTS[MAST_LOADED_TRANSITION_PRESSURE] - 200) THEN
	START := TRUE;
END_IF

IF (SCREW_STATE = SCREW_STATE_PRELOAD_COMPLIANCE AND pNVM4^.HMI_BOOLS[AUTO_PRELOAD_ON]) THEN
	IF isScrewModeStateChange() AND SCREW_STATE = SCREW_STATE_PRELOAD_COMPLIANCE THEN
		// Entering screw drive, start logic looking for upper rotary stall.  First, reset dynamic information.
		//PRELOAD_COMPLETE := FALSE;
		START := FALSE;
		PRELOAD_PRESSURE_HEAD := 1;
		FILLED := FALSE;
		FRACTION_IN_BAND := 0;
		MAST_PLUMB_PRESSURE_HEAD := 1;
		FILLED_MAST_PLUMB := FALSE;
		FILLED_MAST_PLUMB := FALSE;
		FOR INDEX := 1 TO 20 DO
			PRELOAD_PRESSSURE_DATA[INDEX] := 0;
			BEGIN_MAST_PLUMB_PRESSSURE_DATA[INDEX] := 0;
		END_FOR
		PRELOAD_PLUMB_MAST := FALSE;
		(*
		CP_PITCH_SMALL_START := AXES[AXIS_PITCH].FEEDBACK.POSITION_ENGR;
		CP_PITCH_LARGE_START := AXES[AXIS_PITCH].FEEDBACK.POSITION_ENGR;
		CP_BASE_ROLL_START := BASE_ROLL.POSITION_ENGR;
		CP_BASE_PITCH_START := BASE_PITCH.POSITION_ENGR;

		CP_PITCH_SMALL_HEAD := 1;
		CP_PITCH_SMALL_FILLED := FALSE;
	
		CP_PITCH_LARGE_HEAD := 1;
		CP_PITCH_LARGE_FILLED := FALSE;
	
		CP_BASE_PITCH_HEAD := 1;
		CP_BASE_PITCH_FILLED := FALSE;
	
		CP_BASE_ROLL_HEAD := 1;
		CP_BASE_ROLL_FILLED := FALSE;
	
		// Calculate number of samples in the time window.
		// TODO: hardcode
		CP_PITCH_SMALL_SAMPLES := TO_INT(3.5 * CONTROL_FREQ_HZ);
		CP_PITCH_LARGE_SAMPLES := TO_INT(1.3 * CONTROL_FREQ_HZ);
		CP_BASE_PITCH_SAMPLES := TO_INT(1 * CONTROL_FREQ_HZ);
		CP_BASE_ROLL_SAMPLES := TO_INT(1 * CONTROL_FREQ_HZ);
		
		CP_PITCH_SMALL_DETECTED := FALSE;
		CP_PITCH_LARGE_DETECTED := FALSE;
		CP_BASE_PITCH_DETECTED := FALSE;
		CP_BASE_ROLL_DETECTED := FALSE; *)
	ELSIF SCREW_STATE = SCREW_STATE_PRELOAD_COMPLIANCE AND START THEN
		// Perform this calculation only when preloading the front end.
		
		(*
		withinAdaptiveBand(
			DATA := CP_PITCH_SMALL, 
			CURRENT := AXES[AXIS_PITCH].FEEDBACK.POSITION_ENGR - CP_PITCH_SMALL_START,
			pHEAD := ADR(CP_PITCH_SMALL_HEAD), 
			pFILLED := ADR(CP_PITCH_SMALL_FILLED), 
			SAMPLES := CP_PITCH_SMALL_SAMPLES, 
			pMIN_OR_MAX_OR_AVG := ADR(CP_PITCH_SMALL_AVG), 
			pFRACTION_IN_BAND := ADR(CP_PITCH_SMALL_FRACTION),
			// TODO: hardcoded
			BAND_SIZE := 0.05, 
			LIM_USED := FALSE, 
			LIM := 0.0, 
			FUNC := eAdaptiveBandFunc.FUNCTION_AVG);
			
		withinAdaptiveBand(
			DATA:= CP_PITCH_LARGE, 
			CURRENT:= AXES[AXIS_PITCH].FEEDBACK.POSITION_ENGR - CP_PITCH_LARGE_START,
			pHEAD:= ADR(CP_PITCH_LARGE_HEAD), 
			pFILLED:= ADR(CP_PITCH_LARGE_FILLED), 
			SAMPLES:= CP_PITCH_LARGE_SAMPLES, 
			pMIN_OR_MAX_OR_AVG:= ADR(CP_PITCH_LARGE_AVG), 
			pFRACTION_IN_BAND:= ADR(CP_PITCH_LARGE_FRACTION),
			// TODO: hardcoded
			BAND_SIZE:= 0.3, 
			LIM_USED:= FALSE, 
			LIM:= 0.0, 
			FUNC:= eAdaptiveBandFunc.FUNCTION_AVG);
			
		withinAdaptiveBand(
			DATA:= CP_BASE_PITCH, 
			CURRENT:= ABS(BASE_PITCH.POSITION_ENGR - CP_BASE_PITCH_START),
			pHEAD:= ADR(CP_BASE_PITCH_HEAD), 
			pFILLED:= ADR(CP_BASE_PITCH_FILLED), 
			SAMPLES:= CP_BASE_PITCH_SAMPLES, 
			pMIN_OR_MAX_OR_AVG:= ADR(CP_BASE_PITCH_AVG), 
			pFRACTION_IN_BAND:= ADR(CP_BASE_PITCH_FRACTION),
			// TODO: hardcoded
			BAND_SIZE:= 0.5, 
			LIM_USED:= FALSE, 
			LIM:= 0.0, 
			FUNC:= eAdaptiveBandFunc.FUNCTION_AVG);
			
		withinAdaptiveBand(
			DATA:= CP_BASE_ROLL, 
			CURRENT:= ABS(BASE_ROLL.POSITION_ENGR - CP_BASE_ROLL_START),
			pHEAD:= ADR(CP_BASE_ROLL_HEAD), 
			pFILLED:= ADR(CP_BASE_ROLL_FILLED), 
			SAMPLES:= CP_BASE_ROLL_SAMPLES, 
			pMIN_OR_MAX_OR_AVG:= ADR(CP_BASE_ROLL_AVG), 
			pFRACTION_IN_BAND:= ADR(CP_BASE_ROLL_FRACTION),
			// TODO: hardcoded
			BAND_SIZE:= 0.5, 
			LIM_USED:= FALSE, 
			LIM:= 0.0, 
			FUNC:= eAdaptiveBandFunc.FUNCTION_AVG);
			
			IF (
				CP_PITCH_SMALL_FILLED AND
				(CP_PITCH_SMALL_FRACTION >= 0.95) AND
				// TODO: hardcoded
				(CP_PITCH_SMALL_AVG >= pNVM3^.PRELOAD_ANGLE_DELTA)
			) THEN
				CP_PITCH_SMALL_DETECTED := TRUE;
			END_IF
			
			IF (
				CP_PITCH_LARGE_FILLED AND
				(CP_PITCH_LARGE_FRACTION >= 0.95) AND
				(CP_PITCH_LARGE_AVG >= 1.8)
			) THEN
				CP_PITCH_LARGE_DETECTED := TRUE;
			END_IF

			IF (
				CP_BASE_PITCH_FILLED AND
				(CP_BASE_PITCH_FRACTION >= 0.95) AND
				(CP_BASE_PITCH_AVG >= 1.8)
			) THEN
				CP_BASE_PITCH_DETECTED := TRUE;
			END_IF

			IF (
				CP_BASE_ROLL_FILLED AND
				(CP_BASE_ROLL_FRACTION >= 0.95) AND
				(CP_BASE_ROLL_AVG >= 1.8)
			) THEN
				CP_BASE_ROLL_DETECTED := TRUE;
			END_IF
			
		IF CP_PITCH_SMALL_DETECTED OR CP_PITCH_LARGE_DETECTED OR CP_BASE_PITCH_DETECTED OR CP_BASE_ROLL_DETECTED THEN
			// Upper rotary stall detected, change state to screw drive assist to save hammering.
			PRELOAD_COMPLETE := TRUE;
		END_IF *)
		
		// check for pressure average over 20/50 of a second is greater than setting:
		withinFixedBand(
			DATA := PRELOAD_PRESSSURE_DATA,
			HEAD := PRELOAD_PRESSURE_HEAD,
			CURRENT := PUMP_PRESSURE,
			SAMPLES := 20,
			BAND_CENTER := 0,
			BAND_SIZE := pNVM4^.HMI_UINTS[MAST_LOADED_TRANSITION_PRESSURE],
			pFILLED := ADR(FILLED),
			MN => MIN_VAL,
			MX => MAX_VAL,
			AVG => AVG_VAL,
			FRACTION_IN_BAND => FRACTION_IN_BAND
			);
			
		IF FILLED AND FRACTION_IN_BAND < 0.05 THEN
			PRELOAD_COMPLETE := TRUE;
		ELSE
			PRELOAD_COMPLETE := FALSE;
		END_IF
		
		// check for pressure average over 20/50 of a second is greater than setting:
		withinFixedBand(
			DATA := BEGIN_MAST_PLUMB_PRESSSURE_DATA,
			HEAD := MAST_PLUMB_PRESSURE_HEAD,
			CURRENT := PUMP_PRESSURE,
			SAMPLES := 20,
			BAND_CENTER := 0,
			BAND_SIZE := PRELOAD_PLUMB_MAST_PRESSURE,
			pFILLED := ADR(FILLED_MAST_PLUMB),
			MN => MIN_VAL_MAST_PLUMB,
			MX => MAX_VAL_MAST_PLUMB,
			AVG => AVG_VAL_MAST_PLUMB,
			FRACTION_IN_BAND => FRACTION_IN_BAND_MAST_PLUMB
			);
			
		IF HMI_BOOLS_VALUES[PRELOAD_AUTO_MAST_LEAN_COMPENSATION] 
			AND 
				((FILLED_MAST_PLUMB AND FRACTION_IN_BAND_MAST_PLUMB < 0.05) // pressure is reached
				OR 
				FILLED AND FRACTION_IN_BAND < 0.50 ) // activate before completing preload
			THEN
			PRELOAD_PLUMB_MAST := TRUE;
		ELSE
			PRELOAD_PLUMB_MAST := FALSE;
		END_IF
		(*
		IF PUMP_PRESSURE > pNVM4^.HMI_UINTS[MAST_LOADED_TRANSITION_PRESSURE] THEN
			PRELOAD_COMPLETE := TRUE;
		END_IF
		*)
	END_IF
END_IF
