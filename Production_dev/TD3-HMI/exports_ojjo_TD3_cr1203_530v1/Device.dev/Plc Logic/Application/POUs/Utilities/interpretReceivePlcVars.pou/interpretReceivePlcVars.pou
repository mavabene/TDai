
(********************** Declaration ****************************)
FUNCTION_BLOCK interpretReceivePlcVars

VAR_INPUT
END_VAR

VAR
	DIAG_TEMP: ifmTypes2.eDIAG_INFO;
	PLC_WATCHDOG_LAST: DWORD := 0;
	PLC_WATCHDOG_TON: TON;
	PLC_WATCHDOG_START: DWORD := 0;
	PLC_WATCHDOG_DELTA: DWORD;
	
	NEED_COMMA: BOOL;
	RtnVal: BOOL;
	WARNINGS: INT := 0;
	
	GetTemperatures0: ifmDevice.GetTemperaturesCyclic;
	
	i: INT;
	
	TIME_SECONDS_PLC: DWORD;
	
	Hawe_Index : INT;
	
	OLD_MACHINE_STATE: STRING(50);
END_VAR
(********************** Implementation ****************************)
updateXmitRecvCounts(ADR(XMIT_1_COUNT), ADR(XMIT_1_COUNT_LAST), ADR(RECV_1_COUNT), ADR(XMIT_1_COUNT_LAST), ADR(RECV_1_INTERVAL));
updateXmitRecvCounts(ADR(XMIT_2_COUNT), ADR(XMIT_2_COUNT_LAST), ADR(RECV_2_COUNT), ADR(XMIT_2_COUNT_LAST), ADR(RECV_2_INTERVAL));
updateXmitRecvCounts(ADR(XMIT_3_COUNT), ADR(XMIT_3_COUNT_LAST), ADR(RECV_3_COUNT), ADR(XMIT_3_COUNT_LAST), ADR(RECV_3_INTERVAL));
updateXmitRecvCounts(ADR(XMIT_5_COUNT), ADR(XMIT_5_COUNT_LAST), ADR(RECV_5_COUNT), ADR(XMIT_5_COUNT_LAST), ADR(RECV_5_INTERVAL));
//TODO: add this functionality:
//updateXmitRecvCounts(ADR(XMIT_6_COUNT), ADR(XMIT_6_COUNT_LAST), ADR(RECV_6_COUNT), ADR(XMIT_6_COUNT_LAST), ADR(RECV_6_INTERVAL));
//updateXmitRecvCounts(ADR(XMIT_7_COUNT), ADR(XMIT_7_COUNT_LAST), ADR(RECV_7_COUNT), ADR(XMIT_7_COUNT_LAST), ADR(RECV_7_INTERVAL));


IF TO_DWORD(TIME_SECONDS_FLOAT) <> TIME_SECONDS_PLC THEN
	// Sometimes have a problem where this doesn't transmit on powerup because the "changed" packet gets
	//	dropped in UDP.
	TRANSMIT_1.HMI_XMIT_COUNT := TRANSMIT_1.HMI_XMIT_COUNT + 1;
	TIME_SECONDS_PLC := TO_DWORD(TIME_SECONDS_FLOAT);
END_IF

(* Convert the byte arrays in the network variables to the easier to handle string data type. *)
RtnVal := CharArrayToString(PtrByteArrayIn := ADR(MACHINE_STATE_TRANSMIT), PtrStringOut := ADR(MACHINE_STATE), ByteArraySize := 50);

RtnVal := CharArrayToString(PtrByteArrayIn := ADR(PLC_VERSION_TRANSMIT), PtrStringOut := ADR(PLC_VERSION), ByteArraySize := 20);

HARDWARE_VERSION := 'TD';
HARDWARE_VERSION := CONCAT(HARDWARE_VERSION, TO_STRING(MACHINE_FAMILY_TRANSMIT));
HARDWARE_VERSION := CONCAT(HARDWARE_VERSION, '.');
HARDWARE_VERSION := CONCAT(HARDWARE_VERSION, TO_STRING(MACHINE_VERSION_VALUE));

// Serial numbers formatted a little differently on different builds.
MACHINE_SERIAL_STRING := 'TD3.';
IF MACHINE_VERSION_VALUE = 0 THEN
	MACHINE_SERIAL_STRING := CONCAT(MACHINE_SERIAL_STRING, '0-DZ0');
ELSIF MACHINE_VERSION_VALUE = 1 THEN
	MACHINE_SERIAL_STRING := CONCAT(MACHINE_SERIAL_STRING, '1-DU0');
ELSIF MACHINE_VERSION_VALUE = 2 THEN
	MACHINE_SERIAL_STRING := CONCAT(MACHINE_SERIAL_STRING, '2-DD0');
ELSIF MACHINE_VERSION_VALUE = 3 THEN
	MACHINE_SERIAL_STRING := CONCAT(MACHINE_SERIAL_STRING, '3-DQ0');
ELSE 
	MACHINE_SERIAL_STRING := 'INVALID';
END_IF
MACHINE_SERIAL_STRING := CONCAT(MACHINE_SERIAL_STRING, TO_STRING(MACHINE_SERIAL_VALUE));
MQTT_MACHINE_SERIAL := MACHINE_SERIAL_STRING;

	
// Have we heard from the PLC?
IF NOT (PLC_LOST AND PLC_WATCHDOG_LAST > 1000) THEN
	IF PLC_WATCHDOG > PLC_WATCHDOG_LAST THEN
		PLC_WATCHDOG_LAST := PLC_WATCHDOG;
		// We measure watchdog expiration with local clock.
		PLC_WATCHDOG_START := HMI_WATCHDOG;
		PLC_WATCHDOG_TON(IN := FALSE, PT := T#1S, Q => PLC_LOST);
		NVM.LAST_PLC_VERSION := Received_Strings.PLC_VERSION;
	ELSIF PLC_WATCHDOG < PLC_WATCHDOG_LAST THEN
		// Watchdog has gone DOWN, other side must have rebooted.
		PLC_LOST := TRUE;
		//PLC_WATCHDOG_LAST := 0; or some small value??
	ELSE
		// Haven't heard!
		PLC_WATCHDOG_DELTA := HMI_WATCHDOG - PLC_WATCHDOG_START;
		IF (PLC_WATCHDOG_DELTA) > PLC_WATCHDOG_MAX AND PLC_WATCHDOG_START <> 0 THEN
			PLC_WATCHDOG_MAX := PLC_WATCHDOG_DELTA;
		END_IF
		PLC_WATCHDOG_TON(IN := TRUE, PT := T#1S, Q => PLC_LOST);
	END_IF
END_IF

IF PLC_LOST THEN
	HMI_HAS_VALID_DATA := FALSE;
	HMI_RECEIVED_PLC_DATA_1 := FALSE;
	HMI_RECEIVED_PLC_DATA_2 := FALSE;
	HMI_RECEIVED_PLC_DATA_3 := FALSE;
	HMI_RECEIVED_PLC_DATA_4 := FALSE;
	HMI_RECEIVED_PLC_DATA_5 := FALSE;
	HMI_RECEIVED_PLC_DATA_6 := FALSE;
	HMI_RECEIVED_PLC_DATA_7 := FALSE;
	HMI_PLC_SYNCH_1_TOP := FALSE;
	HMI_PLC_SYNCH_2_TOP := FALSE;
	HMI_PLC_SYNCH_3_TOP := FALSE;
	HMI_PLC_SYNCH_5_TOP := FALSE;
	HMI_PLC_SYNCH_6_TOP := FALSE;
	HMI_PLC_SYNCH_7_TOP := FALSE;
	HMI_PLC_SYNCH_1_BOTTOM := FALSE;
	HMI_PLC_SYNCH_2_BOTTOM := FALSE;
	HMI_PLC_SYNCH_3_BOTTOM := FALSE;
	HMI_PLC_SYNCH_5_BOTTOM := FALSE;
	HMI_PLC_SYNCH_6_BOTTOM := FALSE;
	HMI_PLC_SYNCH_7_BOTTOM := FALSE;
	HMI_SYNCH_STARTED := FALSE;
	HMI_COMPLETE_SYNCH := FALSE;
END_IF

ERRORS_COLOR := FALSE;
IF NOT HMI_RECEIVED_PLC_DATA_1 OR NOT
	HMI_RECEIVED_PLC_DATA_2 OR NOT
	HMI_RECEIVED_PLC_DATA_3 OR NOT
	HMI_RECEIVED_PLC_DATA_5 OR NOT
	HMI_RECEIVED_PLC_DATA_6 OR NOT
	HMI_RECEIVED_PLC_DATA_7(* @TODO after info on PLC working!  OR NOT HMI_RECEIVED_PLC_DATA_4 *) THEN
	Visualization_Variables.ERRORS := 'PLC not communicating';
	ERRORS_COLOR := TRUE;
ELSIF PLC_LOST THEN
	Visualization_Variables.ERRORS := 'PLC communication lost';
	ERRORS_COLOR := TRUE;
ELSIF NOT(RECEIVE_1.rf_CANlink) THEN
	// Machine won't work without remote!
	Visualization_Variables.ERRORS := 'Remote not detected';
	ERRORS_COLOR := TRUE;
ELSIF (RECEIVE_1.ESTOP_CURRENT <> 0) OR (RECEIVE_1.FEEDBACK_FAIL_CURRENT <> 0) OR (RECEIVE_1.VALVE_FAIL_CURRENT <> 0) OR (RECEIVE_1.VALVE_COMM_CURRENT <> 0) THEN
	Visualization_Variables.ERRORS := '';
	NEED_COMMA := FALSE;
	IF (RECEIVE_1.ESTOP_CURRENT <> 0) THEN
		Visualization_Variables.ERRORS := CONCAT(Visualization_Variables.ERRORS, 'Estop condition');
		NEED_COMMA := TRUE;
	END_IF
	IF (RECEIVE_1.FEEDBACK_FAIL_CURRENT <> 0) THEN
		IF NEED_COMMA THEN
			Visualization_Variables.ERRORS := CONCAT(Visualization_Variables.ERRORS, ', ');
		END_IF
		Visualization_Variables.ERRORS := CONCAT(Visualization_Variables.ERRORS, 'Feedback fail');
		NEED_COMMA := TRUE;
	END_IF
	IF (RECEIVE_1.VALVE_FAIL_CURRENT <> 0) THEN
		IF NEED_COMMA THEN
			Visualization_Variables.ERRORS := CONCAT(Visualization_Variables.ERRORS, ', ');
		END_IF
		Visualization_Variables.ERRORS := CONCAT(Visualization_Variables.ERRORS, 'Valve fail: ');
		Visualization_Variables.ERRORS := CONCAT(Visualization_Variables.ERRORS, TO_STRING(RECEIVE_1.VALVE_FAIL_CURRENT));
		NEED_COMMA := TRUE;
	END_IF
	IF (RECEIVE_1.VALVE_COMM_CURRENT <> 0) THEN
		IF NEED_COMMA THEN
			Visualization_Variables.ERRORS := CONCAT(Visualization_Variables.ERRORS, ', ');
		END_IF
		Visualization_Variables.ERRORS := CONCAT(Visualization_Variables.ERRORS, 'Valve comm');
		NEED_COMMA := TRUE;
	END_IF
	
	ERRORS_COLOR := TRUE;
ELSIF RECEIVE_1.MACHINE_MODE_TRANSMIT = ERROR_MODE THEN
	Visualization_Variables.ERRORS := LAST_ERROR_STRING;
	ERRORS_COLOR := TRUE;
ELSE
	Visualization_Variables.ERRORS := '';
END_IF;

ERROR_WARNING := (RECEIVE_1.ESTOP_CURRENT <> 0) OR (RECEIVE_1.FEEDBACK_FAIL_CURRENT <> 0) OR (RECEIVE_1.VALVE_FAIL_CURRENT <> 0) OR (RECEIVE_1.VALVE_COMM_CURRENT <> 0) OR (RECEIVE_1.WARNING_CURRENT <> 0);

IF NOT(RECEIVE_1.rf_CANlink) THEN
	ERROR_WARNING_MSG := 'Remote fail';
ELSIF RECEIVE_1.ESTOP_CURRENT <> 0 THEN
	ERROR_WARNING_MSG := 'ESTOP active';
ELSIF RECEIVE_1.FEEDBACK_FAIL_CURRENT <> 0 THEN
	ERROR_WARNING_MSG := 'FEEDBACK failure';
ELSIF RECEIVE_1.VALVE_FAIL_CURRENT <> 0 THEN
	ERROR_WARNING_MSG := 'VALVE failure';
ELSIF RECEIVE_1.VALVE_COMM_CURRENT <> 0 THEN
	ERROR_WARNING_MSG := 'VALVE communication';
ELSIF WARNING_CURRENT <> 0 THEN
	ERROR_WARNING_MSG := 'WARNING active';
ELSE
	ERROR_WARNING_MSG := 'Normal Operation';
END_IF

demuxBitmasks();
warningNotification();

// Handle HMI temperature readings.
GetTemperatures0(xEnable := TRUE, stTemperatures => Temperatures, eDiagInfo => DIAG_TEMP);

IF DIAG_TEMP = ifmTypes2.eDIAG_INFO.STAT_DONE THEN
	IF Temperatures.rCore0 > NVM.HMI_CHIP_TEMP_MAX THEN
		NVM.HMI_CHIP_TEMP_MAX := Temperatures.rCore0;
	ELSIF Temperatures.rCore0 < NVM.HMI_CHIP_TEMP_MIN THEN
		NVM.HMI_CHIP_TEMP_MIN := Temperatures.rCore0;
	END_IF
	
	IF Temperatures.rBoard > NVM.HMI_BOARD_TEMP_MAX THEN
		NVM.HMI_BOARD_TEMP_MAX := Temperatures.rBoard;
	ELSIF Temperatures.rBoard < NVM.HMI_BOARD_TEMP_MIN THEN
		NVM.HMI_BOARD_TEMP_MIN := Temperatures.rBoard;
	END_IF
END_IF

(* Handle the display colors where we can. *)
showRedYellowGreen(VALUE := FUEL_LEVEL, RED_HIGH := 101, RED_LOW := 15, YELLOW_HIGH := 101, YELLOW_LOW := 25, pCOLOR := ADR(FUEL_LEVEL_COLOR));
showRedYellowGreen(VALUE := HYDRAULIC_TEMP, RED_HIGH := 80, RED_LOW := 10, YELLOW_HIGH := 75, YELLOW_LOW := 25, pCOLOR := ADR(HYDRAULIC_TEMP_COLOR));
showRedYellowGreen(VALUE := ENGINE_RPM, RED_HIGH := 2400, RED_LOW := 700, YELLOW_HIGH := 2300, YELLOW_LOW := 2000, pCOLOR := ADR(ENGINE_RPM_COLOR));
showRedYellowGreen(VALUE := ENGINE_OIL_TEMP, RED_HIGH := 100, RED_LOW := 10, YELLOW_HIGH := 95, YELLOW_LOW := 70, pCOLOR := ADR(ENGINE_OIL_TEMP_COLOR));
showRedYellowGreen(VALUE := BASE_PITCH_TRANSMIT, RED_HIGH := 7, RED_LOW := -10, YELLOW_HIGH := 5, YELLOW_LOW := -7, pCOLOR := ADR(BASE_PITCH_COLOR));
showRedYellowGreen(VALUE := BASE_ROLL_TRANSMIT, RED_HIGH := 10, RED_LOW := -10, YELLOW_HIGH := 7, YELLOW_LOW := -7, pCOLOR := ADR(BASE_ROLL_COLOR));

showRedYellowGreen(VALUE := PLC_CHIP_TEMP, RED_HIGH := CHIP_RED_HIGH, RED_LOW := CHIP_RED_LOW, YELLOW_HIGH := CHIP_YELLOW_HIGH, YELLOW_LOW := CHIP_YELLOW_LOW, pCOLOR := ADR(PLC_CHIP_TEMP_COLOR));
showRedYellowGreen(VALUE := PLC_BOARD_TEMP, RED_HIGH := BOARD_RED_HIGH, RED_LOW := BOARD_RED_LOW, YELLOW_HIGH := BOARD_YELLOW_HIGH, YELLOW_LOW := BOARD_YELLOW_LOW, pCOLOR := ADR(PLC_BOARD_TEMP_COLOR));
showRedYellowGreen(VALUE := Temperatures.rCore0, RED_HIGH := CHIP_RED_HIGH, RED_LOW := CHIP_RED_LOW, YELLOW_HIGH := CHIP_YELLOW_HIGH, YELLOW_LOW := CHIP_YELLOW_LOW, pCOLOR := ADR(HMI_CHIP_TEMP_COLOR));
showRedYellowGreen(VALUE := Temperatures.rBoard, RED_HIGH := BOARD_RED_HIGH, RED_LOW := BOARD_RED_LOW, YELLOW_HIGH := BOARD_YELLOW_HIGH, YELLOW_LOW := BOARD_YELLOW_LOW, pCOLOR := ADR(HMI_BOARD_TEMP_COLOR));

showRedYellowGreen(VALUE := PLC_CHIP_TEMP_MAX_TRANSMIT, RED_HIGH := CHIP_RED_HIGH, RED_LOW := CHIP_RED_LOW, YELLOW_HIGH := CHIP_YELLOW_HIGH, YELLOW_LOW := CHIP_YELLOW_LOW, pCOLOR := ADR(PLC_CHIP_TEMP_MAX_COLOR));
showRedYellowGreen(VALUE := PLC_BOARD_TEMP_MAX_TRANSMIT, RED_HIGH := BOARD_RED_HIGH, RED_LOW := BOARD_RED_LOW, YELLOW_HIGH := BOARD_YELLOW_HIGH, YELLOW_LOW := BOARD_YELLOW_LOW, pCOLOR := ADR(PLC_BOARD_TEMP_MAX_COLOR));
showRedYellowGreen(VALUE := PLC_CHIP_TEMP_MIN_TRANSMIT, RED_HIGH := CHIP_RED_HIGH, RED_LOW := CHIP_RED_LOW, YELLOW_HIGH := CHIP_YELLOW_HIGH, YELLOW_LOW := CHIP_YELLOW_LOW, pCOLOR := ADR(PLC_CHIP_TEMP_MIN_COLOR));
showRedYellowGreen(VALUE := PLC_BOARD_TEMP_MIN_TRANSMIT, RED_HIGH := BOARD_RED_HIGH, RED_LOW := BOARD_RED_LOW, YELLOW_HIGH := BOARD_YELLOW_HIGH, YELLOW_LOW := BOARD_YELLOW_LOW, pCOLOR := ADR(PLC_BOARD_TEMP_MIN_COLOR));

showRedYellowGreen(VALUE := NVM.HMI_CHIP_TEMP_MAX, RED_HIGH := CHIP_RED_HIGH, RED_LOW := CHIP_RED_LOW, YELLOW_HIGH := CHIP_YELLOW_HIGH, YELLOW_LOW := CHIP_YELLOW_LOW, pCOLOR := ADR(HMI_CHIP_TEMP_MAX_COLOR));
showRedYellowGreen(VALUE := NVM.HMI_BOARD_TEMP_MAX, RED_HIGH := BOARD_RED_HIGH, RED_LOW := BOARD_RED_LOW, YELLOW_HIGH := BOARD_YELLOW_HIGH, YELLOW_LOW := BOARD_YELLOW_LOW, pCOLOR := ADR(HMI_BOARD_TEMP_MAX_COLOR));
showRedYellowGreen(VALUE := NVM.HMI_CHIP_TEMP_MIN, RED_HIGH := CHIP_RED_HIGH, RED_LOW := CHIP_RED_LOW, YELLOW_HIGH := CHIP_YELLOW_HIGH, YELLOW_LOW := CHIP_YELLOW_LOW, pCOLOR := ADR(HMI_CHIP_TEMP_MIN_COLOR));
showRedYellowGreen(VALUE := NVM.HMI_BOARD_TEMP_MIN, RED_HIGH := BOARD_RED_HIGH, RED_LOW := BOARD_RED_LOW, YELLOW_HIGH := BOARD_YELLOW_HIGH, YELLOW_LOW := BOARD_YELLOW_LOW, pCOLOR := ADR(HMI_BOARD_TEMP_MIN_COLOR));

showRedYellowGreen(VALUE := GPS_RTK_SIGNAL_DELAY, RED_HIGH := SET_GPS_GENERAL_SETTINGS[GPS_RADIO_SIGNAL_DELAY_CRITICAL], RED_LOW := -2, YELLOW_HIGH := SET_GPS_GENERAL_SETTINGS[GPS_RADIO_SIGNAL_DELAY_WARNING], YELLOW_LOW := -1, pCOLOR := ADR(GPS_RTK_SIGNAL_COLOR));
showRedYellowGreen(VALUE := GPS_PDOP, RED_HIGH := 7, RED_LOW := -3, YELLOW_HIGH := 3, YELLOW_LOW := -2, pCOLOR := ADR(GPS_PDOP_COLOR));

IF HMI_HAS_VALID_DATA THEN
	HMI_HAS_VALID_DATA_COLOR := colorGreen(16#FF);
ELSE
	HMI_HAS_VALID_DATA_COLOR := colorRed(16#FF);
END_IF

IF HMI_COMPLETE_SYNCH THEN
	HMI_COMPLETE_SYNCH_COLOR := colorGreen(16#FF);
ELSE
	HMI_COMPLETE_SYNCH_COLOR := colorRed(16#FF);
END_IF

VBB15_V := TO_REAL(RECEIVE_5.VBB15_MV) / 1000.0;
VBB15_V_MAX := TO_REAL(RECEIVE_5.VBB15_MV_MAX_TRANSMIT) / 1000.0;
VBB15_V_MIN := TO_REAL(RECEIVE_5.VBB15_MV_MIN_TRANSMIT) / 1000.0;

VBB30_V := TO_REAL(RECEIVE_5.VBB30_MV) / 1000.0;
VBB30_V_MAX := TO_REAL(RECEIVE_5.VBB30_MV_MAX_TRANSMIT) / 1000.0;
VBB30_V_MIN := TO_REAL(RECEIVE_5.VBB30_MV_MIN_TRANSMIT) / 1000.0;

// Controls always track if embedment reduction is possible, but we only act on this when it is enabled!
IF EMBED_REDUCTION_DETECTED
	AND EMBED_REDUCTION_ENABLED_VALUE
	AND (RECEIVE_1.MACHINE_MODE_TRANSMIT = eMachineModes.SCREW_MODE)
	AND (RECEIVE_1.SCREW_STATE_TRANSMIT = eScrewStates.SCREW_STATE_DRIVE_ASSIST OR RECEIVE_1.SCREW_STATE_TRANSMIT = eScrewStates.SCREW_STATE_DRIVE_SCREW)
	THEN
	IF SCREW_SIDE_LATCH = eScrewSide.SCREW_LEFT THEN
		LAST_LEFT_EMBED := TRUE;
		LAST_LEFT_EMBED_STR := 'Yes';
	ELSIF SCREW_SIDE_LATCH = eScrewSide.SCREW_RIGHT THEN
		LAST_RIGHT_EMBED := TRUE;
		LAST_RIGHT_EMBED_STR := 'Yes';
	END_IF
// Reset these values when the machine goes into RWP.
ELSIF RECEIVE_1.MACHINE_MODE_TRANSMIT <> eMachineModes.SCREW_MODE THEN
	LAST_LEFT_EMBED := FALSE;
	LAST_LEFT_EMBED_STR := '-----';
	LAST_RIGHT_EMBED := FALSE;
	LAST_RIGHT_EMBED_STR := '-----';
END_IF

IF (RECEIVE_1.MACHINE_MODE_TRANSMIT = eMachineModes.SCREW_MODE) AND (RECEIVE_1.SCREW_STATE_TRANSMIT = eScrewStates.SCREW_STATE_DRIVE_SCREW) THEN
	IF SCREW_SIDE_LATCH = eScrewSide.SCREW_LEFT THEN
		IF RECEIVE_1.DRIVE_LEG_LENGTH > 0 THEN
			LAST_LEFT_LEG := TO_STRING(RECEIVE_1.DRIVE_LEG_LENGTH);
			LEG_LEFT_COLOR := colorGreen(16#FF);
		ELSE
			LAST_LEFT_LEG := 'Cut!';
			LEG_LEFT_COLOR := colorYellow(16#FF);
		END_IF
	ELSIF SCREW_SIDE_LATCH = eScrewSide.SCREW_RIGHT THEN
		IF RECEIVE_1.DRIVE_LEG_LENGTH > 0 THEN
			LAST_RIGHT_LEG := TO_STRING(RECEIVE_1.DRIVE_LEG_LENGTH);
			LEG_RIGHT_COLOR := colorGreen(16#FF);
		ELSE
			LAST_RIGHT_LEG := 'Cut!';
			LEG_RIGHT_COLOR := colorYellow(16#FF);
		END_IF
	END_IF
ELSIF MACHINE_MODE_TRANSMIT <> SCREW_MODE THEN
	(* CLear the displays, don't need them now. *)
	LAST_LEFT_LEG := '-----';
	LAST_RIGHT_LEG := '-----';
	LEG_LEFT_COLOR := colorWhite();
	LEG_RIGHT_COLOR := colorWhite();
END_IF

CASE COMPRESSOR_STATE OF
	COMPRESSOR_OFF:
		AIR_COMPRESSOR_STATE_STRING := 'Off';
	COMPRESSOR_WARMUP:
		AIR_COMPRESSOR_STATE_STRING := 'Warmup';
	COMPRESSOR_RUN_LOADED:
		AIR_COMPRESSOR_STATE_STRING := 'Run Loaded';
	COMPRESSOR_SHUTDOWN:
		AIR_COMPRESSOR_STATE_STRING := 'Shutdown';
	COMPRESSOR_EMERGENCY:
		AIR_COMPRESSOR_STATE_STRING := 'Fail';
END_CASE

AIR_COMPRESSOR_TEMP_COLOR := airCompressorTempColor(AIR_COMPRESSOR_TEMP);
AIR_COMPRESSOR_TEMP_RAW_COLOR := _4to20mAmpColor(AIR_COMPRESSOR_TEMP_RAW);
AIR_COMPRESSOR_TEMP_MAX_COLOR := airCompressorTempColor(AIR_COMPRESSOR_TEMP_MAX_TRANSMIT);

AIR_COMPRESSOR_PRESSURE_COLOR := airCompressorPressureColor(AIR_COMPRESSOR_WET_PRESSURE);
AIR_COMPRESSOR_PRESSURE_RAW_COLOR := _4to20mAmpColor(AIR_COMPRESSOR_WET_PRESSURE_RAW);
AIR_COMPRESSOR_PRESSURE_MAX_COLOR := airCompressorPressureColor(AIR_COMPRESSOR_PRESSURE_MAX_TRANSMIT);

PUMP_PRESSURE_RAW_COLOR := _4to20mAmpColor(PUMP_PRESSURE_RAW);
LOWER_ROTARY_PRESSURE_RAW_COLOR := _4to20mAmpColor(LOWER_ROTARY_PRESSURE_RAW);
LOWER_CROWD_PRESSURE_RAW_COLOR := _4to20mAmpColor(LOWER_CROWD_PRESSURE_RAW);
UPPER_ROTARY_PRESSURE_RAW_COLOR := _4to20mAmpColor(UPPER_ROTARY_PRESSURE_RAW);
UPPER_CROWD_PRESSURE_RAW_COLOR := _4to20mAmpColor(UPPER_CROWD_PRESSURE_RAW);

showRedYellowGreen(VALUE := NVM.HMI_BOARD_TEMP_MIN, RED_HIGH := BOARD_RED_HIGH, RED_LOW := BOARD_RED_LOW, YELLOW_HIGH := BOARD_YELLOW_HIGH, YELLOW_LOW := BOARD_YELLOW_LOW, pCOLOR := ADR(HMI_BOARD_TEMP_MIN_COLOR));

CASE TRUSS_TYPE_LATCH OF
	eTrussType.TRUSS_TYPE_NORMAL:
		TRUSS_TYPE_STRING := 'Array';
	eTrussType.TRUSS_TYPE_CENTER_STRUCTURE:
		TRUSS_TYPE_STRING := 'Center/Motor';
	eTrussType.TRUSS_TYPE_END:
		TRUSS_TYPE_STRING := 'End';
END_CASE

// Set up column headers one time
IF DIAGS_RECEIVE[2, 1] <> 'Diag Code' THEN 
	
	DIAGS_RECEIVE[2, 1] := 'Diag Code';
	DIAGS_RECEIVE[3, 1] := 'Command';
	DIAGS_RECEIVE[4, 1] := 'Actual';
	DIAGS_RECEIVE[5, 1] := 'Wire #';
	
END_IF;

// set up row headers
FOR i := 1 TO DIAGS_TOPICS_LENGTH DO 
	DIAGS_RECEIVE[1, i] := DIAG_COMPONENTS[i];
	DIAGS_RECEIVE[6, i] := DIAG_COMPONENTS[i];
END_FOR

// update diagnostic string array used for display
FOR i := 2 TO DIAGS_TOPICS_LENGTH DO
	DIAGS_RECEIVE[2,i] := ConvDiag(ifmDiag := DIAGS_TRANSMIT[2,i]);
	DIAGS_RECEIVE[3,i] := TO_STRING(DIAGS_TRANSMIT[3,i]);
	DIAGS_RECEIVE[4,i] := TO_STRING(DIAGS_TRANSMIT[4,i]);
	DIAGS_RECEIVE[5,i] := TO_STRING(DIAGS_TRANSMIT[5,i]);
END_FOR;

// track max CAN busload
CAN0_MAX_BUSLOAD := MAX(CAN0_BUSLOAD, CAN0_MAX_BUSLOAD);
CAN1_MAX_BUSLOAD := MAX(CAN1_BUSLOAD, CAN1_MAX_BUSLOAD);
CAN2_MAX_BUSLOAD := MAX(CAN2_BUSLOAD, CAN2_MAX_BUSLOAD);
CAN3_MAX_BUSLOAD := MAX(CAN3_BUSLOAD, CAN3_MAX_BUSLOAD);
