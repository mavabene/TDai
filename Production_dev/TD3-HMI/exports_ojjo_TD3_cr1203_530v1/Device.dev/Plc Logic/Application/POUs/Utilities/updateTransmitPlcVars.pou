
(********************** Declaration ****************************)
FUNCTION_BLOCK updateTransmitPlcVars

VAR_INPUT
END_VAR

VAR_OUTPUT
END_VAR

VAR
	TMP: REAL;
	AUTOMATIC_TRANSMIT_LAST: BOOL;
	
	BTN_PULSE_MIN_TIME		: TIME		:= T#200ms;
	INDEX: UINT;

	SYNCH_TON: TON;	
	CAL_Z_SLIDE_ENCODER_TOF				: TOF;
	CAL_X_SLIDE_ENCODER_TOF				: TOF;
	CAL_MAST_SLIDE_ENCODER_TOF				: TOF;
	CAL_YAW_ENCODER_TOF					: TOF;
	CAL_BOOM_SWING_ENCODER_TOF			: TOF;
	CAL_LOWER_CROWD_ENCODER_TOF			: TOF;
	CAL_UPPER_CROWD_ENCODER_TOF			: TOF;
	CAL_BOOM_LIFT_ENCODER_TOF			: TOF;
	CAL_JOINT_LIFT_ENCODER_TOF			: TOF;
	                     
END_VAR
(********************** Implementation ****************************)
(* When we have received at least one transmission from the PLC, we want to mirror back that we're
	ready to go on this side. *)

IF HMI_RECEIVED_PLC_DATA_1 AND HMI_RECEIVED_PLC_DATA_2 AND HMI_RECEIVED_PLC_DATA_3 
	AND HMI_RECEIVED_PLC_DATA_5 AND HMI_RECEIVED_PLC_DATA_6 AND HMI_RECEIVED_PLC_DATA_7
	AND (PLC_TRANSMIT_1_VERSION = HMI_TRANSMIT_1_VERSION)
	AND (PLC_TRANSMIT_2_VERSION = HMI_TRANSMIT_2_VERSION)
	(* @TODO: after info from PLC is working. AND HMI_RECEIVED_PLC_DATA_4 *)
	AND NOT HMI_HAS_VALID_DATA THEN
	(* This is the first thing in the packet, it let's the HMI know that it now owns the variables that
		are entered from the touch screen. *)
	HMI_HAS_VALID_DATA := TRUE;
	HMI_COMPLETE_SYNCH := FALSE;
END_IF

(* Check to see that the PLC has received notice that the HMI is online, and returned saying all data is
	synchronized. *)
IF HMI_PLC_SYNCH_1_TOP AND HMI_PLC_SYNCH_2_TOP AND HMI_PLC_SYNCH_3_TOP 
	AND HMI_PLC_SYNCH_5_TOP AND HMI_PLC_SYNCH_6_TOP AND HMI_PLC_SYNCH_7_TOP
	AND HMI_PLC_SYNCH_1_BOTTOM AND HMI_PLC_SYNCH_2_BOTTOM AND HMI_PLC_SYNCH_3_BOTTOM 
	AND HMI_PLC_SYNCH_5_BOTTOM AND HMI_PLC_SYNCH_6_BOTTOM AND HMI_PLC_SYNCH_7_BOTTOM
	AND (PLC_TRANSMIT_1_VERSION = HMI_TRANSMIT_1_VERSION)
	AND (PLC_TRANSMIT_2_VERSION = HMI_TRANSMIT_2_VERSION)
	THEN
	
	IF NOT HMI_SYNCH_STARTED THEN
		
		(************* Synch with the PLC is complete, so now we know what kind of machine we are connected to.  Update
			anything that is machine family or version specific. ****************)
	
		(* PLC stores the values across powerdown.  When the system boots up, the PLC transmits them to
			the HMI, and from there the HMI can write values back down to the PLC. *)
			
		(* vvv TRANSMIT_1 vvv *)
		SET_HAMMER_ENABLED_VALUE := HAMMER_ENABLED_VALUE;
		SET_HAMMER_CONTROL_SOURCE_VALUE := HAMMER_CONTROL_SOURCE_VALUE;
		SET_HAMMER_ON_PRESSURE_VALUE := HAMMER_ON_PRESSURE_VALUE;
		SET_HAMMER_OFF_PRESSURE_VALUE := HAMMER_OFF_PRESSURE_VALUE; 
		SET_EMBED_REDUCTION_ENABLED_VALUE := EMBED_REDUCTION_ENABLED_VALUE;
		SET_EMBED_REDUCTION_DISTANCE_VALUE := EMBED_REDUCTION_DISTANCE_VALUE;
		SET_EMBED_REDUCTION_HYSTERESIS_VALUE := EMBED_REDUCTION_HYSTERESIS_VALUE;
		SET_EMBED_REDUCTION_MINIMUM_VALUE := EMBED_REDUCTION_MINIMUM_VALUE;	
		SET_UR_STALL_ENABLED_VALUE := UR_STALL_ENABLED_VALUE;
		SET_UR_STALL_P_MIN_VALUE := UR_STALL_P_MIN_VALUE;
		SET_UR_STALL_P_TIME_VALUE := UR_STALL_P_TIME_VALUE;
		SET_UR_STALL_P_BAND_VALUE := UR_STALL_P_BAND_VALUE;
		SET_UR_STALL_V_MAX_VALUE := UR_STALL_V_MAX_VALUE;
		SET_UR_STALL_V_TIME_VALUE := UR_STALL_V_TIME_VALUE;
		SET_UR_STALL_V_BAND_VALUE := UR_STALL_V_BAND_VALUE;
// 		SET_LC_STALL_ENABLED_VALUE := LC_STALL_ENABLED_VALUE;
		SET_sPersistent_4_AVAIL_03 := sPersistent_4_AVAIL_03_VALUE;
		SET_LC_STALL_LR_ADVANCE_VALUE := LC_STALL_LR_ADVANCE_VALUE;
		SET_LC_STALL_LR_OUTPUT_VALUE := LC_STALL_LR_OUTPUT_VALUE;
		
// 		SET_MAST_SLIDE_COR_POS_VALUE := MAST_SLIDE_COR_POS_VALUE; setting deprecated, value hardcoded.  now is sPersistent_1_AVAIL_01
		SET_LOWER_CROWD_COR_POS_VALUE := LOWER_CROWD_COR_POS_VALUE;
		SET_CHUCK_TO_TARGET_VALUE := CHUCK_TO_TARGET_VALUE;
// 		SET_LASER_OFFSET_VALUE := LASER_OFFSET_VALUE;
		SET_ATOL_TO_WP_VALUE := ATOL_TO_WP_VALUE;
		SET_ATOL_TO_WP_MOTOR_VALUE := ATOL_TO_WP_MOTOR_VALUE;
		SET_SCREW_TIP_TO_GROUND_VALUE := SCREW_TIP_TO_GROUND_VALUE;
// 		SET_SCREW_TIP_TO_START_VALUE := SCREW_TIP_TO_START_VALUE; // sPersistent_1_AVAIL_05
		SET_LR_ENCODER_RES_VALUE := LR_ENCODER_RES_VALUE;
		SET_AIR_COMPRESSOR_POWERED_VALUE := AIR_COMPRESSOR_POWERED_VALUE;
		SET_AIR_ON_DISTANCE_VALUE := AIR_ON_DISTANCE_VALUE;
		SET_AIR_OFF_DISTANCE_VALUE := AIR_OFF_DISTANCE_VALUE;
		SET_UPPER_CROWD_DRILL_STEEL_VALUE := UPPER_CROWD_DRILL_STEEL_VALUE;
		SET_CHUCK_TO_BUSHING_VALUE := CHUCK_TO_BUSHING_VALUE;
		SET_CHUCK_TO_TARGET_CLEARANCE_VALUE := CHUCK_TO_TARGET_CLEARANCE_VALUE;
		SET_DRILL_BIT_LENGTH_VALUE := DRILL_BIT_LENGTH_VALUE;
		SET_DRILL_BIT_THREAD_LENGTH_VALUE := DRILL_BIT_THREAD_LENGTH_VALUE;
		SET_DRILL_BIT_DRIVE_PROTRUSION_VALUE := DRILL_BIT_DRIVE_PROTRUSION_VALUE;
		SET_DRILL_BIT_LOAD_PROTRUSION_VALUE := DRILL_BIT_LOAD_PROTRUSION_VALUE;
		SET_DRILL_BIT_WING_POSITION_VALUE := DRILL_BIT_WING_POSITION_VALUE;
	
		SET_WATER_USED_VALUE := WATER_USED_VALUE;
		SET_WATER_PUMP_LPM_VALUE := WATER_PUMP_LPM_VALUE;
		SET_WATER_DRILL_LPD_VALUE := WATER_DRILL_LPD_VALUE;
		SET_WATER_HOVER_LPT_VALUE := WATER_HOVER_LPT_VALUE;
		SET_WATER_ENTER_LPT_VALUE := WATER_ENTER_LPT_VALUE;
		SET_WATER_HAMMER_RATIO_VALUE := WATER_HAMMER_RATIO_VALUE;
		
		SET_DRIVE_KVFF_VALUE := DRIVE_KVFF_VALUE;
		SET_DRIVE_KP_VALUE := DRIVE_KP_VALUE;
		SET_DRIVE_KI_VALUE := DRIVE_KI_VALUE;
		SET_DRIVE_ILIMIT_VALUE := DRIVE_ILIMIT_VALUE;
		SET_DRIVE_OUTPUT_MAX_VALUE := DRIVE_OUTPUT_MAX_VALUE;
	
		SET_AIR_FLOW_REDUCED_VALUE := AIR_FLOW_REDUCED_VALUE;
		SET_AIR_FLOW_VALUE := AIR_FLOW_VALUE;
		
// 		LATCH_RESET_REQUEST: INT := 0;
// 		TRACK_HIGH_SPEED: BOOL := FALSE;
// 		AUTO_PENDULUM: BOOL := FALSE;
// 		LOGIN_BYPASS: BOOL := FALSE;
		
		SET_OUTRIGGER_ENABLED_VALUE := OUTRIGGER_ENABLED_VALUE;
// 		SET_AUTO_PENDULUM_VALUE := AUTO_PENDULUM_VALUE;
		SET_LOGIN_BYPASS_VALUE := LOGIN_BYPASS_VALUE;
		SET_LOAD_UNLOAD_VALUE := LOAD_UNLOAD_VALUE;
		
		SET_MACHINE_VERSION_VALUE := MACHINE_VERSION_VALUE;
		SET_MACHINE_COMPRESSOR_VALUE := MACHINE_COMPRESSOR_VALUE;
		SET_MACHINE_DRIFTER_VALUE := MACHINE_DRIFTER_VALUE;
		SET_MACHINE_LR_VALUE := MACHINE_LR_VALUE;
		SET_PRODUCT_INSTALL_VALUE := PRODUCT_INSTALL_VALUE;
		SET_MACHINE_SERIAL_VALUE := MACHINE_SERIAL_VALUE;
// 		SET_OPERATOR_BREAK: ;
// 		SET_DISABLE_REMOTE: ;
		
		SET_AUTO_PRELOAD_VALUE := AUTO_PRELOAD_VALUE;
		SET_sPersistent_3_AVAIL_02_VALUE := sPersistent_3_AVAIL_02_VALUE;
		SET_PRELOAD_SPEED_VALUE := PRELOAD_SPEED_VALUE;
		SET_MANUAL_DEPTH_VALUE := MANUAL_DEPTH_VALUE;
// 		SET_MOTOR_HAS_LASER_VALUE := MOTOR_HAS_LASER_VALUE; // with GPS this is always true (motor always located with GPS)
		SET_SOFT_SOIL_ENABLED_VALUE := SOFT_SOIL_ENABLED_VALUE;

		SET_PLUMB_SCREW_EMBEDMENT_VALUE := PLUMB_SCREW_EMBEDMENT_VALUE;
		SET_SCREW_PITCH_VALUE := SCREW_PITCH_VALUE;
		
		// Forces
		
		HMI_TCH_DOWN_SPEED := TCH_DOWN_SPEED_TRANSMIT;
		HMI_TCH_UP_SPEED := TCH_UP_SPEED_TRANSMIT;
		HMI_CENTRALIZER_OPEN_SPEED := CENTRALIZER_OPEN_SPEED_TRANSMIT;
		HMI_CENTRALIZER_CLOSE_SPEED := CENTRALIZER_CLOSE_SPEED_TRANSMIT;
		HMI_CRIMPER_LEFT_OPEN_SPEED := CRIMPER_LEFT_OPEN_SPEED_TRANSMIT;
		HMI_CRIMPER_LEFT_CLOSE_SPEED := CRIMPER_LEFT_CLOSE_SPEED_TRANSMIT;
		HMI_CRIMPER_RIGHT_OPEN_SPEED := CRIMPER_RIGHT_OPEN_SPEED_TRANSMIT;
		HMI_CRIMPER_RIGHT_CLOSE_SPEED := CRIMPER_RIGHT_CLOSE_SPEED_TRANSMIT;
		HMI_UPPER_ROTARY_FWD_SPEED := UPPER_ROTARY_FWD_SPEED_TRANSMIT;
		HMI_UPPER_ROTARY_REV_SPEED := UPPER_ROTARY_REV_SPEED_TRANSMIT;
		HMI_BLADE_UP_SPEED := BLADE_UP_SPEED_TRANSMIT;
		HMI_BLADE_DOWN_SPEED := BLADE_DOWN_SPEED_TRANSMIT;
		HMI_HAMMER_SPEED := HAMMER_SPEED_TRANSMIT;
		(* ^^^ TRANSMIT_1 ^^^ *)	
		
		(* vvv TRANSMIT_2 vvv *)
		SET_SCREW_LENGTHS_CM_VALUES[1] := SCREW_LENGTHS_CM_VALUE[1];
		SET_SCREW_LENGTHS_CM_VALUES[2] := SCREW_LENGTHS_CM_VALUE[2];
		SET_SCREW_LENGTHS_CM_VALUES[3] := SCREW_LENGTHS_CM_VALUE[3];
		SET_STANDARD_EMBEDMENT_CM_VALUES[1] := STANDARD_EMBEDMENT_CM_VALUE[1];
		SET_STANDARD_EMBEDMENT_CM_VALUES[2] := STANDARD_EMBEDMENT_CM_VALUE[2];
		SET_STANDARD_EMBEDMENT_CM_VALUES[3] := STANDARD_EMBEDMENT_CM_VALUE[3];
		SET_HEAVY_EMBEDMENT_CM_VALUES[1] := HEAVY_EMBEDMENT_CM_VALUE[1];
		SET_HEAVY_EMBEDMENT_CM_VALUES[2] := HEAVY_EMBEDMENT_CM_VALUE[2];
		SET_HEAVY_EMBEDMENT_CM_VALUES[3] := HEAVY_EMBEDMENT_CM_VALUE[3];
		
		TMP := LEG_LENGTHS_TRANSMIT[1];
		FOR INDEX := 1 TO TO_UINT(LEG_LENGTHS_COUNT) DO
			HMI_LEG_LENGTHS_CM[INDEX] := LEG_LENGTHS_TRANSMIT[INDEX];
			HMI_LEG_LENGTH_USED[INDEX] := LEG_USED_TRANSMIT[INDEX];
		END_FOR
		
		SET_UC_END_RETRACT_HARD_VALUE := UC_END_RETRACT_HARD_VALUE;
		SET_UC_END_RETRACT_SOFT_VALUE := UC_END_RETRACT_SOFT_VALUE;
		
		SET_ROTATOR_SCREW_POS_VALUE := ROTATOR_SCREW_POS_VALUE;
		SET_SCREW_STOP_THRESHOLD_VALUE := SCREW_STOP_THRESHOLD_VALUE;
		SET_RIGHT_LEFT_DIFF_VALUE := RIGHT_LEFT_DIFF_VALUE;
		SET_MAST_LEAN_VALUE := MAST_LEAN_VALUE;
		
// 		SET_LOWER_CROWD_DRIVE_VEL_VALUE := LOWER_CROWD_DRIVE_VEL_VALUE; // deprecated sPersistent_1_AVAIL_04
		SET_TORQUE_TUBE_PITCH_VALUE := TORQUE_TUBE_PITCH_VALUE;
		SET_TRACKER_ROW_TYPE_VALUE := TRACKER_ROW_TYPE_VALUE;
		
		SET_NXT_TLM_3L_EMBEDMENT_CM_VALUE := NXT_TLM_3L_EMBEDMENT_CM_VALUE;
		SET_NXT_TLM_3L_HEAVY_EMBEDMENT_CM_VALUE := NXT_TLM_3L_HEAVY_EMBEDMENT_CM_VALUE;
		SET_NXT_TLM_T_ATOL_TO_WP_VALUE := NXT_TLM_T_ATOL_TO_WP_VALUE;
		SET_NXT_TLM_3L_ATOL_TO_WP_VALUE := NXT_TLM_3L_ATOL_TO_WP_VALUE;
		SET_NXT_TLM_3L_HEAVY_ATOL_TO_WP_VALUE := NXT_TLM_3L_HEAVY_ATOL_TO_WP_VALUE;
		SET_NXT_TLM_T_ANGLE_VALUE := NXT_TLM_T_ANGLE_VALUE;
		
		SET_LC_DRIVE_VEL_HI_VALUE := LC_DRIVE_VEL_HI_VALUE;
		SET_LC_DRIVE_VEL_LOW_VALUE := LC_DRIVE_VEL_LOW_VALUE;
		SET_UR_DRIVE_PRESSURE_HI_VALUE := UR_DRIVE_PRESSURE_HI_VALUE;
		SET_UR_DRIVE_PRESSURE_LOW_VALUE := UR_DRIVE_PRESSURE_LOW_VALUE;
		SET_SS_DRIVE_VEL_HI_VALUE := SS_DRIVE_VEL_HI_VALUE;
		SET_SS_DRIVE_VEL_LOW_VALUE := SS_DRIVE_VEL_LOW_VALUE;
		SET_LC_DRIVE_PRESSURE_HI_VALUE := LC_DRIVE_PRESSURE_HI_VALUE;
		SET_LC_DRIVE_PRESSURE_LOW_VALUE := LC_DRIVE_PRESSURE_LOW_VALUE;
		SET_SS_LC_PRELOAD_VALUE := SS_LC_PRELOAD_VALUE;
		SET_SS_BIT_PROTRUSION_VALUE := SS_BIT_PROTRUSION_VALUE;
		SET_SS_CLEAR_SPOILS_VALUE := SS_CLEAR_SPOILS_VALUE;
		SET_SS_LC_STALL_TIME_VALUE := SS_LC_STALL_TIME_VALUE;
		SET_SS_LC_STALL_PRESSURE_VALUE := SS_LC_STALL_PRESSURE_VALUE;
		SET_SS_DETECT_BAND_VALUE := SS_DETECT_BAND_VALUE;
		SET_SS_DETECT_TIME_VALUE := SS_DETECT_TIME_VALUE;
		SET_SS_LC_CONTROL_SOURCE_VALUE := SS_LC_CONTROL_SOURCE_VALUE;
		SET_SS_MAX_STALLS_VALUE := SS_MAX_STALLS_VALUE;
		SET_SS_REVEAL_MAX_STALLS_VALUE := SS_REVEAL_MAX_STALLS_VALUE;
		
// 		TRIGGER_BITMASK: DWORD;
// 		POWEROFF_TIME: LINT := 0;
		
		SET_MAX_ROLL_START_VALUE := MAX_ROLL_START_VALUE;
		SET_MAX_PITCH_FWD_START_VALUE := MAX_PITCH_FWD_START_VALUE;
		SET_MAX_PITCH_BACK_START_VALUE := MAX_PITCH_BACK_START_VALUE;
		SET_MAX_ROLL_CONTINUE_VALUE := MAX_ROLL_CONTINUE_VALUE;
		SET_MAX_PITCH_FWD_CONTINUE_VALUE := MAX_PITCH_FWD_CONTINUE_VALUE;
		SET_MAX_PITCH_BACK_CONTINUE_VALUE := MAX_PITCH_BACK_CONTINUE_VALUE;
		SET_MAX_BS_START_VALUE := MAX_BS_START_VALUE;
		
		SET_LOWER_CROWD_ENCODER_TYPE_VALUE := LOWER_CROWD_ENCODER_TYPE_VALUE;
		
		FOR INDEX := 1 TO 5 DO
			SET_UR_PRESSURE_INPUT_VALUE[INDEX] := UR_PRESSURE_INPUT_VALUE[INDEX];
			SET_AIR_FLOW_OUTPUT_VALUE[INDEX] := AIR_FLOW_OUTPUT_VALUE[INDEX];
			AIR_FLOW_TABLE[1, INDEX] := UR_PRESSURE_INPUT_VALUE[INDEX];
			AIR_FLOW_TABLE[2, INDEX] := AIR_FLOW_OUTPUT_VALUE[INDEX];
		END_FOR

		SET_GPS_VENDOR := GPS_VENDOR_VALUE; 
		SET_GPS_AUTOTARGET_SELECTION := GPS_AUTOTARGET_SELECTION_VALUE;
// 		GPS_TEST_ACTUATE_PERCENT: REAL := 10;
// 		GPS_TEST_FB_OFFSET: REAL := 100; // 0-100%.  100% gives full feedback
		
		SET_GPS_AXES_SETTINGS := GPS_AXES_SETTINGS_VALUES;
		SET_GPS_GENERAL_SETTINGS := GPS_GENERAL_SETTINGS_VALUES;
// 		TRACE_PARAMETER_SELECT: USINT := 0;

		SET_HMI_BOOLS := HMI_BOOLS_VALUES;
		SET_HMI_SINTS := HMI_SINTS_VALUES;
		SET_HMI_UINTS := HMI_UINTS_VALUES;
		SET_HMI_INTS := HMI_INTS_VALUES;
		SET_HMI_REALS := HMI_REALS_VALUES;
		SET_HMI_VECTORS := HMI_VECTORS_VALUES;
		SET_HMI_STRINGS := HMI_STRINGS_VALUES;
		
		(* ^^^ TRANSMIT_2 ^^^ *)	
		
		HMI_SYNCH_STARTED := TRUE;
		// Reset timer.
		SYNCH_TON(IN := FALSE, PT := T#2000MS);
	ELSE
		SYNCH_TON(IN := TRUE, PT := T#2000MS, Q => HMI_COMPLETE_SYNCH);
	END_IF
	
END_IF

IF HMI_COMPLETE_SYNCH THEN
	// Table controls requires 2-D array, translate to 2 x 1-D array for PLC.
	FOR INDEX := 1 TO 5 DO
		SET_UR_PRESSURE_INPUT_VALUE[INDEX] := AIR_FLOW_TABLE[1, INDEX];
		SET_AIR_FLOW_OUTPUT_VALUE[INDEX] := AIR_FLOW_TABLE[2, INDEX];
	END_FOR	
END_IF

(* Initialize the set values for the encoder calibration parameters. *)
IF (INIT_ENCODER_CALIBRATION_VARS) THEN
	SET_LOWER_CROWD_MAST_TO_SLIDE_OFFSET_VALUE := LOWER_CROWD_MAST_TO_SLIDE_OFFSET_VALUE;
// 	SET_Z_SLIDE_CALIBRATION_OFFSET_VALUE := Z_SLIDE_CALIBRATION_OFFSET_VALUE;

	(* Reset the flag. *)
	INIT_ENCODER_CALIBRATION_VARS := FALSE;
END_IF;

(* Use the Timer Off function blocks to ensure that the transmitted button signals
	remain ON for a minimum amount of time.  The TRANSMIT network variables update
	every 100ms, so the signal needs to remain ON for at least that long.  The
	Timer Off function block triggers on the rising edge of IN, but starts counting
	at the falling edge of IN. *)
CAL_Z_SLIDE_ENCODER_TOF(
	IN := SET_Z_SLIDE_ENCODER_AT_ZERO_BTN,
	PT := BTN_PULSE_MIN_TIME,
	Q => SET_Z_SLIDE_ENCODER_AT_ZERO_FLAG);

CAL_X_SLIDE_ENCODER_TOF(
	IN := SET_X_SLIDE_ENCODER_AT_ZERO_BTN,
	PT := BTN_PULSE_MIN_TIME,
	Q => SET_X_SLIDE_ENCODER_AT_ZERO_FLAG);

CAL_MAST_SLIDE_ENCODER_TOF(
	IN := SET_MAST_SLIDE_ENCODER_AT_ZERO_BTN,
	PT := BTN_PULSE_MIN_TIME,
	Q => SET_MAST_SLIDE_ENCODER_AT_ZERO_FLAG);

CAL_YAW_ENCODER_TOF(
	IN := SET_YAW_ENCODER_AT_ZERO_BTN,
	PT := BTN_PULSE_MIN_TIME,
	Q => SET_YAW_ENCODER_AT_ZERO_FLAG);

CAL_BOOM_SWING_ENCODER_TOF(
	IN := SET_BOOM_SWING_ENCODER_AT_ZERO_BTN,
	PT := BTN_PULSE_MIN_TIME,
	Q => SET_BOOM_SWING_ENCODER_AT_ZERO_FLAG);

CAL_LOWER_CROWD_ENCODER_TOF(
	IN := SET_LOWER_CROWD_ENCODER_AT_REF_BTN,
	PT := BTN_PULSE_MIN_TIME,
	Q => SET_LOWER_CROWD_ENCODER_AT_REF_FLAG);

CAL_UPPER_CROWD_ENCODER_TOF(
	IN := SET_UPPER_CROWD_ENCODER_AT_ZERO_BTN,
	PT := BTN_PULSE_MIN_TIME,
	Q => SET_UPPER_CROWD_ENCODER_AT_ZERO_FLAG);

CAL_BOOM_LIFT_ENCODER_TOF(
	IN := SET_BOOM_LIFT_ENCODER_AT_ZERO_BTN,
	PT := BTN_PULSE_MIN_TIME,
	Q => SET_BOOM_LIFT_ENCODER_AT_ZERO_FLAG);

CAL_JOINT_LIFT_ENCODER_TOF(
	IN := SET_JOINT_LIFT_ENCODER_AT_ZERO_BTN,
	PT := BTN_PULSE_MIN_TIME,
	Q => SET_JOINT_LIFT_ENCODER_AT_ZERO_FLAG);

(* Reset the button flags, so that when a button press sets the flag to true, these
	statements will reset them to false and thus generate the required falling edge for
	the Timer Off blocks to trigger properly. *)
IF (SET_Z_SLIDE_ENCODER_AT_ZERO_BTN) THEN
	SET_Z_SLIDE_ENCODER_AT_ZERO_BTN := FALSE;
END_IF;

IF (SET_X_SLIDE_ENCODER_AT_ZERO_BTN) THEN
	SET_X_SLIDE_ENCODER_AT_ZERO_BTN := FALSE;
END_IF;

IF (SET_MAST_SLIDE_ENCODER_AT_ZERO_BTN) THEN
	SET_MAST_SLIDE_ENCODER_AT_ZERO_BTN := FALSE;
END_IF;

IF (SET_BOOM_SWING_ENCODER_AT_ZERO_BTN) THEN
	SET_BOOM_SWING_ENCODER_AT_ZERO_BTN := FALSE;
END_IF;

IF (SET_YAW_ENCODER_AT_ZERO_BTN) THEN
	SET_YAW_ENCODER_AT_ZERO_BTN := FALSE;
END_IF;

IF (SET_LOWER_CROWD_ENCODER_AT_REF_BTN) THEN
	SET_LOWER_CROWD_ENCODER_AT_REF_BTN := FALSE;
END_IF;

IF (SET_UPPER_CROWD_ENCODER_AT_ZERO_BTN) THEN
	SET_UPPER_CROWD_ENCODER_AT_ZERO_BTN := FALSE;
END_IF;

IF (SET_BOOM_LIFT_ENCODER_AT_ZERO_BTN ) THEN
	SET_BOOM_LIFT_ENCODER_AT_ZERO_BTN  := FALSE;
END_IF;

IF (SET_JOINT_LIFT_ENCODER_AT_ZERO_BTN) THEN
	SET_JOINT_LIFT_ENCODER_AT_ZERO_BTN := FALSE;
END_IF;

IF AUTOMATIC_TRANSMIT AND NOT AUTOMATIC_TRANSMIT_LAST THEN
	// Clear all forces when entering automatic operation.
	HMI_TRAVEL_ALARM_FORCE := 0;
	HMI_HORN_FORCE := 0;
	HMI_AIR_COMPRESSOR_FORCE := 0;
	HMI_AIR_COMPRESSOR_REQUEST_FORCE := 0;
	HMI_AIR_COMPRESSOR_SUPPLY_FORCE := 0;
	HMI_AIR_COMPRESSOR_FAN_FORCE := 0;
	HMI_HAMMER_FORCE := 0;
	HMI_HYDRAULIC_FAN_FORCE := 0;
	HMI_RED_LIGHT_FORCE := 0;
	HMI_YELLOW_LIGHT_FORCE := 0;
	HMI_GREEN_LIGHT_FORCE := 0;
	HMI_BLUE_LIGHT_FORCE := 0;
	HMI_LIGHT_1_FORCE := 0;
	HMI_LIGHT_2_FORCE := 0;
	HMI_TRACK_HIGH_SPEED_FORCE := 0;
// 	HMI_RES_1_FORCE := 0;
	HMI_ESTOP_FORCE := 0;
	HMI_DRIFTER_AIR_OPEN_FORCE := 0;
	HMI_COOLER_SOLENOID_FORCE := 0;
	HMI_WATER_FORCE := 0;
	
	HMI_UPPER_ROTARY_FORCE := 0;
	HMI_BLADE_FORCE := 0;
	HMI_CENTRALIZER_FORCE := 0;
	HMI_LEFT_CRIMPER_FORCE := 0;
	HMI_RIGHT_CRIMPER_FORCE := 0;
	HMI_TARGET_PLATE_FORCE := 0;
	
	HMI_PROXIMITY_ALARM_FORCE := 0;
	HMI_PROXIMITY_ANTENNA_FORCE := 0;
END_IF

// pnezD Description field unavailable, so don't allow selecting it
IF SET_HMI_BOOLS[SCREW_PARAMS_SOURCE_IS_PNEZD] AND GPS_VENDOR_VALUE = 0 THEN
	SET_HMI_BOOLS[SCREW_PARAMS_SOURCE_IS_PNEZD] := 0;
END_IF

AUTOMATIC_TRANSMIT_LAST := AUTOMATIC_TRANSMIT;

// For debugging process steps that require particular underground conditions, so we don't have to wait for nature to
//	provide what we're looking for!
IF TRIGGER_INIT <> 0 THEN
	// Bits in the debug bitmask are:
	//
	//	0 => UR stall detect
	//	1 => LC stall detect
	//	2 => Hard soil detect
	//
	TRIGGER_BITMASK := SHL(1, TRIGGER_INIT - 1);
	TRIGGER_SET_COUNT := REFLECT_HMI_XMIT_COUNT;
	TRIGGER_INIT := 0;
ELSIF TRIGGER_SET_COUNT <> 0 THEN
	// When we are sure the HMI packet has gotten to the PLC, reset the trigger.
	IF REFLECT_HMI_XMIT_COUNT > TRIGGER_SET_COUNT THEN
		TRIGGER_BITMASK := 0;
		TRIGGER_SET_COUNT := 0;		
	END_IF
END_IF

