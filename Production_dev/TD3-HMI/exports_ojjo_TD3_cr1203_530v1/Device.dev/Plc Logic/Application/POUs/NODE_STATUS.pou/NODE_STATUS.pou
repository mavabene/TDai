
(********************** Declaration ****************************)
FUNCTION_BLOCK NODE_STATUS
VAR
	BASE_INCLINOMETER_STATUS_STRING: STRING;
	BASE_INCLINOMETER_STATUS_COLOR: DINT;
	KNUCKLE_INCLINOMETER_STATUS_STRING: STRING;
	KNUCKLE_INCLINOMETER_STATUS_COLOR: DINT;
	X_SLIDE_CYLINDER_STATUS_STRING: STRING;
	X_SLIDE_CYLINDER_STATUS_COLOR: DINT;
	TRUNION_ENCODER_STATUS_STRING: STRING;
	TRUNION_ENCODER_STATUS_COLOR: DINT;
	Z_SLIDE_CYLINDER_STATUS_STRING: STRING;
	Z_SLIDE_CYLINDER_STATUS_COLOR: DINT;
	MAST_SLIDE_ENCODER_STATUS_STRING: STRING;
	MAST_SLIDE_ENCODER_STATUS_COLOR: DINT;
	MAST_INCLINOMETER_STATUS_STRING: STRING;
	MAST_INCLINOMETER_STATUS_COLOR: DINT;
	LOWER_CROWD_ENCODER_STATUS_STRING: STRING;
	LOWER_CROWD_ENCODER_STATUS_COLOR: DINT;
	UPPER_CROWD_ENCODER_STATUS_STRING: STRING;
	UPPER_CROWD_ENCODER_STATUS_COLOR: DINT;
	BOOM_SWING_ENCODER_STATUS_STRING: STRING;
	BOOM_SWING_ENCODER_STATUS_COLOR: DINT;
	BOOM_LIFT_ENCODER_STATUS_STRING: STRING;
	BOOM_LIFT_ENCODER_STATUS_COLOR: DINT;
	JOINT_LIFT_ENCODER_STATUS_STRING: STRING;
	JOINT_LIFT_ENCODER_STATUS_COLOR: DINT;
	KARTECH_STATUS_STRING: STRING;
END_VAR
(********************** Implementation ****************************)
(* Status for all CanOpen sensors. *)
setColorAndString(BASE_INCLINOMETER_STATUS, ADR(BASE_INCLINOMETER_STATUS_COLOR), ADR(BASE_INCLINOMETER_STATUS_STRING));
setColorAndString(KNUCKLE_INCLINOMETER_STATUS, ADR(KNUCKLE_INCLINOMETER_STATUS_COLOR), ADR(KNUCKLE_INCLINOMETER_STATUS_STRING));
setColorAndString(TRUNION_ENCODER_STATUS, ADR(TRUNION_ENCODER_STATUS_COLOR), ADR(TRUNION_ENCODER_STATUS_STRING));
setColorAndString(Z_SLIDE_CYLINDER_STATUS, ADR(Z_SLIDE_CYLINDER_STATUS_COLOR), ADR(Z_SLIDE_CYLINDER_STATUS_STRING));
setColorAndString(MAST_SLIDE_ENCODER_STATUS, ADR(MAST_SLIDE_ENCODER_STATUS_COLOR), ADR(MAST_SLIDE_ENCODER_STATUS_STRING));
setColorAndString(MAST_INCLINOMETER_STATUS, ADR(MAST_INCLINOMETER_STATUS_COLOR), ADR(MAST_INCLINOMETER_STATUS_STRING));
setColorAndString(LOWER_CROWD_ENCODER_STATUS, ADR(LOWER_CROWD_ENCODER_STATUS_COLOR), ADR(LOWER_CROWD_ENCODER_STATUS_STRING));
setColorAndString(UPPER_CROWD_ENCODER_STATUS, ADR(UPPER_CROWD_ENCODER_STATUS_COLOR), ADR(UPPER_CROWD_ENCODER_STATUS_STRING));
setColorAndString(X_SLIDE_CYLINDER_STATUS, ADR(X_SLIDE_CYLINDER_STATUS_COLOR), ADR(X_SLIDE_CYLINDER_STATUS_STRING));
setColorAndString(BOOM_SWING_ENCODER_STATUS, ADR(BOOM_SWING_ENCODER_STATUS_COLOR), ADR(BOOM_SWING_ENCODER_STATUS_STRING));
setColorAndString(BOOM_LIFT_ENCODER_STATUS, ADR(BOOM_LIFT_ENCODER_STATUS_COLOR), ADR(BOOM_LIFT_ENCODER_STATUS_STRING));
setColorAndString(JOINT_LIFT_ENCODER_STATUS, ADR(JOINT_LIFT_ENCODER_STATUS_COLOR), ADR(JOINT_LIFT_ENCODER_STATUS_STRING));

IF RECEIVE_1.rf_CANlink THEN
	KARTECH_STATUS_STRING := 'Operational';
ELSE
	KARTECH_STATUS_STRING := 'Comm. Error';
END_IF