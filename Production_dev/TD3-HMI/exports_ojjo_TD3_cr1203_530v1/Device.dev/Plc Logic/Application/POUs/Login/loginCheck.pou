
(********************** Declaration ****************************)
FUNCTION_BLOCK loginCheck
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR
	NEEDS_INIT: BOOL := TRUE;
END_VAR

(********************** Implementation ****************************)
IF NEEDS_INIT THEN
	NEEDS_INIT := FALSE;
	OPERATOR_LEVEL_STRING := 'OPERATOR';
	ENTRY_RESULT := 'Using default on powerup';
END_IF

IF PASSWORD_ENTERED <> '' THEN
	(* Someone has entered a password.  Check it. *)
	
	IF LOGIN_LEVEL_ATTEMPT = 1 THEN
		IF PASSWORD_ENTERED = NVM.TECHNICIAN_PASSWORD OR PASSWORD_ENTERED = NVM.OJJO_TECHNICIAN_PASSWORD THEN
			ENTRY_RESULT := 'Successfully logged in as TECHNICIAN';
			ENTRY_FAILED := FALSE;
			OPERATOR_LEVEL := eOperatorLevel.TECHNICIAN;
			OPERATOR_LEVEL_STRING := 'TECHNICIAN';
		ELSE
			ENTRY_RESULT := 'FAILED to log in as TECHNICIAN';
			ENTRY_FAILED := TRUE;
			OPERATOR_LEVEL := eOperatorLevel.OPERATOR;
			OPERATOR_LEVEL_STRING := 'OPERATOR';
		END_IF
	ELSIF LOGIN_LEVEL_ATTEMPT = 2 THEN
		IF PASSWORD_ENTERED = NVM.ENGINEER_PASSWORD 
			OR PASSWORD_ENTERED = NVM.OWNER_ENGINEER_PASSWORD
			OR PASSWORD_ENTERED = NVM.OJJO_ENGINEER_PASSWORD THEN
			ENTRY_RESULT := 'Successfully logged in as ENGINEER';
			ENTRY_FAILED := FALSE;
			OPERATOR_LEVEL_STRING := 'ENGINEER';
			ROW_PITCH_FORWARD_LIMIT := -37;
			IF PASSWORD_ENTERED = NVM.ENGINEER_PASSWORD THEN
				OPERATOR_LEVEL := eOperatorLevel.CUSTOMER_ENGINEER;
			ELSIF PASSWORD_ENTERED = NVM.OWNER_ENGINEER_PASSWORD THEN
				OPERATOR_LEVEL := eOperatorLevel.OWNER_ENGINEER;
			ELSE
				OPERATOR_LEVEL := eOperatorLevel.OJJO_ENGINEER;
			END_IF
		ELSE
			ENTRY_RESULT := 'FAILED to log in as ENGINEER';
			ENTRY_FAILED := TRUE;
			OPERATOR_LEVEL := eOperatorLevel.OPERATOR;
			OPERATOR_LEVEL_STRING := 'OPERATOR';
		END_IF
	ELSIF LOGIN_LEVEL_ATTEMPT = 3 THEN
		IF PASSWORD_ENTERED = NVM.ADMIN_PASSWORD OR PASSWORD_ENTERED = NVM.OJJO_ADMIN_PASSWORD THEN
			ENTRY_RESULT := 'Successfully logged in as ADMIN';
			ENTRY_FAILED := FALSE;
			OPERATOR_LEVEL_STRING := 'ADMIN';
			IF PASSWORD_ENTERED = NVM.OJJO_ADMIN_PASSWORD THEN
				OPERATOR_LEVEL := eOperatorLevel.OJJO_ADMIN;
			ELSE
				OPERATOR_LEVEL := eOperatorLevel.OWNER_ADMIN;
			END_IF
		ELSE
			ENTRY_RESULT := 'FAILED to log in as ADMIN';
			ENTRY_FAILED := TRUE;
			OPERATOR_LEVEL := eOperatorLevel.OPERATOR;
			OPERATOR_LEVEL_STRING := 'ADMIN';
		END_IF
	END_IF
	PASSWORD_ENTERED := '';
	LOGIN_LEVEL_ATTEMPT := -1;
END_IF