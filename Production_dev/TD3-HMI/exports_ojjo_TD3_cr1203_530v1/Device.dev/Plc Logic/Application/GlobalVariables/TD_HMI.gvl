
(********************** Declaration ****************************)
VAR_GLOBAL CONSTANT
	LEG_LENGTHS_COUNT: INT := 10;
	(* 	to add more persistent var's: 
		change GPS_DATA_LENGTH here and in PLC code - Dimensions, and (opt) add defaults in arrays*)
	NUM_GPS_AXES: USINT := 4; 
END_VAR	

VAR_GLOBAL
	HARDWARE_VERSION: STRING[20];
	MACHINE_SERIAL_STRING: STRING[20];
	
	PLC_WATCHDOG_MAX: DWORD;
	
	TRIGGER_INIT: INT := 0;
	TRIGGER_SET_COUNT: DWORD := 0;
	
	ENABLE_UPLINK_DATA: BOOL := FALSE;
	
	INIT_JOB_SPECIFIC_VARS					: BOOL;
	INIT_ROW_SPECIFIC_VARS					: BOOL;
	INIT_ENCODER_CALIBRATION_VARS			: BOOL;
	COLOR_CHANGE							: BOOL	:= TRUE;

	(* Button flags that are used on the HMI. *)
	SET_YAW_ENCODER_AT_ZERO_BTN				: BOOL;
	SET_BOOM_SWING_ENCODER_AT_ZERO_BTN		: BOOL;
	SET_LOWER_CROWD_ENCODER_AT_REF_BTN		: BOOL;
	SET_UPPER_CROWD_ENCODER_AT_ZERO_BTN		: BOOL;
	SET_X_SLIDE_ENCODER_AT_ZERO_BTN			: BOOL;
	SET_Z_SLIDE_ENCODER_AT_ZERO_BTN			: BOOL;
	SET_MAST_SLIDE_ENCODER_AT_ZERO_BTN		: BOOL;
	SET_BOOM_LIFT_ENCODER_AT_ZERO_BTN		: BOOL;
	SET_JOINT_LIFT_ENCODER_AT_ZERO_BTN		: BOOL;
	SET_KNUCKLE_TO_MAST_PITCH_DELTA  		: BOOL;

	ROW_PITCH_FORWARD_LIMIT: REAL := -16;
	
	DATE_TIME: ifmDevice.stDATE_TIME;
	LAST_SECONDS: UINT := 0;
	READABLE_TIME: STRING;
	
	(* Ratioed off the DataAck task frequency. *)
	DATA_ACQ_FREQ_DIVISOR: INT := 100;
	//DATA_ACQ_FREQ_SELECT: INT := 0;

	AI1_ERROR_HIDE: BOOL;
	AI2_ERROR_HIDE: BOOL;
	AI3_ERROR_HIDE: BOOL;
	AI4_ERROR_HIDE: BOOL;
	AI5_ERROR_HIDE: BOOL;
	AI6_ERROR_HIDE: BOOL;
	AI7_ERROR_HIDE: BOOL;
	AI8_ERROR_HIDE: BOOL;

	ROTARY_SPEED_DISPLAY: REAL;
	
	LEG_LENGTH_MIN: REAL := 10;
	LEG_LENGTH_MAX: REAL := 999;
	
	CMD1_RESULT: WORD := 0;
	CMD2_RESULT: WORD := 0;
	CMD3_RESULT: WORD := 0;
	CMD_GPS_RESULT: WORD := 0;
	CMD_USB_WRITE_TEST_RESULT: WORD := 0;
	CMD_TA_ACC_DATA_RESULT: WORD := 0;
	CMD_CONFIG_DATA_RESULT: WORD := 0;
	CMD1_LAST_FAIL: WORD := 0;
	CMD2_LAST_FAIL: WORD := 0;
	CMD3_LAST_FAIL: WORD := 0;
	CMD_GPS_LAST_FAIL: WORD := 0;
	CMD_USB_WRITE_LAST_FAIL: WORD := 0;
	CMD_TA_ACC_DATA_LAST_FAIL: WORD := 0;
	CMD_CONFIG_DATA_LAST_FAIL: WORD := 0;
	
	BOOT_RECOVERY: BOOL := FALSE;

END_VAR

