	SIMULATED_HAMMER						: BOOL := FALSE;
	DEBUG_TEST_INT							: INT := 12;
	
	RUN_3LM_CALCS							: BOOL := FALSE;
	
	
	ET2_TEST								: UINT := 0; 
		(* 0 = off, 
		1 = ET2 std truss offset, 
		2 = ET2 motor truss crimp offset,
		3 = ET2 motor truss third leg offset
		4 = ET2 side leg adjust
		5 = ET2 third leg mast pitching adjust
		6 = pedestal adjust
		*)
	ET2_TEST_Z_OFFSET_VALUE: INT := 0;
		
	GPS_TEST_VEL_FACTOR: REAL := 1.0;
	GPS_TEST_ACCEL_FACTOR: REAL := 1.0;
	
