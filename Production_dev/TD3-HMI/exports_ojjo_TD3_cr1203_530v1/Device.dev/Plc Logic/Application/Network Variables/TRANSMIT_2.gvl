	SET_PLC_BOARD_TEMP_MIN: INT := 0;
	SET_PLC_CHIP_TEMP_MIN: INT := 0;
	SET_VBB15_MV_MAX: UINT := 0;
	SET_VBB30_MV_MAX: UINT := 0;
	SET_VBB15_MV_MIN: UINT := 0;
